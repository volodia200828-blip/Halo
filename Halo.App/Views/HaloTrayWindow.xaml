<Window x:Class="Halo.App.Views.HaloTrayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Halo"
        Width="350"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="12">
        <!-- Тінь вікна -->
        <Border Background="{DynamicResource OrbitWindowBgBrush}" CornerRadius="18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.65" />
            </Border.Effect>
        </Border>

        <!-- Тіло вікна Halo -->
        <Border Background="{DynamicResource OrbitWindowBgBrush}"
                BorderBrush="{DynamicResource OrbitHeroBorderBrush}"
                BorderThickness="1.2"
                CornerRadius="18"
                Padding="18,16">
            <StackPanel>
                <!-- 1. Заголовок вікна -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Іконка / Логотип -->
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12"
                            Background="{DynamicResource OrbitLogoBoxBgBrush}"
                            BorderThickness="0"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <Grid>
                            <Image Source="pack://application:,,,/Resources/avatar.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Назва програми та підзаголовок -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Halo" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" />
                        <TextBlock x:Name="TxtTrayTagline" Text="Швидкий асистент роботи з файлами" FontSize="11.5" Foreground="{DynamicResource OrbitTextSecondary}" Margin="0,1,0,0" />
                    </StackPanel>

                    <!-- Кнопка закриття -->
                    <Button Grid.Column="2" Style="{StaticResource OrbitWindowCapBtn}" Width="28" Height="28" VerticalAlignment="Center" Click="BtnClose_Click">
                        <Path Data="{StaticResource OrbitIconClose}" Stroke="{DynamicResource OrbitTextMuted}" StrokeThickness="1.6" Width="9" Height="9" Stretch="Uniform" />
                    </Button>
                </Grid>

                <!-- 2. Статус-бар активності Halo -->
                <Border x:Name="TrayStatusBar" Background="{DynamicResource OrbitRecessedBgBrush}" BorderBrush="{DynamicResource OrbitSubtleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,7" Margin="0,0,0,12">
                    <DockPanel>
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource OrbitGreenLightBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="TxtStatusLabel" Text="Служба активна" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource OrbitTextPrimary}" VerticalAlignment="Center" />
                        <Border x:Name="TrayHotkeyBadgeBorder" DockPanel.Dock="Right" HorizontalAlignment="Right" Background="{DynamicResource OrbitPurpleSoftBg}" BorderThickness="0" CornerRadius="6" Padding="8,2">
                            <TextBlock x:Name="TxtHotkeyBadge" Text="Alt + Space" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource OrbitPurpleLightBrush}" />
                        </Border>
                    </DockPanel>
                </Border>

                <!-- 3. Картка Ігрового режиму з поясненням -->
                <Border Background="{DynamicResource OrbitRecessedBgBrush}" BorderBrush="{DynamicResource OrbitSubtleBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="GameModeIconBox" Width="30" Height="30" CornerRadius="8" Background="{DynamicResource OrbitToggleTrackOffBrush}" BorderThickness="0" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Path x:Name="TxtGameModeEmoji" Data="{StaticResource OrbitIconGamepad}" Stroke="{DynamicResource OrbitRoseLightBrush}" StrokeThickness="1.6" Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55" />
                                </Border>
                                <TextBlock x:Name="TxtGameModeTitle" Text="Ігровий режим" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource OrbitTextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                            <CheckBox x:Name="CheckGameMode" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource OrbitToggleSwitch}" VerticalAlignment="Center" Click="CheckGameMode_Click" />
                        </DockPanel>
                        <TextBlock x:Name="TxtGameModeExplanation"
                                   Text="Призупиняє всі тригери миші та гарячі клавіші, щоб програма не заважала під час ігор або роботи у 3D-редакторах."
                                   FontSize="11" Foreground="{DynamicResource OrbitTextMuted}" TextWrapping="Wrap" LineHeight="16" />
                    </StackPanel>
                </Border>

                <!-- 4. Кнопки швидкого переходу -->
                <StackPanel Margin="0,0,0,12">
                    <!-- Головне вікно -->
                    <Border Style="{StaticResource OrbitInteractiveCardStyle}" Padding="12,10" Margin="0,0,0,6" Cursor="Hand" MouseLeftButtonDown="BtnDashboard_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10" Background="{DynamicResource OrbitPurpleSoftBg}" BorderThickness="0" VerticalAlignment="Center">
                                <Path Data="{StaticResource OrbitIconDashboard}" Stroke="{DynamicResource OrbitPurpleLightBrush}" StrokeThickness="1.7" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock x:Name="TxtNavDashboardTitle" Text="Головне вікно Halo" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource OrbitTextPrimary}" />
                                <TextBlock x:Name="TxtNavDashboardSub" Text="Інтерактивний хаб, конвертер та швидкі дії" FontSize="10.5" Foreground="{DynamicResource OrbitTextMuted}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="→" FontSize="13" Foreground="{DynamicResource OrbitTextMuted}" VerticalAlignment="Center" Margin="6,0,4,0" />
                        </Grid>
                    </Border>

                    <!-- Полиця файлів -->
                    <Border Style="{StaticResource OrbitInteractiveCardStyle}" Padding="12,10" Margin="0,0,0,6" Cursor="Hand" MouseLeftButtonDown="BtnShelf_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10" Background="{DynamicResource OrbitBlueSoftBg}" BorderThickness="0" VerticalAlignment="Center">
                                <Path Data="{StaticResource OrbitIconShelf}" Stroke="{DynamicResource OrbitCyanBrush}" StrokeThickness="1.7" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock x:Name="TxtNavShelfTitle" Text="Полиця файлів (File Shelf)" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource OrbitTextPrimary}" />
                                <TextBlock x:Name="TxtNavShelfSub" Text="Тимчасовий буфер закріплених документів і фото" FontSize="10.5" Foreground="{DynamicResource OrbitTextMuted}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="→" FontSize="13" Foreground="{DynamicResource OrbitTextMuted}" VerticalAlignment="Center" Margin="6,0,4,0" />
                        </Grid>
                    </Border>

                    <!-- Налаштування та Інструкція -->
                    <Border Style="{StaticResource OrbitInteractiveCardStyle}" Padding="12,10" Cursor="Hand" MouseLeftButtonDown="BtnSettings_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10" Background="{DynamicResource OrbitAmberSoftBg}" BorderThickness="0" VerticalAlignment="Center">
                                <Path Data="{StaticResource OrbitIconSettings}" Stroke="{DynamicResource OrbitAmberLightBrush}" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock x:Name="TxtNavSettingsTitle" Text="Налаштування та Інструкція" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource OrbitTextPrimary}" />
                                <TextBlock x:Name="TxtNavSettingsSub" Text="Параметри жестів, автосортування та гід" FontSize="10.5" Foreground="{DynamicResource OrbitTextMuted}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="→" FontSize="13" Foreground="{DynamicResource OrbitTextMuted}" VerticalAlignment="Center" Margin="6,0,4,0" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 5. Розділювач та Кнопка виходу -->
                <Border Height="1" Background="{DynamicResource OrbitSubtleBorderBrush}" Margin="0,0,0,12" />

                <Button x:Name="BtnExitHalo" Content="✕  Вийти з Halo" Style="{StaticResource OrbitSecondaryButton}" Height="34" FontSize="11.5" HorizontalAlignment="Stretch" Click="BtnExit_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>