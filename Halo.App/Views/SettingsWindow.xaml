<Window x:Class="Halo.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Halo — Налаштування"
        Height="680" Width="960"
        MinHeight="580" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI Variable, Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- Modern ScrollBar and Button styles -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155" />
                    <Setter Property="BorderBrush" Value="#06B6D4" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Toggle Switch Style -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="44" Height="24">
                                <Border x:Name="Track"
                                        CornerRadius="12"
                                        Background="#334155"
                                        BorderBrush="#475569"
                                        BorderThickness="1" />
                                <Ellipse x:Name="Thumb"
                                         Width="18" Height="18"
                                         Fill="#94A3B8"
                                         HorizontalAlignment="Left"
                                         Margin="3,0,0,0" />
                            </Grid>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#0284C7" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="#38BDF8" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Navigation Tab Button Style -->
        <Style x:Key="NavTabButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E293B" />
                                <Setter Property="Foreground" Value="#F8FAFC" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#1E293B" />
                                <Setter Property="Foreground" Value="#38BDF8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Sidebar -->
        <Border Grid.Column="0" Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="0,0,1,0" Padding="16">
            <DockPanel>
                <!-- Brand Header -->
                <StackPanel DockPanel.Dock="Top" Margin="4,8,4,24">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⭕" FontSize="26" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Halo" FontSize="24" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Кругове меню та автоматизація" FontSize="11" Foreground="#64748B" Margin="2,4,0,0" />
                </StackPanel>

                <!-- Footer version -->
                <TextBlock DockPanel.Dock="Bottom" Text="Halo v1.0 • Made with .NET" FontSize="11" Foreground="#475569" TextAlignment="Center" Margin="0,16,0,4" />

                <!-- Navigation Radio Buttons -->
                <StackPanel>
                    <RadioButton x:Name="TabActions" Content="🎛️  Дії та сектори" Style="{StaticResource NavTabButtonStyle}" IsChecked="True" Checked="Tab_Checked" />
                    <RadioButton x:Name="TabMacros" Content="⚡  Власні макроси" Style="{StaticResource NavTabButtonStyle}" Checked="Tab_Checked" />
                    <RadioButton x:Name="TabAppearance" Content="🎨  Вигляд та теми" Style="{StaticResource NavTabButtonStyle}" Checked="Tab_Checked" />
                    <RadioButton x:Name="TabHotkeys" Content="⌨️  Гарячі клавіші" Style="{StaticResource NavTabButtonStyle}" Checked="Tab_Checked" />
                    <RadioButton x:Name="TabFolders" Content="📂  Гарячі папки" Style="{StaticResource NavTabButtonStyle}" Checked="Tab_Checked" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Right Content Area -->
        <Grid Grid.Column="1" Margin="28,24">
            
            <!-- PANEL 1: ACTIONS & SECTORS -->
            <Grid x:Name="PanelActions" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="Керування функціями меню" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC" />
                    <TextBlock Text="Вмикайте або вимикайте функції, змінюйте їх порядок та обирайте, що з'являється у радіальному колі."
                               FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Filter Row -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock Text="Фільтр: " Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="FilterCategoryCombo" Width="160" Background="#1E293B" Foreground="Black"
                              SelectionChanged="FilterCategoryCombo_SelectionChanged" SelectedIndex="0">
                        <ComboBoxItem Content="Всі функції" />
                        <ComboBoxItem Content="Зображення" />
                        <ComboBoxItem Content="Документи" />
                        <ComboBoxItem Content="Системні" />
                        <ComboBoxItem Content="Власні макроси" />
                    </ComboBox>

                    <Button Content="➕ Створити нову функцію" Margin="14,0,0,0" Click="BtnAddCustomAction_Click"
                            Background="#0369A1" BorderBrush="#0284C7" />
                </StackPanel>

                <!-- Actions List -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ActionsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E293B" CornerRadius="10" Padding="14,12" Margin="0,0,0,10"
                                        BorderBrush="#334155" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Icon & Accent Badge -->
                                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10"
                                                Background="#0F172A" Margin="0,0,14,0"
                                                BorderBrush="{Binding AccentColor}" BorderThickness="1.5">
                                            <TextBlock Text="{Binding IconKey}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Title & Description -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" />
                                                <Border Background="#334155" CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                                                        Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="Макрос" FontSize="10" Foreground="#38BDF8" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="440" />
                                        </StackPanel>

                                        <!-- Reorder Buttons -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <Button Content="▲" Width="30" Height="30" Padding="0" Margin="2" Tag="{Binding}" Click="BtnMoveUp_Click" ToolTip="Підняти вгору" />
                                            <Button Content="▼" Width="30" Height="30" Padding="0" Margin="2" Tag="{Binding}" Click="BtnMoveDown_Click" ToolTip="Опустити вниз" />
                                            <Button Content="🗑️" Width="30" Height="30" Padding="0" Margin="4,2,2,2" Tag="{Binding}" Click="BtnDeleteAction_Click" ToolTip="Видалити" />
                                        </StackPanel>

                                        <!-- Toggle Enable/Disable Switch -->
                                        <CheckBox Grid.Column="3"
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                  Click="ActionToggle_Click"
                                                  Tag="{Binding}"
                                                  VerticalAlignment="Center"
                                                  ToolTip="Увімкнути/Вимкнути функцію в меню" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- PANEL 2: CUSTOM MACROS -->
            <Grid x:Name="PanelMacros" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock Text="Створення власного макросу" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC" />
                        <TextBlock Text="Додавайте автоматизовані ланцюжки або запуск консольних утиліт з аргументом вибраного файлу."
                                   FontSize="13" Foreground="#94A3B8" Margin="0,4,0,20" />

                        <Border Background="#1E293B" CornerRadius="12" Padding="20" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Назва функції:" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,6" />
                                <TextBox x:Name="MacroTitleBox" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="10,8" FontSize="14" />

                                <TextBlock Text="Опис (підказка):" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,14,0,6" />
                                <TextBox x:Name="MacroDescBox" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="10,8" FontSize="14" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Іконка (емодзі/знак):" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,6" />
                                        <TextBox x:Name="MacroIconBox" Text="⚡" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="10,8" FontSize="14" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Цільові файли:" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,6" />
                                        <ComboBox x:Name="MacroTargetTypeCombo" Background="#0F172A" Foreground="Black" SelectedIndex="0" Padding="8">
                                            <ComboBoxItem Content="Будь-які файли" />
                                            <ComboBoxItem Content="Зображення" />
                                            <ComboBoxItem Content="Документи" />
                                            <ComboBoxItem Content="Відео" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Команда / Скрипт (використовуйте %FILE% для шляху до файлу):" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,16,0,6" />
                                <TextBox x:Name="MacroCommandBox" Background="#0F172A" Foreground="#38BDF8" FontFamily="Consolas" BorderBrush="#334155" Padding="10,8" FontSize="13"
                                         Text="explorer.exe /select,%FILE%" />
                                <TextBlock Text="Підказка: %FILE% підставляє повний шлях до файлу, %DIR% — шлях до поточної папки." FontSize="11" Foreground="#64748B" Margin="0,4,0,0" />

                                <Button Content="💾 Зберегти та додати в меню" Margin="0,22,0,0" HorizontalAlignment="Right"
                                        Background="#0284C7" BorderBrush="#38BDF8" FontWeight="SemiBold" Padding="20,10"
                                        Click="BtnSaveMacro_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- PANEL 3: APPEARANCE -->
            <Grid x:Name="PanelAppearance" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock Text="Вигляд та UX меню" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC" />
                        <TextBlock Text="Персоналізуйте графічні параметри, розміри кола та поведінку радіального меню."
                                   FontSize="13" Foreground="#94A3B8" Margin="0,4,0,20" />

                        <Border Background="#1E293B" CornerRadius="12" Padding="20" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel>
                                <!-- Theme Selection -->
                                <TextBlock Text="Тема оформлення:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <ComboBox x:Name="ThemeCombo" Width="200" HorizontalAlignment="Left" Background="#0F172A" Foreground="Black"
                                          SelectionChanged="ThemeCombo_SelectionChanged" SelectedIndex="0">
                                    <ComboBoxItem Content="Темна тема" />
                                    <ComboBoxItem Content="Світла тема" />
                                </ComboBox>

                                <Separator Background="#334155" Margin="0,18" />

                                <!-- Radius Slider -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Зовнішній радіус меню (px):" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="Діаметр радіального меню на екрані" FontSize="11" Foreground="#94A3B8" />
                                    </StackPanel>
                                    <TextBlock x:Name="RadiusValueText" Grid.Column="1" Text="175 px" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                                </Grid>
                                <Slider x:Name="RadiusSlider" Minimum="130" Maximum="230" Value="175" TickFrequency="5" IsSnapToTickEnabled="True"
                                        ValueChanged="RadiusSlider_ValueChanged" />

                                <Separator Background="#334155" Margin="0,18" />

                                <!-- Labels toggle -->
                                <CheckBox x:Name="ShowLabelsCheck" Content="Відображати текстові підписи на секторах"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="True" Click="ShowLabelsCheck_Click" Margin="0,4" />

                                <!-- Auto-hide toggle -->
                                <CheckBox x:Name="AutoHideCheck" Content="Автоматично ховати меню після натискання на дію"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="True" Click="AutoHideCheck_Click" Margin="0,12" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- PANEL 4: HOTKEYS -->
            <Grid x:Name="PanelHotkeys" Visibility="Collapsed">
                <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                    <TextBlock Text="Гарячі клавіші та виклик" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC" />
                    <TextBlock Text="Налаштуйте комбінацію для миттєвого виклику меню над виділеними файлами у системі."
                               FontSize="13" Foreground="#94A3B8" Margin="0,4,0,20" />

                    <Border Background="#1E293B" CornerRadius="12" Padding="20" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Глобальна комбінація клавіш:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="HotkeyTextBox" Text="Alt+Space" Background="#0F172A" Foreground="#38BDF8"
                                         Padding="10,8" FontSize="15" FontWeight="SemiBold" BorderBrush="#334155" />
                                <Button Grid.Column="1" Content="Застосувати" Margin="10,0,0,0" Click="BtnApplyHotkey_Click"
                                        Background="#0284C7" BorderBrush="#38BDF8" />
                            </Grid>

                            <TextBlock Text="Приклади: Alt+Space, Ctrl+Shift+H, Win+Space" FontSize="11" Foreground="#64748B" Margin="0,8,0,0" />

                            <Separator Background="#334155" Margin="0,18" />

                            <TextBlock Text="Як працює виклик:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="1. Виділіть один або кілька файлів у Провіднику Windows.&#x0a;2. Натисніть налаштовану комбінацію клавіш.&#x0a;3. Коло з'явиться поруч із курсором із відповідними діями!"
                                       FontSize="12" Foreground="#94A3B8" LineHeight="20" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- PANEL 5: WATCHED FOLDERS -->
            <Grid x:Name="PanelFolders" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="Гарячі папки (Автоматизація)" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC" />
                    <TextBlock Text="Halo відстежує появу нових файлів у заданих папках та автоматично виконує призначені дії."
                               FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Add rule row -->
                <Border Grid.Row="1" Background="#1E293B" CornerRadius="10" Padding="14" Margin="0,0,0,16" BorderBrush="#334155" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NewFolderInput" Text="C:\Users\...\Downloads" Background="#0F172A" Foreground="White"
                                 Padding="10,8" Margin="0,0,10,0" BorderBrush="#334155" />
                        <ComboBox x:Name="NewFolderActionCombo" Grid.Column="1" Background="#0F172A" Foreground="Black" Margin="0,0,10,0" SelectedIndex="0">
                            <ComboBoxItem Content="Конвертувати у WebP" Tag="image_to_webp" />
                            <ComboBoxItem Content="Конвертувати у PNG" Tag="image_to_png" />
                            <ComboBoxItem Content="Стиснути зображення" Tag="image_compress" />
                            <ComboBoxItem Content="Чорно-білий фільтр" Tag="image_grayscale" />
                        </ComboBox>
                        <Button Grid.Column="2" Content="Додати правило" Click="BtnAddWatchedFolder_Click" Background="#0284C7" BorderBrush="#38BDF8" />
                    </Grid>
                </Border>

                <!-- Folders List -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="WatchedFoldersControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E293B" CornerRadius="10" Padding="14,12" Margin="0,0,0,10"
                                        BorderBrush="#334155" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding FolderPath}" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC" />
                                            <TextBlock Text="{Binding AssignedActionId, StringFormat='Дія: {0}'}" FontSize="12" Foreground="#38BDF8" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Видалити" Margin="0,0,12,0" Tag="{Binding}" Click="BtnDeleteFolderRule_Click" Background="#475569" />
                                        <CheckBox Grid.Column="2" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Click="FolderRuleToggle_Click" Tag="{Binding}" Style="{StaticResource ToggleSwitchStyle}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
