<Window x:Class="Halo.App.Views.ShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Halo — Поличка файлів"
        Height="420" Width="320"
        WindowStyle="ToolWindow"
        Topmost="True"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI Variable, Segoe UI"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBlock Text="📌" FontSize="18" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="Поличка файлів" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
            </StackPanel>
            <Button Content="Очистити" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="BtnClearAll_Click"
                    Background="#1E293B" Foreground="#94A3B8" Padding="10,4" FontSize="11" />
        </DockPanel>

        <!-- Shelf items list -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="10" BorderBrush="#334155" BorderThickness="1" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="EmptyStateText" Text="Перетягніть сюди файли для тимчасового закріплення"
                               Foreground="#64748B" FontSize="12" TextAlignment="Center" Margin="10,40,10,0" TextWrapping="Wrap" />

                    <ItemsControl x:Name="ShelfItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0F172A" CornerRadius="8" Padding="10,8" Margin="0,0,0,8"
                                        BorderBrush="#334155" BorderThickness="1"
                                        MouseMove="ShelfItem_MouseMove" Cursor="Hand" ToolTip="Потягніть мишкою, щоб перетягнути файл куди завгодно">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="📄" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SizeText}" FontSize="10" Foreground="#94A3B8" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="✕" Width="24" Height="24" Padding="0" Margin="4,0,0,0"
                                                Tag="{Binding FullPath}" Click="BtnRemoveItem_Click" Background="Transparent" BorderBrush="Transparent" Foreground="#94A3B8" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Drop helper footer -->
        <TextBlock Grid.Row="2" Text="💡 Порада: Файли з полички можна перетягувати у будь-яку програму або Провідник."
                   FontSize="11" Foreground="#64748B" Margin="0,10,0,0" TextWrapping="Wrap" />
    </Grid>
</Window>
