<Window x:Class="Halo.App.Views.ShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Halo — Полиця файлів"
        Height="560" Width="430"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Foreground="{DynamicResource OrbitTextPrimary}"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        Icon="pack://application:,,,/Resources/avatar.png"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Border Background="{DynamicResource OrbitWindowBgBrush}"
            CornerRadius="20"
            BorderBrush="{DynamicResource OrbitCardBorderBrush}"
            BorderThickness="1.5"
            Margin="10"
            Effect="{StaticResource OrbitCardShadow}">
        <Grid Margin="18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Custom Draggable Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" BorderBrush="{DynamicResource OrbitPurpleLightBrush}" BorderThickness="1.5" ClipToBounds="True" Margin="0,0,10,0">
                    <Image Source="pack://application:,,,/Resources/avatar.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ShelfTitleText" Text="Полиця файлів" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource OrbitTextPrimary}" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource OrbitPurpleSoftBg}" CornerRadius="8" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ShelfCountBadgeText" Text="0" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource OrbitPurpleLightBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="ShelfSubtitleText" Text="Тимчасове сховище та групові дії" FontSize="11"
                               Foreground="{DynamicResource OrbitTextSecondary}" />
                </StackPanel>

                <Button Grid.Column="2" Content="✕" Width="30" Height="30" Padding="0"
                        Style="{StaticResource OrbitSecondaryButton}"
                        Click="BtnClose_Click" />
            </Grid>

            <!-- Top Action Bar: Add Files / Clear -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnAddFiles" Grid.Column="0" Content="＋ Додати файли"
                        Style="{StaticResource OrbitPrimaryButton}"
                        Padding="12,8" FontSize="12.5" Margin="0,0,8,0"
                        Click="BtnAddFiles_Click" />
                <Button x:Name="BtnClearShelf" Grid.Column="1" Content="Очистити"
                        Style="{StaticResource OrbitSecondaryButton}"
                        Padding="12,8" FontSize="12"
                        Click="BtnClearAll_Click" />
            </Grid>

            <!-- Shelf Items List -->
            <Border Grid.Row="2" Background="{DynamicResource OrbitCardBgBrush}"
                    CornerRadius="16"
                    BorderBrush="{DynamicResource OrbitCardBorderBrush}"
                    BorderThickness="1"
                    Padding="10">
                <Grid>
                    <StackPanel x:Name="EmptyStatePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
                        <TextBlock Text="📥" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock x:Name="EmptyStateTitleText" Text="Полиця порожня"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource OrbitTextPrimary}"
                                   HorizontalAlignment="Center" Margin="0,0,0,4" />
                        <TextBlock x:Name="EmptyStateDescText"
                                   Text="Перетягніть сюди файли з Провідника або додайте їх через кругове меню Halo (Дії → На полицю)."
                                   Foreground="{DynamicResource OrbitTextSecondary}"
                                   FontSize="12" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ShelfItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource OrbitRecessedBgBrush}"
                                            CornerRadius="12" Padding="10,9" Margin="0,0,0,7"
                                            BorderBrush="{DynamicResource OrbitCardBorderBrush}" BorderThickness="1"
                                            MouseMove="ShelfItem_MouseMove" Cursor="Hand"
                                            ToolTip="{Binding DragTooltip}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9"
                                                    Background="{DynamicResource OrbitCardBgBrush}" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Icon}" FontSize="16"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource OrbitTextPrimary}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding SizeText}" FontSize="11"
                                                           Foreground="{DynamicResource OrbitTextSecondary}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="📋" Width="28" Height="28" Padding="0" Margin="0,0,4,0"
                                                        Tag="{Binding FullPath}" Click="BtnCopyItemToClipboard_Click"
                                                        ToolTip="{Binding CopyClipboardTooltip}"
                                                        Style="{StaticResource OrbitSecondaryButton}" />
                                                <Button Content="✦" Width="28" Height="28" Padding="0" Margin="0,0,4,0"
                                                        Tag="{Binding FullPath}" Click="BtnOpenItemInHalo_Click"
                                                        ToolTip="{Binding OpenInHaloTooltip}"
                                                        Style="{StaticResource OrbitSecondaryButton}" Foreground="{DynamicResource OrbitPurpleLightBrush}" />
                                                <Button Content="📂" Width="28" Height="28" Padding="0" Margin="0,0,4,0"
                                                        Tag="{Binding FullPath}" Click="BtnRevealItem_Click"
                                                        ToolTip="{Binding RevealTooltip}"
                                                        Style="{StaticResource OrbitSecondaryButton}" />
                                                <Button Content="✕" Width="28" Height="28" Padding="0"
                                                        Tag="{Binding FullPath}" Click="BtnRemoveItem_Click"
                                                        ToolTip="{Binding RemoveTooltip}"
                                                        Style="{StaticResource OrbitSecondaryButton}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Batch Actions Footer: 2x2 Clear UX Grid (Clipboard Ctrl+V vs Copy to Folder + Halo + ZIP) -->
            <UniformGrid Grid.Row="3" Columns="2" Rows="2" Margin="0,12,0,0">
                <Button x:Name="BtnBatchClipboard" Content="📋 У буфер (Ctrl+V)"
                        Style="{StaticResource OrbitPrimaryButton}"
                        Padding="10,7" FontSize="12" Margin="0,0,4,6"
                        Click="BtnBatchClipboard_Click" />
                <Button x:Name="BtnBatchCopy" Content="📁 Копіювати в папку…"
                        Style="{StaticResource OrbitSecondaryButton}"
                        Padding="10,7" FontSize="12" Margin="4,0,0,6"
                        Click="BtnBatchCopy_Click" />
                <Button x:Name="BtnBatchHalo" Content="✦ Відкрити у Halo"
                        Style="{StaticResource OrbitSecondaryButton}"
                        Padding="10,7" FontSize="12" Margin="0,0,4,0"
                        Click="BtnBatchHalo_Click" />
                <Button x:Name="BtnBatchZip" Content="🗜️ Запакувати в ZIP"
                        Style="{StaticResource OrbitSecondaryButton}"
                        Padding="10,7" FontSize="12" Margin="4,0,0,0"
                        Click="BtnBatchZip_Click" />
            </UniformGrid>

            <!-- Status / Drag & Copy UX explanation -->
            <Border Grid.Row="4" Background="{DynamicResource OrbitRecessedBgBrush}" BorderBrush="{DynamicResource OrbitSubtleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,7" Margin="0,10,0,0">
                <TextBlock x:Name="ShelfFooterHintText"
                           Text="«У буфер (Ctrl+V)» копіює файли для швидкої вставки будь-куди, а «Копіювати в папку…» зберігає копії в обраний каталог."
                           FontSize="11" Foreground="{DynamicResource OrbitTextSecondary}"
                           TextAlignment="Center" TextWrapping="Wrap" />
            </Border>
        </Grid>
    </Border>
</Window>
