<Window x:Class="Halo.App.Views.ShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Halo — Поличка файлів"
        Height="440" Width="340"
        WindowStyle="ToolWindow"
        Topmost="True"
        Background="#1E1E24"
        Foreground="#F2F3F7"
        FontFamily="Segoe UI Variable, Segoe UI"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Border Width="32" Height="32" CornerRadius="9" Background="#2D2346" Margin="0,0,10,0">
                    <TextBlock Text="📌" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Поличка файлів" FontSize="16" FontWeight="Bold" Foreground="#F2F3F7" VerticalAlignment="Center" />
            </StackPanel>
            <Button Content="Очистити" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="BtnClearAll_Click"
                    Style="{StaticResource OrbitSecondaryButton}" Padding="10,5" FontSize="11.5" />
        </DockPanel>

        <!-- Shelf items list -->
        <Border Grid.Row="1" Background="#282832" CornerRadius="16" BorderBrush="#343442" BorderThickness="1" Padding="10"
                Effect="{StaticResource OrbitSoftShadow}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="EmptyStateText" Text="Перетягніть сюди файли для тимчасового закріплення"
                               Foreground="#6C7085" FontSize="12.5" TextAlignment="Center" Margin="14,50,14,0" TextWrapping="Wrap" />

                    <ItemsControl x:Name="ShelfItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E1E26" CornerRadius="12" Padding="12,10" Margin="0,0,0,8"
                                        BorderBrush="#323242" BorderThickness="1"
                                        MouseMove="ShelfItem_MouseMove" Cursor="Hand" ToolTip="Потягніть мишкою, щоб перетягнути файл куди завгодно">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="📄" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#F2F3F7" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SizeText}" FontSize="11" Foreground="#A0A3B5" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="✕" Width="26" Height="26" Padding="0" Margin="4,0,0,0"
                                                Tag="{Binding FullPath}" Click="BtnRemoveItem_Click"
                                                Style="{StaticResource OrbitSecondaryButton}" Foreground="#A0A3B5" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Drop helper footer -->
        <TextBlock Grid.Row="2" Text="Файли з полички можна перетягувати у будь-яку програму або Провідник."
                   FontSize="11.5" Foreground="#6C7085" Margin="0,12,0,0" TextWrapping="Wrap" />
    </Grid>
</Window>
