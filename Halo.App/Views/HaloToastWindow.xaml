<Window x:Class="Halo.App.Views.HaloToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Halo Notification"
        Width="370" Height="96"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">

    <Grid Margin="10">
        <!-- Тінь картки -->
        <Border Background="{DynamicResource OrbitWindowBgBrush}"
                CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.55" />
            </Border.Effect>
        </Border>

        <!-- Тіло сповіщення Orbit -->
        <Border x:Name="ToastRoot"
                Background="{DynamicResource OrbitCardBgBrush}"
                BorderBrush="{DynamicResource OrbitHeroBorderBrush}"
                BorderThickness="1.2"
                CornerRadius="14"
                Padding="12,10"
                Cursor="Hand"
                MouseLeftButtonDown="ToastRoot_MouseDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Логотип / Іконка -->
                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="11"
                        Background="{DynamicResource OrbitLogoBoxBgBrush}"
                        BorderBrush="{DynamicResource OrbitLogoBoxBorderBrush}"
                        BorderThickness="1.2"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center">
                    <Grid>
                        <Image Source="pack://application:,,,/Resources/avatar.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Width="26" Height="26" />
                    </Grid>
                </Border>

                <!-- Текстовий блок + Прогрес-бар -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <DockPanel>
                        <TextBlock x:Name="TxtToastTitle" Text="Halo" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TxtRemainingTime" DockPanel.Dock="Right" HorizontalAlignment="Right" Text="" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OrbitCyanBrush}" Margin="8,0,0,0" Visibility="Collapsed" />
                    </DockPanel>
                    <TextBlock x:Name="TxtToastMessage" Text="Програма активна у фоновому режимі" FontSize="11.5" Foreground="{DynamicResource OrbitTextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,4" />

                    <!-- Прогрес-бар (видно коли активна операція) -->
                    <ProgressBar x:Name="ToastProgressBar" Height="4" Maximum="100" Value="0"
                                 Background="{DynamicResource OrbitRecessedBgBrush}"
                                 Foreground="{DynamicResource OrbitCyanBrush}"
                                 BorderThickness="0"
                                 Visibility="Collapsed" />
                </StackPanel>

                <!-- Кнопка закриття -->
                <Button Grid.Column="2" Style="{StaticResource OrbitWindowCapBtn}" Width="24" Height="24" Margin="6,0,0,0" VerticalAlignment="Top" Click="BtnCloseToast_Click">
                    <Path Data="{StaticResource OrbitIconClose}" Stroke="{DynamicResource OrbitTextMuted}" StrokeThickness="1.6" Width="8" Height="8" Stretch="Uniform" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
