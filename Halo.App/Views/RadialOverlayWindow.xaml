<Window x:Class="Halo.App.Views.RadialOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Halo Radial Menu"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        KeyDown="Window_KeyDown"
        MouseDown="Window_MouseDown"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Window.Resources>
        <Storyboard x:Key="EntranceAnimation">
            <DoubleAnimation Storyboard.TargetName="MenuRootTransform"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.65" To="1.0" Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MenuRootTransform"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.65" To="1.0" Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MenuCanvas"
                             Storyboard.TargetProperty="Opacity"
                             From="0.0" To="1.0" Duration="0:0:0.18" />
        </Storyboard>
    </Window.Resources>

    <Grid Background="#2409090D">
        <!-- Спливаюча капсула сповіщення в стилі Orbit (Тінь на окремому фоновому шарі, текст чіткий!) -->
        <Grid x:Name="NotificationPill"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="0,38,0,0"
              Opacity="0"
              IsHitTestVisible="False">
            <Border Background="#282832"
                    CornerRadius="14"
                    Effect="{StaticResource OrbitCardShadow}" />
            <Border Background="#282832"
                    CornerRadius="14"
                    Padding="20,11"
                    BorderBrush="#6D5AE6"
                    BorderThickness="1.5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="NotificationIcon" Text="✦" FontSize="15" Foreground="#A78BFA" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="NotificationText" Text="Дію успішно виконано" Foreground="#F2F3F7" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Radial Menu Canvas Root -->
        <Canvas x:Name="OverlayCanvas">
            <Canvas x:Name="MenuCanvas" RenderTransformOrigin="0.5,0.5">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="MenuRootTransform" ScaleX="1.0" ScaleY="1.0" />
                    </TransformGroup>
                </Canvas.RenderTransform>

                <!-- Фонове кільце-ореол Orbit (Ambient Ring) -->
                <Ellipse x:Name="AmbientBackdropRing"
                         Fill="#D816161C"
                         Stroke="#343446"
                         StrokeThickness="1.5"
                         IsHitTestVisible="False" />

                <!-- Контейнер секторів -->
                <Canvas x:Name="SectorsHost" />

                <!-- Центральне ядро Orbit (Без Effect на контейнері тексту!) -->
                <Grid x:Name="CenterHub"
                      Cursor="Hand"
                      MouseDown="CenterHub_MouseDown">
                    <!-- Фоновий шар світіння -->
                    <Border x:Name="CenterHubGlow"
                            CornerRadius="100"
                            Background="#17171C"
                            Effect="{StaticResource OrbitPurpleGlow}" />

                    <!-- Основний чіткий круг ядра -->
                    <Border CornerRadius="100"
                            Background="#17171C"
                            BorderBrush="{StaticResource OrbitLogoGradient}"
                            BorderThickness="2.5">
                        <Grid Margin="10">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="CenterFileIcon"
                                           Text="◎"
                                           FontSize="24"
                                           Foreground="#A78BFA"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,3" />
                                <TextBlock x:Name="CenterFileName"
                                           Text="Halo"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="#F2F3F7"
                                           MaxWidth="96"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="CenterFileInfo"
                                           Text="Оберіть сектор"
                                           FontSize="10"
                                           Foreground="#A0A3B5"
                                           MaxWidth="96"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           HorizontalAlignment="Center"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Нижня інформаційна картка-підказка Orbit під круговим меню -->
                <Border x:Name="BottomHintPill"
                        Background="#F224242E"
                        BorderBrush="#3E3E52"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="14,7"
                        IsHitTestVisible="False">
                    <TextBlock x:Name="BottomHintText"
                               Text="Наведіть курсор на сектор або перетягніть файл"
                               FontSize="12"
                               FontWeight="Medium"
                               Foreground="#A0A3B5"
                               TextAlignment="Center" />
                </Border>
            </Canvas>
        </Canvas>
    </Grid>
</Window>
