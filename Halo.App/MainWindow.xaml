<Window x:Class="Halo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Halo.App.Controls"
        Title="Halo"
        Height="740" Width="1140"
        MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- Outer Window Glass Container with 1px subtle border & shadow -->
    <Border Background="{StaticResource WindowBgBrush}"
            BorderBrush="{StaticResource GlassBorderLight}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" Color="#000000" Opacity="0.7" ShadowDepth="8" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============================================== -->
            <!-- TOP CUSTOM TITLEBAR (DRAGGABLE GLASS BAR)      -->
            <!-- ============================================== -->
            <Border Grid.Row="0" Background="#0B0F19" BorderBrush="{StaticResource GlassBorderSubtle}" BorderThickness="0,0,0,1"
                    CornerRadius="14,14,0,0" MouseDown="TitleBar_MouseDown">
                <DockPanel Margin="16,0,10,0">
                    <!-- Brand Top Left -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Border Width="20" Height="20" CornerRadius="10" Background="#0C1929" BorderBrush="{StaticResource NeonCyanBrush}" BorderThickness="1.5" Margin="0,0,8,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" Color="#00F0FF" Opacity="0.8" ShadowDepth="0" />
                            </Border.Effect>
                        </Border>
                        <TextBlock Text="HALO" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource NeonCyanBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="• SYSTEM CONTROLLER" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="6,1,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Window Control Buttons Top Right -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource WindowCaptionBtn}" Click="BtnMinimize_Click">
                            <Path Data="{StaticResource IconMinimizeGeo}" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5" Width="10" Height="10" Stretch="Uniform" />
                        </Button>
                        <Button Style="{StaticResource WindowCloseBtn}" Click="BtnClose_Click" Margin="4,0,0,0">
                            <Path Data="{StaticResource IconCloseGeo}" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5" Width="10" Height="10" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ============================================== -->
            <!-- MAIN CONTENT AREA (SIDEBAR + WORKSPACE)        -->
            <!-- ============================================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ========================================== -->
                <!-- LEFT SIDEBAR                               -->
                <!-- ========================================== -->
                <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource GlassBorderSubtle}" BorderThickness="0,0,1,0" Padding="14,16">
                    <DockPanel>
                        <!-- Navigation Tabs (No support, No version) -->
                        <StackPanel DockPanel.Dock="Top">
                            <RadioButton x:Name="NavMain" Style="{StaticResource SidebarTabItem}" IsChecked="True" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconHomeGeo}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" />
                                    <TextBlock Text="Головна" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavInput" Style="{StaticResource SidebarTabItem}" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconKeyboardGeo}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" />
                                    <TextBlock Text="Жести й клавіші" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavRadial" Style="{StaticResource SidebarTabItem}" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconRadialGeo}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" />
                                    <TextBlock Text="Кругові меню" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavPresets" Style="{StaticResource SidebarTabItem}" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconPresetsGeo}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" />
                                    <TextBlock Text="Шаблони" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavFolders" Style="{StaticResource SidebarTabItem}" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconFoldersGeo}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" />
                                    <TextBlock Text="Відстеження папок" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavSettings" Style="{StaticResource SidebarTabItem}" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconSettingsGeo}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" />
                                    <TextBlock Text="Налаштування" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <!-- Clean Bottom Status Indicator -->
                        <Border DockPanel.Dock="Bottom" Background="#0F1728" CornerRadius="8" Padding="12,10" BorderBrush="{StaticResource GlassBorderSubtle}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource NeonGreenBrush}" Margin="0,0,8,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="8" Color="#10B981" Opacity="0.9" ShadowDepth="0" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                <TextBlock Text="Двигун активний" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- ========================================== -->
                <!-- RIGHT WORKSPACE (6 SCREENS)                -->
                <!-- ========================================== -->
                <Grid Grid.Column="1" Margin="28,22">

                    <!-- ============================================== -->
                    <!-- SCREEN 1: "ГОЛОВНА" (REDESIGNED QUICK HUB)     -->
                    <!-- ============================================== -->
                    <Grid x:Name="ScreenMain" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 1. Hero Glass Status Banner -->
                        <Border Grid.Row="0" Background="{StaticResource CardGlassGradient}"
                                BorderBrush="{StaticResource GlassBorderLight}" BorderThickness="1"
                                CornerRadius="14" Padding="24,20" Margin="0,0,0,20">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" Color="#00F0FF" Opacity="0.08" ShadowDepth="4" />
                            </Border.Effect>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Ellipse Width="10" Height="10" Fill="{StaticResource NeonCyanBrush}" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Ellipse.Effect>
                                                <DropShadowEffect BlurRadius="12" Color="#00F0FF" Opacity="1" ShadowDepth="0" />
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <TextBlock Text="ЯДРО HALO АКТИВНЕ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource NeonCyanBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Швидкий доступ до файлових операцій" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="Виділіть будь-який файл у системі та натисніть призначений хоткей або перетягніть мишкою."
                                               FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" />
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="⚡ Тестовий запуск" Style="{StaticResource GlowingAccentButton}" Click="BtnOpenHaloHere_Click" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 2. Quick Hub Action Cards (3 Sleek Glass Cards) -->
                        <Grid Grid.Row="1" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Card 1: Radial Launcher -->
                            <Border Grid.Column="0" Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassBorderSubtle}" BorderThickness="1"
                                    CornerRadius="12" Padding="18" Margin="0,0,10,0" Cursor="Hand" MouseLeftButtonDown="BtnOpenHaloHere_Click">
                                <StackPanel>
                                    <Border Width="38" Height="38" CornerRadius="10" Background="#142136" BorderBrush="{StaticResource NeonCyanBrush}" BorderThickness="1" HorizontalAlignment="Left" Margin="0,0,0,12">
                                        <TextBlock Text="⭕" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Кругове меню" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="Відкрити оверлей над курсором" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Shelf -->
                            <Border Grid.Column="1" Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassBorderSubtle}" BorderThickness="1"
                                    CornerRadius="12" Padding="18" Margin="5,0,5,0" Cursor="Hand" MouseLeftButtonDown="BtnOpenShelf_Click">
                                <StackPanel>
                                    <Border Width="38" Height="38" CornerRadius="10" Background="#241838" BorderBrush="{StaticResource NeonPurpleBrush}" BorderThickness="1" HorizontalAlignment="Left" Margin="0,0,0,12">
                                        <TextBlock Text="📌" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Поличка файлів" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="Плаваючий буфер тимчасових файлів" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Configure -->
                            <Border Grid.Column="2" Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassBorderSubtle}" BorderThickness="1"
                                    CornerRadius="12" Padding="18" Margin="10,0,0,0" Cursor="Hand" MouseLeftButtonDown="BtnJumpToRadial_Click">
                                <StackPanel>
                                    <Border Width="38" Height="38" CornerRadius="10" Background="#102824" BorderBrush="{StaticResource NeonGreenBrush}" BorderThickness="1" HorizontalAlignment="Left" Margin="0,0,0,12">
                                        <TextBlock Text="🎯" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Конфігуратор секторів" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="Налаштувати пелюстки дій" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 3. System Telemetry & Quick Feed -->
                        <Border Grid.Row="2" Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassBorderSubtle}" BorderThickness="1"
                                CornerRadius="12" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,14">
                                    <TextBlock Text="СИСТЕМНИЙ СТАН" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" />
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                        <TextBlock Text="Хоткей: " FontSize="11.5" Foreground="{StaticResource TextMuted}" />
                                        <TextBlock x:Name="QuickHotkeyDisplay" Text="Alt+Space" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource NeonCyanBrush}" />
                                    </StackPanel>
                                </DockPanel>

                                <!-- Performance telemetry bar -->
                                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Затримка реакції" FontSize="11.5" Foreground="{StaticResource TextMuted}" />
                                            <TextBlock Text="&lt; 2 ms" FontSize="18" FontWeight="Bold" Foreground="{StaticResource NeonCyanBrush}" Margin="0,3,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Графічний рендер" FontSize="11.5" Foreground="{StaticResource TextMuted}" />
                                            <TextBlock Text="Direct3D (SkiaSharp)" FontSize="18" FontWeight="Bold" Foreground="{StaticResource NeonGreenBrush}" Margin="0,3,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Пам'ять фонового процесу" FontSize="11.5" Foreground="{StaticResource TextMuted}" />
                                            <TextBlock Text="~24 MB" FontSize="18" FontWeight="Bold" Foreground="{StaticResource NeonPurpleBrush}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Test file launcher button -->
                                    <Button Content="📂  Вибрати файл для перевірки меню" Style="{StaticResource GlassButton}" Click="BtnPickFile_Click" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- SCREEN 2: "ЖЕСТИ Й КЛАВІШІ"                    -->
                    <!-- ============================================== -->
                    <Grid x:Name="ScreenInput" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                                <TextBlock Text="Жести й клавіші" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="Натисніть на картку комбінації, щоб записати новий хоткей прямо з клавіатури."
                                           FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,20" />

                                <!-- Pause Toggle Switch Card -->
                                <Border Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassBorderSubtle}" BorderThickness="1"
                                        CornerRadius="12" Padding="20,16" Margin="0,0,0,16">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Left">
                                            <TextBlock Text="Призупинити реакцію на жести та клавіші" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                            <TextBlock Text="Вимикає всі хуки системи (зручно під час повноцінних 3D-ігор)" FontSize="11.5" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <CheckBox x:Name="CheckPauseGestures" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                  Style="{StaticResource GlowingToggleSwitch}" Click="CheckPauseGestures_Click" />
                                    </DockPanel>
                                </Border>

                                <!-- Interactive Hotkey Recorder Card -->
                                <Border x:Name="HotkeyRecorderCard" Background="{StaticResource GlassCardBrush}"
                                        BorderBrush="{StaticResource GlassBorderLight}" BorderThickness="1.5"
                                        CornerRadius="12" Padding="22" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="ГЛОБАЛЬНИЙ ХОТКЕЙ ВИКЛИКУ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,10" />

                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                                <TextBlock x:Name="HotkeyRecorderStatusText" Text="Alt+Space" FontSize="24" FontWeight="Bold" Foreground="{StaticResource NeonCyanBrush}" />
                                                <TextBlock x:Name="HotkeyRecorderHint" Text="Натисніть «Записати» та натисніть комбінацію на клавіатурі" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" />
                                            </StackPanel>

                                            <Button x:Name="BtnRecordHotkey" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                    Content="⏺️  Записати комбінацію" Style="{StaticResource GlassButton}" Click="BtnRecordHotkey_Click" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Mouse Gestures -->
                                <Border Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassBorderSubtle}" BorderThickness="1"
                                        CornerRadius="12" Padding="20">
                                    <StackPanel>
                                        <TextBlock Text="ЖЕСТИ МИШІ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,14" />

                                        <DockPanel Margin="0,0,0,12">
                                            <StackPanel DockPanel.Dock="Left">
                                                <TextBlock Text="Струшування мишею при перетягуванні файлу" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                                <TextBlock Text="Швидкий рух файлу викликає кругове меню поруч" FontSize="11.5" Foreground="{StaticResource TextMuted}" />
                                            </StackPanel>
                                            <CheckBox IsChecked="True" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource GlowingToggleSwitch}" />
                                        </DockPanel>

                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Left">
                                                <TextBlock Text="Затискання середньої кнопки миші (Коліщатко)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                                <TextBlock Text="Виклик над активним файлом у Windows Explorer" FontSize="11.5" Foreground="{StaticResource TextMuted}" />
                                            </StackPanel>
                                            <CheckBox IsChecked="True" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource GlowingToggleSwitch}" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- SCREEN 3: "КРУГОВІ МЕНЮ" (FIXED PROPORTIONS)   -->
                    <!-- ============================================== -->
                    <Grid x:Name="ScreenRadial" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="Кругові меню" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="Оберіть тип файлу, щоб налаштувати активні сектори на диску."
                                       FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="340" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Column 1: Category Selection -->
                            <Border Grid.Column="0" Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassBorderSubtle}" BorderThickness="1"
                                    CornerRadius="12" Padding="8" Margin="0,0,12,0">
                                <ListBox x:Name="RadialCategoriesList" Background="Transparent" BorderThickness="0" SelectionChanged="RadialCategoriesList_SelectionChanged">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="8" Padding="10,9" Margin="0,2" Cursor="Hand">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="Background" Value="#172338" />
                                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource GlassBorderLight}" />
                                                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1" />
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="Background" Value="#131D2E" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>

                                    <ListBoxItem IsSelected="True" Tag="Image">
                                        <DockPanel Width="170">
                                            <TextBlock Text="🖼️  Зображення" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                                            <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="#0C344E" CornerRadius="6" Padding="6,1">
                                                <TextBlock x:Name="BadgeImageCount" Text="6/8" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource NeonCyanBrush}" />
                                            </Border>
                                        </DockPanel>
                                    </ListBoxItem>

                                    <ListBoxItem Tag="Document">
                                        <DockPanel Width="170">
                                            <TextBlock Text="📄  PDF / Документи" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                                            <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="#0D3824" CornerRadius="6" Padding="6,1">
                                                <TextBlock x:Name="BadgeDocCount" Text="4/8" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource NeonGreenBrush}" />
                                            </Border>
                                        </DockPanel>
                                    </ListBoxItem>

                                    <ListBoxItem Tag="Video">
                                        <DockPanel Width="170">
                                            <TextBlock Text="🎬  Відео" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                                            <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="#3B1759" CornerRadius="6" Padding="6,1">
                                                <TextBlock x:Name="BadgeVideoCount" Text="3/8" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource NeonPurpleBrush}" />
                                            </Border>
                                        </DockPanel>
                                    </ListBoxItem>

                                    <ListBoxItem Tag="Audio">
                                        <DockPanel Width="170">
                                            <TextBlock Text="🎵  Аудіо" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                                            <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="#4A1542" CornerRadius="6" Padding="6,1">
                                                <TextBlock x:Name="BadgeAudioCount" Text="2/8" FontSize="10.5" FontWeight="Bold" Foreground="#F472B6" />
                                            </Border>
                                        </DockPanel>
                                    </ListBoxItem>

                                    <ListBoxItem Tag="Generic">
                                        <DockPanel Width="170">
                                            <TextBlock Text="📦  Будь-які файли" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                                            <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="#1A2436" CornerRadius="6" Padding="6,1">
                                                <TextBlock x:Name="BadgeGenericCount" Text="5/8" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" />
                                            </Border>
                                        </DockPanel>
                                    </ListBoxItem>
                                </ListBox>
                            </Border>

                            <!-- Column 2: Fixed Ratio Radial Disc (Never distorts!) -->
                            <Border Grid.Column="1" Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassBorderSubtle}" BorderThickness="1"
                                    CornerRadius="12" Margin="0,0,12,0">
                                <Viewbox Stretch="Uniform" MaxWidth="320" MaxHeight="320" Margin="10">
                                    <controls:RadialDiscControl x:Name="PreviewRadialDisc" />
                                </Viewbox>
                            </Border>

                            <!-- Column 3: Actions List with Toggle Switches -->
                            <Border Grid.Column="2" Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassBorderSubtle}" BorderThickness="1"
                                    CornerRadius="12" Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="СЕКТОРИ КАТЕГОРІЇ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,12" />

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="RadialActionsItemsControl">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#141C2B" CornerRadius="8" Padding="12,10" Margin="0,0,0,8"
                                                            BorderBrush="{StaticResource GlassBorderSubtle}" BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0" Text="{Binding IconKey}" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                                                            </StackPanel>

                                                            <CheckBox Grid.Column="2" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                      Style="{StaticResource GlowingToggleSwitch}" Click="RadialActionToggle_Click" Tag="{Binding}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- SCREEN 4: "ШАБЛОНИ" (PRESETS GALLERY)          -->
                    <!-- ============================================== -->
                    <Grid x:Name="ScreenPresets" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,18">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Шаблони та макроси" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="Комплексні ланцюжки перетворень в один клік."
                                           FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="➕  Новий шаблон"
                                    Style="{StaticResource GlowingAccentButton}" Click="BtnCreatePreset_Click" />
                        </DockPanel>

                        <!-- Preset Cards Gallery -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <WrapPanel Orientation="Horizontal">
                                <!-- Preset 1 -->
                                <Border Width="270" Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassBorderLight}" BorderThickness="1"
                                        CornerRadius="12" Padding="18" Margin="0,0,14,14">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" Color="#00F0FF" Opacity="0.08" ShadowDepth="2" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="🌐 Оптимізація для Web" FontSize="14" FontWeight="Bold" Foreground="{StaticResource NeonCyanBrush}" />
                                            <Border DockPanel.Dock="Right" Background="#0C344E" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="WebP" FontSize="9" FontWeight="Bold" Foreground="{StaticResource NeonCyanBrush}" />
                                            </Border>
                                        </DockPanel>
                                        <TextBlock Text="Перетворення в WebP + ресайз до 1920px зі стисненням 80%" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,14" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Виконати" Style="{StaticResource GlassButton}" Padding="10,4" FontSize="11" Click="BtnTestPreset_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Preset 2 -->
                                <Border Width="270" Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassBorderLight}" BorderThickness="1"
                                        CornerRadius="12" Padding="18" Margin="0,0,14,14">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" Color="#A855F7" Opacity="0.08" ShadowDepth="2" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="🖤 Чорно-білий архів" FontSize="14" FontWeight="Bold" Foreground="{StaticResource NeonPurpleBrush}" />
                                            <Border DockPanel.Dock="Right" Background="#3B1759" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="B&amp;W" FontSize="9" FontWeight="Bold" Foreground="{StaticResource NeonPurpleBrush}" />
                                            </Border>
                                        </DockPanel>
                                        <TextBlock Text="Контрастний монохромний фільтр + копіювання в папку архіву" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,14" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Виконати" Style="{StaticResource GlassButton}" Padding="10,4" FontSize="11" Click="BtnTestPreset_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Preset 3 -->
                                <Border Width="270" Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassBorderLight}" BorderThickness="1"
                                        CornerRadius="12" Padding="18" Margin="0,0,14,14">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" Color="#10B981" Opacity="0.08" ShadowDepth="2" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="📄 Документ в PDF" FontSize="14" FontWeight="Bold" Foreground="{StaticResource NeonGreenBrush}" />
                                            <Border DockPanel.Dock="Right" Background="#0D3824" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="PDF" FontSize="9" FontWeight="Bold" Foreground="{StaticResource NeonGreenBrush}" />
                                            </Border>
                                        </DockPanel>
                                        <TextBlock Text="Миттєва генерація PDF-файлу з оптимізацією розміру" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,14" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Виконати" Style="{StaticResource GlassButton}" Padding="10,4" FontSize="11" Click="BtnTestPreset_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- SCREEN 5: "ВІДСТЕЖЕННЯ ПАПОК" (AUTOMATION)      -->
                    <!-- ============================================== -->
                    <Grid x:Name="ScreenFolders" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,16">
                            <StackPanel DockPanel.Dock="Left">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Відстеження папок" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                    <Border Background="#0C3424" CornerRadius="6" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource NeonGreenBrush}" Margin="0,0,6,0" />
                                            <TextBlock Text="Моніторинг активний" FontSize="10" FontWeight="Bold" Foreground="{StaticResource NeonGreenBrush}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Автоматична фонова обробка нових файлів у заданих каталогах."
                                           FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                            </StackPanel>

                            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="➕  Додати папку"
                                    Style="{StaticResource GlowingAccentButton}" Click="BtnAddFolder_Click" />
                        </DockPanel>

                        <!-- Add Rule Glass Card -->
                        <Border Grid.Row="1" Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassBorderLight}" BorderThickness="1"
                                CornerRadius="12" Padding="14" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="QuickFolderInput" Text="C:\Users\...\Downloads" Background="#0A0E18" Foreground="{StaticResource NeonCyanBrush}"
                                         BorderBrush="{StaticResource GlassBorderSubtle}" Padding="12,8" Margin="0,0,10,0" FontSize="12.5" />
                                <ComboBox x:Name="QuickActionCombo" Grid.Column="1" Background="#0A0E18" Foreground="Black" Margin="0,0,10,0" SelectedIndex="0" Padding="8">
                                    <ComboBoxItem Content="Конвертувати у WebP" Tag="image_to_webp" />
                                    <ComboBoxItem Content="Конвертувати у PNG" Tag="image_to_png" />
                                    <ComboBoxItem Content="Стиснути зображення" Tag="image_compress" />
                                    <ComboBoxItem Content="Чорно-білий фільтр" Tag="image_grayscale" />
                                </ComboBox>
                                <Button Grid.Column="2" Content="Створити правило" Style="{StaticResource GlassButton}" Click="BtnQuickAddRule_Click" />
                            </Grid>
                        </Border>

                        <!-- Folder Rules List -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="FoldersRulesItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource GlassCardBrush}" CornerRadius="10" Padding="16,12" Margin="0,0,0,8"
                                                BorderBrush="{StaticResource GlassBorderSubtle}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FolderPath}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                                    <TextBlock Text="{Binding AssignedActionId, StringFormat='Автоматична дія: {0}'}" FontSize="11" Foreground="{StaticResource NeonCyanBrush}" Margin="0,2,0,0" />
                                                </StackPanel>

                                                <Button Grid.Column="1" Content="Видалити" Style="{StaticResource GlassButton}" Margin="0,0,12,0" Padding="10,4"
                                                        Tag="{Binding}" Click="BtnDeleteFolderRule_Click" />
                                                <CheckBox Grid.Column="2" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                          Style="{StaticResource GlowingToggleSwitch}" Tag="{Binding}" Click="FolderRuleToggle_Click" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- SCREEN 6: "НАЛАШТУВАННЯ"                      -->
                    <!-- ============================================== -->
                    <Grid x:Name="ScreenSettings" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                                <TextBlock Text="Налаштування" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="Системні опції, поведінка збереження файлів та графіка."
                                           FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,20" />

                                <Border Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassBorderSubtle}" BorderThickness="1"
                                        CornerRadius="12" Padding="20" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="МОВА ІНТЕРФЕЙСУ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8" />
                                        <ComboBox x:Name="LanguageCombo" Width="220" HorizontalAlignment="Left" Background="#0A0E18" Foreground="Black" SelectedIndex="0" Padding="8">
                                            <ComboBoxItem Content="Українська" />
                                            <ComboBoxItem Content="English" />
                                        </ComboBox>

                                        <Separator Background="{StaticResource GlassBorderSubtle}" Margin="0,16" />

                                        <TextBlock Text="ТЕМА ОФОРМЛЕННЯ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8" />
                                        <ComboBox x:Name="GeneralThemeCombo" Width="220" HorizontalAlignment="Left" Background="#0A0E18" Foreground="Black"
                                                  SelectedIndex="0" Padding="8" SelectionChanged="GeneralThemeCombo_SelectionChanged">
                                            <ComboBoxItem Content="Темна кіберпанк" />
                                            <ComboBoxItem Content="Світла неонова" />
                                            <ComboBoxItem Content="Системна" />
                                        </ComboBox>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassBorderSubtle}" BorderThickness="1"
                                        CornerRadius="12" Padding="20">
                                    <StackPanel>
                                        <TextBlock Text="СИСТЕМА" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,12" />

                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock Text="Автозапуск разом із Windows" FontSize="13" Foreground="{StaticResource TextPrimary}" />
                                            <CheckBox IsChecked="True" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource GlowingToggleSwitch}" />
                                        </DockPanel>

                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock Text="Інтеграція в меню Windows Explorer" FontSize="13" Foreground="{StaticResource TextPrimary}" />
                                            <CheckBox IsChecked="True" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource GlowingToggleSwitch}" />
                                        </DockPanel>

                                        <DockPanel>
                                            <TextBlock Text="Апаратне прискорення Direct3D" FontSize="13" Foreground="{StaticResource TextPrimary}" />
                                            <CheckBox IsChecked="True" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource GlowingToggleSwitch}" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
