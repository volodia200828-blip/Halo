<Window x:Class="Halo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Halo.App.Controls"
        Title="Halo — Центр керування"
        Height="720" Width="1100"
        MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#070A13"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI Variable, Segoe UI">

    <Window.Resources>
        <!-- Modern Cyberpunk Button Style -->
        <Style x:Key="CyberButton" TargetType="Button">
            <Setter Property="Background" Value="#131C2E" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#233044" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E293B" />
                    <Setter Property="BorderBrush" Value="#38BDF8" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Primary Accent Button -->
        <Style x:Key="AccentCyberButton" TargetType="Button" BasedOn="{StaticResource CyberButton}">
            <Setter Property="Background" Value="#0284C7" />
            <Setter Property="BorderBrush" Value="#38BDF8" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0369A1" />
                    <Setter Property="BorderBrush" Value="#7DD3FC" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Sidebar Navigation RadioButton Style -->
        <Style x:Key="SidebarNavStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="NavBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#10192A" />
                                <Setter Property="Foreground" Value="#F8FAFC" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#13233D" />
                                <Setter Property="Foreground" Value="#38BDF8" />
                                <Setter TargetName="NavBorder" Property="BorderBrush" Value="#1D4ED8" />
                                <Setter TargetName="NavBorder" Property="BorderThickness" Value="1,0,0,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Switch Style -->
        <Style x:Key="CyberToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="42" Height="22">
                                <Border x:Name="Track"
                                        CornerRadius="11"
                                        Background="#1E293B"
                                        BorderBrush="#334155"
                                        BorderThickness="1" />
                                <Ellipse x:Name="Thumb"
                                         Width="16" Height="16"
                                         Fill="#94A3B8"
                                         HorizontalAlignment="Left"
                                         Margin="3,0,0,0" />
                            </Grid>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#0284C7" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="#38BDF8" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Keycap Capsule Style -->
        <Style x:Key="KeycapStyle" TargetType="Border">
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="#38BDF8" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" Color="#38BDF8" Opacity="0.3" ShadowDepth="0" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================================== -->
        <!-- LEFT SIDEBAR (НАВІГАЦІЯ)                       -->
        <!-- ============================================== -->
        <Border Grid.Column="0" Background="#0A0E1A" BorderBrush="#182234" BorderThickness="0,0,1,0" Padding="14,18">
            <DockPanel>
                <!-- Brand Top -->
                <StackPanel DockPanel.Dock="Top" Margin="4,4,4,22">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Glowing Neon Logo -->
                        <Border Width="38" Height="38" CornerRadius="19" Background="#0F1B2E" BorderBrush="#38BDF8" BorderThickness="2" Margin="0,0,10,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Color="#00E5FF" Opacity="0.7" ShadowDepth="0" />
                            </Border.Effect>
                            <TextBlock Text="⭕" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Halo" FontSize="22" FontWeight="Bold" Foreground="#38BDF8" />
                            <TextBlock Text="CORE SYSTEM" FontSize="9" FontWeight="Bold" Foreground="#64748B" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Footer (Support & Version) -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                    <Button Style="{StaticResource CyberButton}" Padding="8,8" Margin="0,0,0,8" Click="BtnSupport_Click" Background="#111827">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="❤️" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Підтримати проєкт" FontSize="11" Foreground="#F43F5E" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Версія 1.0.0" FontSize="10" Foreground="#475569" TextAlignment="Center" />
                </StackPanel>

                <!-- Navigation List -->
                <StackPanel>
                    <RadioButton x:Name="NavMain" Content="⚡  Головна" Style="{StaticResource SidebarNavStyle}" IsChecked="True" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavInput" Content="⌨️  Жести й клавіші" Style="{StaticResource SidebarNavStyle}" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavRadial" Content="🎯  Кругові меню" Style="{StaticResource SidebarNavStyle}" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavPresets" Content="🗂️  Шаблони" Style="{StaticResource SidebarNavStyle}" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavFolders" Content="📂  Відстеження папок" Style="{StaticResource SidebarNavStyle}" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavSettings" Content="⚙️  Налаштування" Style="{StaticResource SidebarNavStyle}" Checked="Nav_Checked" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================================== -->
        <!-- RIGHT MAIN WORKSPACE (ОСНОВНА ОБЛАСТЬ)         -->
        <!-- ============================================== -->
        <Grid Grid.Column="1" Margin="28,20">

            <!-- ============================================== -->
            <!-- SCREEN 1: "ГОЛОВНА" (ЦЕНТР КЕРУВАННЯ)          -->
            <!-- ============================================== -->
            <Grid x:Name="ScreenMain" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- А. Верхня панель -->
                <DockPanel Grid.Row="0" Margin="0,0,0,22">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="Halo" FontSize="26" FontWeight="Bold" Foreground="#38BDF8" />
                            <TextBlock Text="Сучасна утиліта з інтерактивним круговим меню" FontSize="12.5" Foreground="#94A3B8" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="📌  Поличка" Style="{StaticResource CyberButton}" Margin="0,0,10,0" Click="BtnOpenShelf_Click" />
                        <Button Content="⚙️  Налаштування" Style="{StaticResource AccentCyberButton}" Click="BtnOpenSettingsScreen_Click" />
                    </StackPanel>
                </DockPanel>

                <!-- Б. Інформаційні картки (Три в один ряд) -->
                <Grid Grid.Row="1" Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Картка 1: Глобальний хоткей -->
                    <Border Grid.Column="0" Background="#111827" CornerRadius="12" Padding="18,16" Margin="0,0,9,0" BorderBrush="#1F2937" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Color="#00E5FF" Opacity="0.12" ShadowDepth="2" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="ГЛОБАЛЬНИЙ ХОТКЕЙ" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                            <TextBlock x:Name="MainHotkeyText" Text="Alt+Space" FontSize="22" FontWeight="Bold" Foreground="#38BDF8" Margin="0,6,0,3" />
                            <TextBlock Text="Працює у будь-якій програмі" FontSize="11.5" Foreground="#94A3B8" />
                        </StackPanel>
                    </Border>

                    <!-- Картка 2: Активні функції -->
                    <Border Grid.Column="1" Background="#111827" CornerRadius="12" Padding="18,16" Margin="4,0,4,0" BorderBrush="#1F2937" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Color="#10B981" Opacity="0.12" ShadowDepth="2" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="АКТИВНІ ФУНКЦІЇ" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                            <TextBlock x:Name="MainActiveActionsText" Text="12 функцій" FontSize="22" FontWeight="Bold" Foreground="#10B981" Margin="0,6,0,3" />
                            <TextBlock Text="Повністю кастомізуються" FontSize="11.5" Foreground="#94A3B8" />
                        </StackPanel>
                    </Border>

                    <!-- Картка 3: Гарячі папки -->
                    <Border Grid.Column="2" Background="#111827" CornerRadius="12" Padding="18,16" Margin="9,0,0,0" BorderBrush="#1F2937" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Color="#A855F7" Opacity="0.12" ShadowDepth="2" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="ГАРЯЧІ ПАПКИ" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                            <TextBlock x:Name="MainWatchedFoldersText" Text="0 правил" FontSize="22" FontWeight="Bold" Foreground="#C084FC" Margin="0,6,0,3" />
                            <TextBlock Text="Фонова обробка" FontSize="11.5" Foreground="#94A3B8" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- В. Тестова зона (Велика інтерактивна область) -->
                <Border Grid.Row="2" Background="#0C1322" CornerRadius="14" BorderBrush="#203047" BorderThickness="1.5"
                        AllowDrop="True" Drop="DropZone_Drop" DragOver="DropZone_DragOver" Margin="0,0,0,18">
                    <Grid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Target Icon -->
                            <Border Width="64" Height="64" CornerRadius="32" Background="#132035" BorderBrush="#38BDF8" BorderThickness="2"
                                    HorizontalAlignment="Center" Margin="0,0,0,14">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" Color="#38BDF8" Opacity="0.4" ShadowDepth="0" />
                                </Border.Effect>
                                <TextBlock Text="🎯" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <TextBlock Text="Тестова зона: Перетягніть сюди будь-який файл" FontSize="17" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" />
                            <TextBlock Text="Зображення (PNG, JPG, WebP), документ або будь-який файл — щоб побачити радіальне меню"
                                       FontSize="12.5" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,6,0,20" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="Вибрати файл для тесту..." Style="{StaticResource CyberButton}" Margin="0,0,12,0" Click="BtnPickFile_Click" />
                                <Button Content="⭕ Відкрити меню Halo тут" Style="{StaticResource AccentCyberButton}" Click="BtnOpenHaloHere_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Г. Нижній рядок (Підвал) -->
                <DockPanel Grid.Row="3">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💡" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Порада: Виділіть файл у Windows Explorer та натисніть Alt + Space — Halo з'явиться поруч із курсором."
                                   FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Grid>

            <!-- ============================================== -->
            <!-- SCREEN 2: "ЖЕСТИ Й КЛАВІШІ"                    -->
            <!-- ============================================== -->
            <Grid x:Name="ScreenInput" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="800" HorizontalAlignment="Left">
                        <TextBlock Text="Жести й клавіші" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC" />
                        <TextBlock Text="Налаштування глобальних комбінацій клавіш та жестів миші для виклику Halo."
                                   FontSize="13" Foreground="#94A3B8" Margin="0,4,0,20" />

                        <!-- Pause Gestures Toggle Banner -->
                        <Border Background="#131C2E" CornerRadius="12" Padding="18,14" Margin="0,0,0,18" BorderBrush="#233044" BorderThickness="1">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="Призупинити жести та гарячі клавіші" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC" />
                                    <TextBlock Text="Тимчасово вимикає реакцію на перетягування та хоткеї під час ігор або роботи" FontSize="11.5" Foreground="#94A3B8" />
                                </StackPanel>
                                <CheckBox x:Name="CheckPauseGestures" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                          Style="{StaticResource CyberToggleSwitch}" Click="CheckPauseGestures_Click" />
                            </DockPanel>
                        </Border>

                        <!-- Keycap Cards Section -->
                        <Border Background="#111827" CornerRadius="12" Padding="20" Margin="0,0,0,18" BorderBrush="#1F2937" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Головний системний тригер (Хоткей виклику)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Visual Keycaps row -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Style="{StaticResource KeycapStyle}">
                                            <TextBlock Text="ALT" FontWeight="Bold" Foreground="#38BDF8" FontSize="13" />
                                        </Border>
                                        <TextBlock Text="+" FontSize="16" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" Margin="2,0" />
                                        <Border Style="{StaticResource KeycapStyle}">
                                            <TextBlock Text="SPACE" FontWeight="Bold" Foreground="#38BDF8" FontSize="13" />
                                        </Border>
                                        <TextBlock Text="(поточна комбінація)" FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    </StackPanel>

                                    <Button Grid.Column="1" Content="Змінити хоткей" Style="{StaticResource CyberButton}" Click="BtnChangeHotkey_Click" />
                                </Grid>

                                <Separator Background="#1E293B" Margin="0,8,0,16" />

                                <!-- Mouse Gestures -->
                                <TextBlock Text="Жести миші" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />
                                <StackPanel>
                                    <DockPanel Margin="0,6">
                                        <StackPanel DockPanel.Dock="Left">
                                            <TextBlock Text="Струшування мишею при перетягуванні файлу" FontSize="13" Foreground="#E2E8F0" />
                                            <TextBlock Text="Струсіть файл вліво-вправо для відкриття Halo" FontSize="11" Foreground="#64748B" />
                                        </StackPanel>
                                        <CheckBox IsChecked="True" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource CyberToggleSwitch}" />
                                    </DockPanel>
                                    <DockPanel Margin="0,8">
                                        <StackPanel DockPanel.Dock="Left">
                                            <TextBlock Text="Затискання середньої кнопки миші (Коліщатко)" FontSize="13" Foreground="#E2E8F0" />
                                            <TextBlock Text="Виклик над активним файлом у Провіднику" FontSize="11" Foreground="#64748B" />
                                        </StackPanel>
                                        <CheckBox IsChecked="True" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource CyberToggleSwitch}" />
                                    </DockPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ============================================== -->
            <!-- SCREEN 3: "КРУГОВІ МЕНЮ" (3 КОЛОНКИ)           -->
            <!-- ============================================== -->
            <Grid x:Name="ScreenRadial" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="Кругові меню" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC" />
                    <TextBlock Text="Налаштування секторів кругового меню для кожного типу файлів з інтерактивним диском."
                               FontSize="13" Foreground="#94A3B8" Margin="0,2,0,0" />
                </StackPanel>

                <!-- 3 Columns Layout -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="310" />
                    </Grid.ColumnDefinitions>

                    <!-- Колонка 1 (Ліва): Список типів файлів -->
                    <Border Grid.Column="0" Background="#111827" CornerRadius="12" Padding="10" Margin="0,0,10,0" BorderBrush="#1F2937" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="ТИПИ ФАЙЛІВ" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="6,4,6,10" />
                            <ListBox x:Name="RadialCategoriesList" Background="Transparent" BorderThickness="0" SelectionChanged="RadialCategoriesList_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="8" Padding="10,8" Margin="0,2" Cursor="Hand">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#1E293B" />
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#172234" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <!-- Categories -->
                                <ListBoxItem IsSelected="True" Tag="Image">
                                    <DockPanel Width="180">
                                        <TextBlock Text="🖼️  Зображення" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                                        <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="#0C4A6E" CornerRadius="10" Padding="8,2">
                                            <TextBlock x:Name="BadgeImageCount" Text="6/8" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" />
                                        </Border>
                                    </DockPanel>
                                </ListBoxItem>

                                <ListBoxItem Tag="Document">
                                    <DockPanel Width="180">
                                        <TextBlock Text="📄  PDF / Документи" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                                        <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="#14532D" CornerRadius="10" Padding="8,2">
                                            <TextBlock x:Name="BadgeDocCount" Text="4/8" FontSize="11" FontWeight="Bold" Foreground="#34D399" />
                                        </Border>
                                    </DockPanel>
                                </ListBoxItem>

                                <ListBoxItem Tag="Video">
                                    <DockPanel Width="180">
                                        <TextBlock Text="🎬  Відео" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                                        <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="#581C87" CornerRadius="10" Padding="8,2">
                                            <TextBlock x:Name="BadgeVideoCount" Text="3/8" FontSize="11" FontWeight="Bold" Foreground="#C084FC" />
                                        </Border>
                                    </DockPanel>
                                </ListBoxItem>

                                <ListBoxItem Tag="Audio">
                                    <DockPanel Width="180">
                                        <TextBlock Text="🎵  Аудіо" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                                        <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="#701A75" CornerRadius="10" Padding="8,2">
                                            <TextBlock x:Name="BadgeAudioCount" Text="2/8" FontSize="11" FontWeight="Bold" Foreground="#F472B6" />
                                        </Border>
                                    </DockPanel>
                                </ListBoxItem>

                                <ListBoxItem Tag="Generic">
                                    <DockPanel Width="180">
                                        <TextBlock Text="📦  Будь-які файли" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                                        <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="#1E293B" CornerRadius="10" Padding="8,2">
                                            <TextBlock x:Name="BadgeGenericCount" Text="5/8" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                                        </Border>
                                    </DockPanel>
                                </ListBoxItem>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- Колонка 2 (Центральна): Інтерактивний круговий диск -->
                    <Border Grid.Column="1" Background="#0C1322" CornerRadius="12" Margin="0,0,10,0" BorderBrush="#1F2937" BorderThickness="1">
                        <Grid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="ЖИВИЙ ПРЕВ'Ю-ДИСК" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                <controls:RadialDiscControl x:Name="PreviewRadialDisc" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Колонка 3 (Права): Список дій для обраного типу -->
                    <Border Grid.Column="2" Background="#111827" CornerRadius="12" Padding="12" BorderBrush="#1F2937" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="ДОСТУПНІ СЕКТОРИ" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="4,4,4,10" />

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="RadialActionsItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#162032" CornerRadius="8" Padding="10,8" Margin="0,0,0,6" BorderBrush="#203046" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding IconKey}" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="#F8FAFC" />
                                                        <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis" MaxWidth="140" />
                                                    </StackPanel>

                                                    <!-- Star Favorite Button -->
                                                    <Button Grid.Column="2" Content="⭐" Width="24" Height="24" Padding="0" Background="Transparent"
                                                            BorderBrush="Transparent" Margin="2,0" Cursor="Hand" ToolTip="Додати в обране" />

                                                    <!-- Toggle -->
                                                    <CheckBox Grid.Column="3" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                              Style="{StaticResource CyberToggleSwitch}" Click="RadialActionToggle_Click" Tag="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ============================================== -->
            <!-- SCREEN 4: "ШАБЛОНИ" (ПРЕСЕТИ)                  -->
            <!-- ============================================== -->
            <Grid x:Name="ScreenPresets" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,18">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Шаблони та макроси" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC" />
                        <TextBlock Text="Комплексні ланцюжки дій із налаштуваннями розмірів, компресії та форматів."
                                   FontSize="13" Foreground="#94A3B8" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="➕  Новий шаблон"
                            Style="{StaticResource AccentCyberButton}" Click="BtnCreatePreset_Click" />
                </DockPanel>

                <!-- Presets Grid / Cards -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="PresetsWrapPanel" Orientation="Horizontal">
                        <!-- Preset Card 1 -->
                        <Border Width="260" Height="140" Background="#111827" CornerRadius="12" Padding="16" Margin="0,0,14,14" BorderBrush="#1F2937" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Color="#0284C7" Opacity="0.15" ShadowDepth="2" />
                            </Border.Effect>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top">
                                    <DockPanel>
                                        <TextBlock Text="🌐 Для інтернету 1920px" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" />
                                        <Border DockPanel.Dock="Right" Background="#0C4A6E" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="JPG/WebP" FontSize="9" FontWeight="Bold" Foreground="#7DD3FC" />
                                        </Border>
                                    </DockPanel>
                                    <TextBlock Text="Ресайз до 1920px, якість 80%, очищення метаданих EXIF" FontSize="11" Foreground="#94A3B8" Margin="0,8,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Тестувати" Style="{StaticResource CyberButton}" Padding="8,4" FontSize="11" Margin="0,0,6,0" />
                                    <Button Content="⚙️" Style="{StaticResource CyberButton}" Padding="6,4" FontSize="11" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Preset Card 2 -->
                        <Border Width="260" Height="140" Background="#111827" CornerRadius="12" Padding="16" Margin="0,0,14,14" BorderBrush="#1F2937" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Color="#10B981" Opacity="0.15" ShadowDepth="2" />
                            </Border.Effect>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top">
                                    <DockPanel>
                                        <TextBlock Text="🖤 Монохром-архів" FontSize="14" FontWeight="Bold" Foreground="#34D399" />
                                        <Border DockPanel.Dock="Right" Background="#064E3B" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="B&amp;W" FontSize="9" FontWeight="Bold" Foreground="#6EE7B7" />
                                        </Border>
                                    </DockPanel>
                                    <TextBlock Text="Чорно-білий фільтр високого контрасту + стиснення без втрат" FontSize="11" Foreground="#94A3B8" Margin="0,8,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Тестувати" Style="{StaticResource CyberButton}" Padding="8,4" FontSize="11" Margin="0,0,6,0" />
                                    <Button Content="⚙️" Style="{StaticResource CyberButton}" Padding="6,4" FontSize="11" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Preset Card 3 -->
                        <Border Width="260" Height="140" Background="#111827" CornerRadius="12" Padding="16" Margin="0,0,14,14" BorderBrush="#1F2937" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Color="#A855F7" Opacity="0.15" ShadowDepth="2" />
                            </Border.Effect>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top">
                                    <DockPanel>
                                        <TextBlock Text="⚡ Ультра-WebP" FontSize="14" FontWeight="Bold" Foreground="#C084FC" />
                                        <Border DockPanel.Dock="Right" Background="#581C87" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="WebP" FontSize="9" FontWeight="Bold" Foreground="#E9D5FF" />
                                        </Border>
                                    </DockPanel>
                                    <TextBlock Text="Миттєве стиснення зображень до 75% з копіюванням результату в буфер" FontSize="11" Foreground="#94A3B8" Margin="0,8,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Тестувати" Style="{StaticResource CyberButton}" Padding="8,4" FontSize="11" Margin="0,0,6,0" />
                                    <Button Content="⚙️" Style="{StaticResource CyberButton}" Padding="6,4" FontSize="11" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </WrapPanel>
                </ScrollViewer>
            </Grid>

            <!-- ============================================== -->
            <!-- SCREEN 5: "ВІДСТЕЖЕННЯ ПАПОК"                  -->
            <!-- ============================================== -->
            <Grid x:Name="ScreenFolders" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel DockPanel.Dock="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Відстеження папок" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC" />
                            <Border Background="#064E3B" CornerRadius="8" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,4,0" />
                                    <TextBlock Text="Моніторинг активний" FontSize="10.5" FontWeight="Bold" Foreground="#6EE7B7" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Halo відстежує нові файли у каталогах та тихо виконує призначені дії у фоні."
                                   FontSize="13" Foreground="#94A3B8" Margin="0,2,0,0" />
                    </StackPanel>

                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="➕  Додати папку"
                            Style="{StaticResource AccentCyberButton}" Click="BtnAddFolder_Click" />
                </DockPanel>

                <!-- Quick rule adder banner -->
                <Border Grid.Row="1" Background="#111827" CornerRadius="12" Padding="14" Margin="0,0,0,16" BorderBrush="#1F2937" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="QuickFolderInput" Text="C:\Users\...\Downloads" Background="#0C1322" Foreground="#38BDF8"
                                 BorderBrush="#233044" Padding="10,8" Margin="0,0,10,0" FontSize="13" />
                        <ComboBox x:Name="QuickActionCombo" Grid.Column="1" Background="#0C1322" Foreground="Black" Margin="0,0,10,0" SelectedIndex="0" Padding="8">
                            <ComboBoxItem Content="Конвертувати у WebP" Tag="image_to_webp" />
                            <ComboBoxItem Content="Конвертувати у PNG" Tag="image_to_png" />
                            <ComboBoxItem Content="Стиснути зображення" Tag="image_compress" />
                            <ComboBoxItem Content="Чорно-білий фільтр" Tag="image_grayscale" />
                        </ComboBox>
                        <Button Grid.Column="2" Content="Створити правило" Style="{StaticResource AccentCyberButton}" Click="BtnQuickAddRule_Click" />
                    </Grid>
                </Border>

                <!-- Rules list -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="FoldersRulesItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#111827" CornerRadius="10" Padding="14,12" Margin="0,0,0,8" BorderBrush="#1F2937" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FolderPath}" FontSize="13.5" FontWeight="SemiBold" Foreground="#F8FAFC" />
                                            <TextBlock Text="{Binding AssignedActionId, StringFormat='Автоматична дія: {0}'}" FontSize="11.5" Foreground="#38BDF8" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Видалити" Style="{StaticResource CyberButton}" Margin="0,0,12,0" Padding="10,5"
                                                Tag="{Binding}" Click="BtnDeleteFolderRule_Click" />
                                        <CheckBox Grid.Column="2" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                  Style="{StaticResource CyberToggleSwitch}" Tag="{Binding}" Click="FolderRuleToggle_Click" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ============================================== -->
            <!-- SCREEN 6: "НАЛАШТУВАННЯ" (СИСТЕМНІ ОПЦІЇ)      -->
            <!-- ============================================== -->
            <Grid x:Name="ScreenSettings" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Text="Налаштування" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC" />
                        <TextBlock Text="Системні параметри, локалізація, збереження файлів та інтеграція в Windows."
                                   FontSize="13" Foreground="#94A3B8" Margin="0,4,0,20" />

                        <!-- Card 1: Language & Theme -->
                        <Border Background="#111827" CornerRadius="12" Padding="20" Margin="0,0,0,16" BorderBrush="#1F2937" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Мова інтерфейсу:" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ComboBox x:Name="LanguageCombo" Width="240" HorizontalAlignment="Left" Background="#0C1322" Foreground="Black" SelectedIndex="0" Padding="8">
                                    <ComboBoxItem Content="Українська (Основна)" />
                                    <ComboBoxItem Content="English" />
                                </ComboBox>

                                <Separator Background="#1E293B" Margin="0,16" />

                                <TextBlock Text="Тема оформлення:" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ComboBox x:Name="GeneralThemeCombo" Width="240" HorizontalAlignment="Left" Background="#0C1322" Foreground="Black"
                                          SelectedIndex="0" Padding="8" SelectionChanged="GeneralThemeCombo_SelectionChanged">
                                    <ComboBoxItem Content="Темна кіберпанк (Рекомендовано)" />
                                    <ComboBoxItem Content="Світла неонова" />
                                    <ComboBoxItem Content="Системна" />
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Output Path Strategy -->
                        <Border Background="#111827" CornerRadius="12" Padding="20" Margin="0,0,0,16" BorderBrush="#1F2937" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Шлях збереження оброблених файлів:" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,10,0" />
                                <RadioButton Content="Поруч з оригінальним файлом (з суфіксом)" IsChecked="True" Foreground="#E2E8F0" Margin="0,10,0,6" />
                                <RadioButton Content="В окрему папку «Halo Exports»" Foreground="#E2E8F0" Margin="0,4" />
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Windows Integration -->
                        <Border Background="#111827" CornerRadius="12" Padding="20" BorderBrush="#1F2937" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Системні опції:" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,10" />

                                <DockPanel Margin="0,6">
                                    <TextBlock Text="Автозапуск разом із Windows" FontSize="13" Foreground="#E2E8F0" />
                                    <CheckBox IsChecked="True" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource CyberToggleSwitch}" />
                                </DockPanel>

                                <DockPanel Margin="0,10">
                                    <TextBlock Text="Інтеграція в контекстне меню Провідника («Відкрити в Halo»)" FontSize="13" Foreground="#E2E8F0" />
                                    <CheckBox IsChecked="True" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource CyberToggleSwitch}" />
                                </DockPanel>

                                <DockPanel Margin="0,6">
                                    <TextBlock Text="Апаратне прискорення GPU для анімацій меню" FontSize="13" Foreground="#E2E8F0" />
                                    <CheckBox IsChecked="True" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource CyberToggleSwitch}" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
