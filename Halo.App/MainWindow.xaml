<Window x:Class="Halo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Halo.App.Controls"
        Title="Halo"
        Height="760" Width="1180"
        MinHeight="660" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Foreground="{DynamicResource OrbitTextPrimary}"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="10">
        <!-- Фоновий шар тіні вікна (Окремий від контенту, щоб текст не розмивався!) -->
        <Border Background="{DynamicResource OrbitWindowBgBrush}"
                CornerRadius="18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="5" Direction="270" Color="#000000" Opacity="0.55" />
            </Border.Effect>
        </Border>

        <!-- Основний чіткий контейнер вікна (Без Effect, ідеальна чіткість ClearType!) -->
        <Border Background="{DynamicResource OrbitWindowBgBrush}"
                BorderBrush="{DynamicResource OrbitSubtleBorderBrush}"
                BorderThickness="1"
                CornerRadius="18"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ================================================================= -->
                <!-- 1. ЛІВИЙ САЙДБАР (ВІЗУАЛЬНО ВІДДІЛЕНИЙ, СТИЛЬ "ORBIT")            -->
                <!-- ================================================================= -->
                <Border Grid.Column="0"
                        Background="{DynamicResource OrbitSidebarBgBrush}"
                        BorderBrush="{DynamicResource OrbitSidebarDividerBrush}"
                        BorderThickness="0,0,1,0"
                        CornerRadius="18,0,0,18"
                        Padding="20,24">
                    <DockPanel>
                        <!-- Логотип зверху зліва -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,2,4,32" MouseDown="TitleBar_MouseDown" Background="Transparent">
                            <Grid Width="44" Height="44" Margin="0,0,14,0">
                                <Border CornerRadius="13" Background="#222030" Effect="{StaticResource OrbitPurpleGlow}" />
                                <Border CornerRadius="13" Background="#222030" BorderBrush="#463A6E" BorderThickness="1">
                                    <Ellipse Width="22" Height="22" Stroke="{StaticResource OrbitLogoGradient}" StrokeThickness="3.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Halo" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" />
                                <TextBlock x:Name="TxtSidebarSubtitle" Text="Робочий простір" FontSize="11.5" Foreground="{DynamicResource OrbitTextMuted}" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Нижня міні-картка статусу фонового сервісу -->
                        <Border DockPanel.Dock="Bottom"
                                Background="{DynamicResource OrbitCardBgBrush}"
                                BorderBrush="{DynamicResource OrbitCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="16,14"
                                Margin="0,16,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Ellipse x:Name="SidebarStatusDot" Width="8" Height="8" Fill="{StaticResource OrbitGreenLightBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock x:Name="TxtSidebarServiceStatus" Text="Служба активна" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource OrbitTextPrimary}" />
                                </StackPanel>
                                <DockPanel>
                                    <TextBlock x:Name="TxtSidebarTriggerLabel" Text="Тригер:" FontSize="11.5" Foreground="{DynamicResource OrbitTextMuted}" VerticalAlignment="Center" />
                                    <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="{StaticResource OrbitPurpleSoftBg}" CornerRadius="6" Padding="8,2">
                                        <TextBlock x:Name="SidebarHotkeyBadge" Text="Alt+Space" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource OrbitPurpleLightBrush}" />
                                    </Border>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Меню навігації (5 вкладок, без вкладки Шаблони) -->
                        <StackPanel>
                            <TextBlock x:Name="TxtSidebarMenuHeader" Text="МЕНЮ" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource OrbitTextMuted}" Margin="10,0,0,8" />

                            <RadioButton x:Name="NavMain" Style="{StaticResource OrbitSidebarItemStyle}" IsChecked="True" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource OrbitIconDashboard}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.8" Width="17" Height="17" Stretch="Uniform" Margin="0,0,13,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtNavMain" Text="Головна" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavRadial" Style="{StaticResource OrbitSidebarItemStyle}" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource OrbitIconRadial}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.8" Width="17" Height="17" Stretch="Uniform" Margin="0,0,13,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtNavRadial" Text="Кругові меню" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavInput" Style="{StaticResource OrbitSidebarItemStyle}" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource OrbitIconKeys}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.8" Width="17" Height="17" Stretch="Uniform" Margin="0,0,13,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtNavInput" Text="Жести й клавіші" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavFolders" Style="{StaticResource OrbitSidebarItemStyle}" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource OrbitIconFolders}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.8" Width="17" Height="17" Stretch="Uniform" Margin="0,0,13,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtNavFolders" Text="Відстеження папок" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavSettings" Style="{StaticResource OrbitSidebarItemStyle}" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource OrbitIconSettings}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.7" StrokeLineJoin="Round" Width="18" Height="18" Stretch="Uniform" Margin="0,0,13,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtNavSettings" Text="Налаштування" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ================================================================= -->
                <!-- 2. ПРАВА ОСНОВНА РОБОЧА ОБЛАСТЬ (КАРТКОВИЙ ІНТЕРФЕЙС "ORBIT")     -->
                <!-- ================================================================= -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- ВЕРХНЯ ПАНЕЛЬ (Без кнопки Полички) -->
                    <Border Grid.Row="0" Background="Transparent" Padding="32,22,24,14" MouseDown="TitleBar_MouseDown">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock x:Name="PageHeaderTitle" Text="Головна" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" />
                                <TextBlock x:Name="PageHeaderSubtitle" Text="Огляд активних інструментів, швидких дій та стану робочого простору" FontSize="13" Foreground="{DynamicResource OrbitTextSecondary}" Margin="0,3,0,0" />
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Button x:Name="BtnHeaderOpenHalo" Content="✦  Відкрити Halo" Style="{StaticResource OrbitPrimaryButton}" Margin="0,0,16,0" Click="BtnOpenHaloHere_Click" />

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource OrbitWindowCapBtn}" Click="BtnMinimize_Click" ToolTip="Згорнути">
                                        <Path Data="{StaticResource OrbitIconMinimize}" Stroke="{DynamicResource OrbitTextSecondary}" StrokeThickness="1.8" Width="11" Height="11" Stretch="Uniform" />
                                    </Button>
                                    <Button Style="{StaticResource OrbitWindowCloseBtn}" Click="BtnClose_Click" Margin="4,0,0,0" ToolTip="Закрити">
                                        <Path Data="{StaticResource OrbitIconClose}" Stroke="{DynamicResource OrbitTextSecondary}" StrokeThickness="1.8" Width="11" Height="11" Stretch="Uniform" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- КОНТЕНТ СТОРІНОК -->
                    <Grid Grid.Row="1" Margin="32,8,32,26">

                        <!-- ========================================================= -->
                        <!-- ЕКРАН 1: "ГОЛОВНА" (ДАШБОРД У СТИЛІ "ORBIT")              -->
                        <!-- ========================================================= -->
                        <Grid x:Name="ScreenMain" Visibility="Visible">
                            <Grid.RenderTransform>
                                <TranslateTransform X="0" Y="0" />
                            </Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- РЯД 1: 4 ІНТЕРАКТИВНІ КАРТКИ ПОКАЗНИКІВ З АНІМАЦІЄЮ ПЕРЕХОДУ -->
                            <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,20">
                                <!-- Картка 1: Активні сектори -> Кругові меню -->
                                <Border Style="{StaticResource OrbitInteractiveCardStyle}" Margin="0,0,8,0" Padding="18,16" MouseLeftButtonDown="BtnJumpToRadial_Click">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock x:Name="TxtMetric1Title" Text="Активні дії" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource OrbitTextSecondary}" VerticalAlignment="Center" />
                                            <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Width="34" Height="34" CornerRadius="10" Background="{StaticResource OrbitPurpleSoftBg}">
                                                <TextBlock Text="🎯" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </DockPanel>
                                        <TextBlock x:Name="StatActiveActions" Text="11" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" />
                                        <TextBlock x:Name="TxtMetric1Sub" Text="Налаштувати сектори →" FontSize="11.5" Foreground="{StaticResource OrbitPurpleLightBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Картка 2: Глобальний тригер -> Жести й клавіші -->
                                <Border Style="{StaticResource OrbitInteractiveCardStyle}" Margin="4,0,4,0" Padding="18,16" MouseLeftButtonDown="BtnJumpToInput_Click">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock x:Name="TxtMetric2Title" Text="Швидкий виклик" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource OrbitTextSecondary}" VerticalAlignment="Center" />
                                            <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Width="34" Height="34" CornerRadius="10" Background="{StaticResource OrbitBlueSoftBg}">
                                                <TextBlock Text="⌨️" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </DockPanel>
                                        <TextBlock x:Name="StatGlobalHotkey" Text="Alt+Space" FontSize="22" FontWeight="Bold" Foreground="{StaticResource OrbitCyanBrush}" Margin="0,4,0,2" />
                                        <TextBlock x:Name="TxtMetric2Sub" Text="Жести та клавіші →" FontSize="11.5" Foreground="{DynamicResource OrbitTextSecondary}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Картка 3: Відстеження папок -> Відстеження папок -->
                                <Border Style="{StaticResource OrbitInteractiveCardStyle}" Margin="4,0,4,0" Padding="18,16" MouseLeftButtonDown="BtnJumpToFolders_Click">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock x:Name="TxtMetric3Title" Text="Автоматизація" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource OrbitTextSecondary}" VerticalAlignment="Center" />
                                            <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Width="34" Height="34" CornerRadius="10" Background="{StaticResource OrbitAmberSoftBg}">
                                                <TextBlock Text="📂" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </DockPanel>
                                        <TextBlock x:Name="StatWatchedFolders" Text="0" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" />
                                        <TextBlock x:Name="TxtMetric3Sub" Text="Відстеження папок →" FontSize="11.5" Foreground="{StaticResource OrbitAmberLightBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Картка 4: Оформлення і система -> Налаштування -->
                                <Border Style="{StaticResource OrbitInteractiveCardStyle}" Margin="8,0,0,0" Padding="18,16" MouseLeftButtonDown="BtnJumpToSettings_Click">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock x:Name="TxtMetric4Title" Text="Тема та система" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource OrbitTextSecondary}" VerticalAlignment="Center" />
                                            <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Width="34" Height="34" CornerRadius="10" Background="{StaticResource OrbitGreenSoftBg}">
                                                <TextBlock Text="🎨" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </DockPanel>
                                        <TextBlock x:Name="StatCurrentTheme" Text="Orbit" FontSize="24" FontWeight="Bold" Foreground="{StaticResource OrbitGreenLightBrush}" Margin="0,2,0,2" />
                                        <TextBlock x:Name="TxtMetric4Sub" Text="Відкрити налаштування →" FontSize="11.5" Foreground="{DynamicResource OrbitTextSecondary}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- РЯД 2: ДВОКОЛОНКОВА КАРТКОВА СІТКА -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.35*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <!-- Ліва колонка: Інтерактивний хаб + 2x2 Картки операцій -->
                                <Grid Grid.Column="0" Margin="0,0,10,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Головна інтерактивна картка (Без Effect на батьківському Border, кнопки чіткі і просторі) -->
                                    <Border Grid.Row="0"
                                            Background="{StaticResource OrbitHeroBannerGradient}"
                                            BorderBrush="#4A3C75"
                                            BorderThickness="1"
                                            CornerRadius="16"
                                            Padding="24,20"
                                            Margin="0,0,0,16"
                                            AllowDrop="True"
                                            Drop="DropZone_Drop"
                                            DragOver="DropZone_DragOver">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <Border Background="#3D3163" CornerRadius="8" Padding="10,4" HorizontalAlignment="Left" Margin="0,0,0,10">
                                                    <TextBlock x:Name="TxtHubBadge" Text="✦  ІНТЕРАКТИВНИЙ ХАБ" FontSize="10.5" FontWeight="Bold" Foreground="#C4B5FD" />
                                                </Border>
                                                <TextBlock x:Name="TxtHubTitle" Text="Миттєва робота з будь-яким файлом" FontSize="20" FontWeight="Bold" Foreground="#F2F3F7" />
                                                <TextBlock x:Name="TxtHubDesc" Text="Перетягніть сюди зображення, відео чи документ або оберіть файл з диска, щоб відкрити радіальне меню дій."
                                                           FontSize="12.5" Foreground="#B8BBE0" TextWrapping="Wrap" Margin="0,6,14,16" LineHeight="18" />

                                                <WrapPanel Orientation="Horizontal">
                                                    <Button x:Name="BtnHubPickFile" Content="📂  Вибрати файл..." Style="{StaticResource OrbitPrimaryButton}" Margin="0,0,10,6" Click="BtnPickFile_Click" />
                                                    <Button x:Name="BtnHubTestMenu" Content="◎  Тест кругового меню" Style="{StaticResource OrbitSecondaryButton}" Margin="0,0,0,6" Click="BtnOpenHaloHere_Click" />
                                                </WrapPanel>
                                            </StackPanel>

                                            <!-- Декоративне кільце Orbit справа -->
                                            <Border Grid.Column="1" Width="96" Height="96" CornerRadius="48" Background="#1D1A2E" BorderBrush="#4C3D7A" BorderThickness="1.5" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <Grid>
                                                    <Ellipse Width="64" Height="64" Stroke="{StaticResource OrbitLogoGradient}" StrokeThickness="3.5" Opacity="0.9" />
                                                    <TextBlock Text="◎" FontSize="24" FontWeight="Bold" Foreground="#A78BFA" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- 2x2 Картки популярних швидких операцій -->
                                    <UniformGrid Grid.Row="1" Columns="2" Rows="2">
                                        <Border Style="{StaticResource OrbitInteractiveCardStyle}" Padding="15,13" Margin="0,0,7,7" MouseLeftButtonDown="BtnPickFile_Click">
                                            <DockPanel>
                                                <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource OrbitBlueSoftBg}" Margin="0,0,12,0">
                                                    <TextBlock Text="🌐" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Конвертація у WebP" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource OrbitTextPrimary}" />
                                                    <TextBlock Text="Стиснення без втрати чіткості" FontSize="11" Foreground="{DynamicResource OrbitTextMuted}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>

                                        <Border Style="{StaticResource OrbitInteractiveCardStyle}" Padding="15,13" Margin="7,0,0,7" MouseLeftButtonDown="BtnPickFile_Click">
                                            <DockPanel>
                                                <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource OrbitPurpleSoftBg}" Margin="0,0,12,0">
                                                    <TextBlock Text="🖤" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Чорно-білий фільтр" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource OrbitTextPrimary}" />
                                                    <TextBlock Text="Монохромна обробка фото" FontSize="11" Foreground="{DynamicResource OrbitTextMuted}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>

                                        <Border Style="{StaticResource OrbitInteractiveCardStyle}" Padding="15,13" Margin="0,7,7,0" MouseLeftButtonDown="BtnPickFile_Click">
                                            <DockPanel>
                                                <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource OrbitGreenSoftBg}" Margin="0,0,12,0">
                                                    <TextBlock Text="📐" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Зменшити розмір 50%" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource OrbitTextPrimary}" />
                                                    <TextBlock Text="Швидке масштабування" FontSize="11" Foreground="{DynamicResource OrbitTextMuted}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>

                                        <Border Style="{StaticResource OrbitInteractiveCardStyle}" Padding="15,13" Margin="7,7,0,0" MouseLeftButtonDown="BtnPickFile_Click">
                                            <DockPanel>
                                                <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource OrbitRoseSoftBg}" Margin="0,0,12,0">
                                                    <TextBlock Text="📄" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Зберегти в PDF" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource OrbitTextPrimary}" />
                                                    <TextBlock Text="Документи та зображення" FontSize="11" Foreground="{DynamicResource OrbitTextMuted}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </UniformGrid>
                                </Grid>

                                <!-- Права колонка: Картка профілів секторів за категоріями -->
                                <Border Grid.Column="1" Style="{StaticResource OrbitCardStyle}" Margin="10,0,0,0" Padding="20">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock x:Name="TxtProfilesTitle" Text="Профілі кругового меню" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" />
                                                <TextBlock x:Name="TxtProfilesSub" Text="Наповнення секторів за типами файлів" FontSize="12" Foreground="{DynamicResource OrbitTextMuted}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="{StaticResource OrbitPurpleSoftBg}" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                                                <TextBlock Text="Активні" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource OrbitPurpleLightBrush}" />
                                            </Border>
                                        </DockPanel>

                                        <Button x:Name="BtnConfigureSectors" DockPanel.Dock="Bottom" Content="Налаштувати сектори меню →" Style="{StaticResource OrbitSecondaryButton}" HorizontalAlignment="Stretch" Click="BtnJumpToRadial_Click" Margin="0,10,0,0" />

                                        <StackPanel>
                                            <Border Background="{DynamicResource OrbitRecessedBgBrush}" CornerRadius="12" Padding="14,12" Margin="0,0,0,10" BorderBrush="{DynamicResource OrbitSubtleBorderBrush}" BorderThickness="1">
                                                <DockPanel>
                                                    <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource OrbitBlueSoftBg}" Margin="0,0,12,0">
                                                        <TextBlock Text="🖼️" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <Border DockPanel.Dock="Right" Background="{StaticResource OrbitBlueSoftBg}" CornerRadius="7" Padding="9,3" VerticalAlignment="Center">
                                                        <TextBlock Text="Зображення" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource OrbitCyanBrush}" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="Фото та графіка" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource OrbitTextPrimary}" />
                                                        <TextBlock Text="WebP, PNG, JPG, Ресайз, Ч/Б" FontSize="11" Foreground="{DynamicResource OrbitTextMuted}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>

                                            <Border Background="{DynamicResource OrbitRecessedBgBrush}" CornerRadius="12" Padding="14,12" Margin="0,0,0,10" BorderBrush="{DynamicResource OrbitSubtleBorderBrush}" BorderThickness="1">
                                                <DockPanel>
                                                    <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource OrbitGreenSoftBg}" Margin="0,0,12,0">
                                                        <TextBlock Text="📄" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <Border DockPanel.Dock="Right" Background="{StaticResource OrbitGreenSoftBg}" CornerRadius="7" Padding="9,3" VerticalAlignment="Center">
                                                        <TextBlock Text="Документи" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource OrbitGreenLightBrush}" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="Документи та PDF" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource OrbitTextPrimary}" />
                                                        <TextBlock Text="Конвертація в PDF, Копіювання шляху" FontSize="11" Foreground="{DynamicResource OrbitTextMuted}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>

                                            <Border Background="{DynamicResource OrbitRecessedBgBrush}" CornerRadius="12" Padding="14,12" Margin="0,0,0,4" BorderBrush="{DynamicResource OrbitSubtleBorderBrush}" BorderThickness="1">
                                                <DockPanel>
                                                    <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource OrbitPurpleSoftBg}" Margin="0,0,12,0">
                                                        <TextBlock Text="💻" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <Border DockPanel.Dock="Right" Background="{StaticResource OrbitPurpleSoftBg}" CornerRadius="7" Padding="9,3" VerticalAlignment="Center">
                                                        <TextBlock Text="Система" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource OrbitPurpleLightBrush}" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="Системні операції" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource OrbitTextPrimary}" />
                                                        <TextBlock Text="Термінал, Провідник, Буфер обміну" FontSize="11" Foreground="{DynamicResource OrbitTextMuted}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- ========================================================= -->
                        <!-- ЕКРАН 2: "КРУГОВІ МЕНЮ" (БЕЗ НАКЛАДАННЯ ТЕКСТУ Й КНОПОК)   -->
                        <!-- ========================================================= -->
                        <Grid x:Name="ScreenRadial" Visibility="Collapsed">
                            <Grid.RenderTransform>
                                <TranslateTransform X="0" Y="0" />
                            </Grid.RenderTransform>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="225" />
                                <ColumnDefinition Width="330" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Колонка 1: Картка категорій файлів (Гнучка сітка без фіксованої ширини!) -->
                            <Border Grid.Column="0" Style="{StaticResource OrbitCardStyle}" Padding="14" Margin="0,0,14,0">
                                <StackPanel>
                                    <TextBlock Text="КАТЕГОРІЇ ФАЙЛІВ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource OrbitTextMuted}" Margin="8,4,8,10" />
                                    <ListBox x:Name="RadialCategoriesList"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             HorizontalContentAlignment="Stretch"
                                             SelectionChanged="RadialCategoriesList_SelectionChanged">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="CatBorder" Background="Transparent" CornerRadius="11" Padding="12,10" Margin="0,3" Cursor="Hand" BorderBrush="Transparent" BorderThickness="1">
                                                                <ContentPresenter HorizontalAlignment="Stretch" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="CatBorder" Property="Background" Value="{DynamicResource OrbitCardHoverBgBrush}" />
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="CatBorder" Property="Background" Value="{StaticResource OrbitNavActiveBgGradient}" />
                                                                    <Setter TargetName="CatBorder" Property="BorderBrush" Value="#54428E" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>

                                        <ListBoxItem IsSelected="True" Tag="Image">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="🖼️  Зображення" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource OrbitTextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="1" Background="{StaticResource OrbitBlueSoftBg}" CornerRadius="7" Padding="7,2" Margin="6,0,0,0">
                                                    <TextBlock x:Name="BadgeImageCount" Text="10" FontSize="11" FontWeight="Bold" Foreground="{StaticResource OrbitCyanBrush}" />
                                                </Border>
                                            </Grid>
                                        </ListBoxItem>

                                        <ListBoxItem Tag="Document">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="📄  Документи" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource OrbitTextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="1" Background="{StaticResource OrbitGreenSoftBg}" CornerRadius="7" Padding="7,2" Margin="6,0,0,0">
                                                    <TextBlock x:Name="BadgeDocCount" Text="5" FontSize="11" FontWeight="Bold" Foreground="{StaticResource OrbitGreenLightBrush}" />
                                                </Border>
                                            </Grid>
                                        </ListBoxItem>

                                        <ListBoxItem Tag="Video">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="🎬  Відео" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource OrbitTextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="1" Background="{StaticResource OrbitPurpleSoftBg}" CornerRadius="7" Padding="7,2" Margin="6,0,0,0">
                                                    <TextBlock x:Name="BadgeVideoCount" Text="4" FontSize="11" FontWeight="Bold" Foreground="{StaticResource OrbitPurpleLightBrush}" />
                                                </Border>
                                            </Grid>
                                        </ListBoxItem>

                                        <ListBoxItem Tag="Audio">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="🎵  Аудіо" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource OrbitTextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="1" Background="{StaticResource OrbitAmberSoftBg}" CornerRadius="7" Padding="7,2" Margin="6,0,0,0">
                                                    <TextBlock x:Name="BadgeAudioCount" Text="4" FontSize="11" FontWeight="Bold" Foreground="{StaticResource OrbitAmberLightBrush}" />
                                                </Border>
                                            </Grid>
                                        </ListBoxItem>

                                        <ListBoxItem Tag="Generic">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="📦  Усі файли" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource OrbitTextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="1" Background="{DynamicResource OrbitRecessedBgBrush}" CornerRadius="7" Padding="7,2" Margin="6,0,0,0">
                                                    <TextBlock x:Name="BadgeGenericCount" Text="4" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource OrbitTextSecondary}" />
                                                </Border>
                                            </Grid>
                                        </ListBoxItem>
                                    </ListBox>
                                </StackPanel>
                            </Border>

                            <!-- Колонка 2: Інтерактивний диск у фіксованій пропорції -->
                            <Border Grid.Column="1" Style="{StaticResource OrbitCardStyle}" Padding="16" Margin="0,0,14,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="МАКЕТ РАДІАЛЬНОГО КОЛА" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource OrbitTextMuted}" HorizontalAlignment="Center" Margin="0,2,0,6" />
                                    <Viewbox Grid.Row="1" Stretch="Uniform" MaxWidth="295" MaxHeight="320" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <controls:RadialDiscControl x:Name="PreviewRadialDisc" />
                                    </Viewbox>
                                    <Button Grid.Row="2" Content="✦  Протестувати меню на екрані" Style="{StaticResource OrbitSecondaryButton}" HorizontalAlignment="Stretch" Margin="0,8,0,0" Click="BtnOpenHaloHere_Click" />
                                </Grid>
                            </Border>

                            <!-- Колонка 3: Картковий список секторів з компактними перемикачами (34x18) -->
                            <Border Grid.Column="2" Style="{StaticResource OrbitCardStyle}" Padding="18">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="2,0,4,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="СЕКТОРИ ОБРАНОЇ КАТЕГОРІЇ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource OrbitTextMuted}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="Вкл / Викл" FontSize="11" Foreground="{DynamicResource OrbitTextMuted}" VerticalAlignment="Center" />
                                    </Grid>

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="RadialActionsItemsControl">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource OrbitRecessedBgBrush}"
                                                            BorderBrush="{DynamicResource OrbitSubtleBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="12"
                                                            Padding="12,10"
                                                            Margin="0,0,8,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="9" Background="{DynamicResource OrbitCardBgBrush}" BorderBrush="{DynamicResource OrbitCardBorderBrush}" BorderThickness="1" Margin="0,0,12,0">
                                                                <TextBlock Text="{Binding IconKey}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>

                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource OrbitTextPrimary}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource OrbitTextMuted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                            </StackPanel>

                                                            <CheckBox Grid.Column="2"
                                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                      Style="{StaticResource OrbitToggleSwitch}"
                                                                      Click="RadialActionToggle_Click"
                                                                      Tag="{Binding}"
                                                                      VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ========================================================= -->
                        <!-- ЕКРАН 3: "ЖЕСТИ Й КЛАВІШІ" (З ХОТКЕЄМ ІГРОВОГО РЕЖИМУ Й СКИДАННЯМ) -->
                        <!-- ========================================================= -->
                        <Grid x:Name="ScreenInput" Visibility="Collapsed">
                            <Grid.RenderTransform>
                                <TranslateTransform X="0" Y="0" />
                            </Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <!-- Картка 1 (Ліва верхня): Комбінація виклику Halo -->
                            <Border x:Name="HotkeyRecorderCard" Grid.Row="0" Grid.Column="0" Style="{StaticResource OrbitCardStyle}" Margin="0,0,10,16" Padding="22,20">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,12">
                                        <Border Background="{StaticResource OrbitPurpleSoftBg}" CornerRadius="8" Padding="10,4">
                                            <TextBlock Text="⌨️  ОСНОВНИЙ ТРИГЕР" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource OrbitPurpleLightBrush}" />
                                        </Border>
                                        <TextBlock Text="Глобальне перехоплення" FontSize="11.5" Foreground="{DynamicResource OrbitTextMuted}" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </DockPanel>

                                    <TextBlock Text="Комбінація виклику Halo" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" />
                                    <TextBlock x:Name="HotkeyRecorderHint" Text="Натисніть кнопку запису нижче, а потім затисніть бажані клавіші на клавіатурі."
                                               FontSize="12.5" Foreground="{DynamicResource OrbitTextSecondary}" TextWrapping="Wrap" Margin="0,4,0,14" />

                                    <Border Background="{DynamicResource OrbitRecessedBgBrush}" BorderBrush="{DynamicResource OrbitCardBorderBrush}" BorderThickness="1.5" CornerRadius="12" Padding="16,12" Margin="0,0,0,14">
                                        <DockPanel>
                                            <TextBlock Text="Поточний хоткей:" FontSize="12.5" Foreground="{DynamicResource OrbitTextSecondary}" VerticalAlignment="Center" />
                                            <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="{StaticResource OrbitNavActiveBgGradient}" BorderBrush="#63539E" BorderThickness="1.5" CornerRadius="9" Padding="14,5">
                                                <TextBlock x:Name="HotkeyRecorderStatusText" Text="Alt+Space" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" />
                                            </Border>
                                        </DockPanel>
                                    </Border>

                                    <Button x:Name="BtnRecordHotkey" Content="⏺️  Записати комбінацію з клавіатури" Style="{StaticResource OrbitPrimaryButton}" HorizontalAlignment="Left" Click="BtnRecordHotkey_Click" />
                                </StackPanel>
                            </Border>

                            <!-- Картка 2 (Права верхня): Ігровий режим + комбінація клавіш для Ігрового режиму -->
                            <Border x:Name="GameModeRecorderCard" Grid.Row="0" Grid.Column="1" Style="{StaticResource OrbitCardStyle}" Margin="10,0,0,16" Padding="22,20">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource OrbitRoseSoftBg}" Margin="0,0,10,0">
                                                <TextBlock Text="🎮" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Ігровий режим (Тиша)" FontSize="16.5" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" />
                                                <TextBlock Text="Пауза всіх тригерів у іграх" FontSize="11.5" Foreground="{DynamicResource OrbitTextMuted}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <CheckBox x:Name="CheckPauseGestures" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource OrbitToggleSwitch}" Click="CheckPauseGestures_Click" />
                                    </DockPanel>

                                    <TextBlock x:Name="GameModeRecorderHint" Text="Ви можете вмикати та вимикати Ігровий режим будь-коли гарячою комбінацією клавіш:"
                                               FontSize="12" Foreground="{DynamicResource OrbitTextSecondary}" TextWrapping="Wrap" Margin="0,4,0,12" />

                                    <Border Background="{DynamicResource OrbitRecessedBgBrush}" BorderBrush="{DynamicResource OrbitCardBorderBrush}" BorderThickness="1.5" CornerRadius="12" Padding="14,10" Margin="0,0,0,14">
                                        <DockPanel>
                                            <TextBlock Text="Хоткей ігрового режиму:" FontSize="12" Foreground="{DynamicResource OrbitTextSecondary}" VerticalAlignment="Center" />
                                            <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="{StaticResource OrbitRoseSoftBg}" BorderBrush="#F43F5E" BorderThickness="1" CornerRadius="8" Padding="12,4">
                                                <TextBlock x:Name="GameModeHotkeyStatusText" Text="Alt+G" FontSize="14.5" FontWeight="Bold" Foreground="#FDA4AF" />
                                            </Border>
                                        </DockPanel>
                                    </Border>

                                    <Button x:Name="BtnRecordGameModeHotkey" Content="⏺️  Записати хоткей ігрового режиму" Style="{StaticResource OrbitSecondaryButton}" HorizontalAlignment="Left" Click="BtnRecordGameModeHotkey_Click" />
                                </StackPanel>
                            </Border>

                            <!-- Картка 3 (Ліва середня): Жест струшування (Shake) -->
                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource OrbitCardStyle}" Margin="0,0,10,16" Padding="20,18">
                                <DockPanel>
                                    <Border Width="42" Height="42" CornerRadius="11" Background="{StaticResource OrbitBlueSoftBg}" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="👋" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <CheckBox x:Name="ToggleShakeGesture" IsChecked="True" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource OrbitToggleSwitch}" VerticalAlignment="Center" Click="ToggleShakeGesture_Click" />
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="Струшування мишею (Shake)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" />
                                        <TextBlock Text="Швидко потрусіть курсор вліво-вправо, щоб викликати радіальне меню для файлу" FontSize="12" Foreground="{DynamicResource OrbitTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Картка 4 (Права середня): Середня кнопка миші -->
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource OrbitCardStyle}" Margin="10,0,0,16" Padding="20,18">
                                <DockPanel>
                                    <Border Width="42" Height="42" CornerRadius="11" Background="{StaticResource OrbitGreenSoftBg}" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="🖱️" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <CheckBox x:Name="ToggleMiddleMouse" IsChecked="True" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource OrbitToggleSwitch}" VerticalAlignment="Center" Click="ToggleMiddleMouse_Click" />
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="Клік коліщатком миші" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" />
                                        <TextBlock Text="Виклик радіального меню натисканням середньої кнопки миші" FontSize="12" Foreground="{DynamicResource OrbitTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Картка 5 (Нижня панель скидання до стандартних налаштувань) -->
                            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource OrbitCardStyle}" Padding="20,14">
                                <DockPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Скидання налаштувань керування" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" />
                                        <TextBlock Text="Повернути стандартні комбінації (Alt+Space та Alt+G) і увімкнути всі жести миші" FontSize="12" Foreground="{DynamicResource OrbitTextMuted}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="↺  Скинути до стандартних налаштувань" Style="{StaticResource OrbitSecondaryButton}" Click="BtnResetTriggers_Click" />
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- ========================================================= -->
                        <!-- ЕКРАН 4: "ВІДСТЕЖЕННЯ ПАПОК" (АВТОМАТИЗАЦІЯ З ПОЯСНЕННЯМ)   -->
                        <!-- ========================================================= -->
                        <Grid x:Name="ScreenFolders" Visibility="Collapsed">
                            <Grid.RenderTransform>
                                <TranslateTransform X="0" Y="0" />
                            </Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Інформаційна картка: Що робить відстеження папок -->
                            <Border Grid.Row="0" Background="{StaticResource OrbitHeroBannerGradient}" BorderBrush="#4A3C75" BorderThickness="1" CornerRadius="14" Padding="18,14" Margin="0,0,0,14">
                                <DockPanel>
                                    <Border Width="38" Height="38" CornerRadius="10" Background="#3D3163" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="💡" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Як працює автоматичне відстеження папок?" FontSize="14" FontWeight="Bold" Foreground="#F2F3F7" />
                                        <TextBlock Text="Halo стежить за обраною папкою у фоновому режимі. Щойно ви завантажуєте або зберігаєте туди новий файл, програма автоматично виконує обрану дію (конвертує фото у WebP/PNG, стискає або розкладає файли по підпапках «Зображення», «Документи», «Відео»)."
                                                   FontSize="12" Foreground="#C4C7E0" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Картка додавання правила -->
                            <Border Grid.Row="1" Style="{StaticResource OrbitCardStyle}" Padding="20,18" Margin="0,0,0,16">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource OrbitAmberSoftBg}" Margin="0,0,10,0">
                                                <TextBlock Text="📂" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Додати папку для авто-обробки" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" />
                                                <TextBlock Text="Виберіть каталог на ПК та дію, яку потрібно виконувати" FontSize="11.5" Foreground="{DynamicResource OrbitTextSecondary}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="📁  Огляд папки..." Style="{StaticResource OrbitSecondaryButton}" Click="BtnAddFolder_Click" />
                                    </DockPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="260" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox x:Name="QuickFolderInput" Grid.Column="0" Text="" Style="{StaticResource OrbitTextBoxStyle}" Margin="0,0,10,0" />

                                        <ComboBox x:Name="QuickActionCombo" Grid.Column="1" Margin="0,0,10,0" SelectedIndex="0">
                                            <ComboBoxItem Content="Авто-сортування по підпапках" Tag="folder_auto_sort" />
                                            <ComboBoxItem Content="Конвертувати фото у WebP" Tag="image_to_webp" />
                                            <ComboBoxItem Content="Конвертувати фото у PNG" Tag="image_to_png" />
                                            <ComboBoxItem Content="Стискати нові зображення" Tag="image_compress" />
                                            <ComboBoxItem Content="Чорно-білий фільтр для фото" Tag="image_grayscale" />
                                        </ComboBox>

                                        <Button Grid.Column="2" Content="➕  Додати правило" Style="{StaticResource OrbitPrimaryButton}" Click="BtnQuickAddRule_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Картковий список активних папок -->
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="FoldersRulesItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource OrbitCardStyle}" Padding="18,14" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="{StaticResource OrbitPurpleSoftBg}" Margin="0,0,14,0">
                                                        <TextBlock Text="📁" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding FolderPath}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding ActionDisplayName}" FontSize="12" Foreground="{StaticResource OrbitPurpleLightBrush}" Margin="0,2,0,0" />
                                                    </StackPanel>

                                                    <Button Grid.Column="2" Content="▶ Обробити зараз" Style="{StaticResource OrbitSecondaryButton}" Padding="12,6" Margin="0,0,8,0"
                                                            Tag="{Binding}" Click="BtnRunFolderRuleNow_Click" />

                                                    <Button Grid.Column="3" Content="Видалити" Style="{StaticResource OrbitSecondaryButton}" Padding="12,6" Margin="0,0,14,0"
                                                            Tag="{Binding}" Click="BtnDeleteFolderRule_Click" />

                                                    <CheckBox Grid.Column="4" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                              Style="{StaticResource OrbitToggleSwitch}" Tag="{Binding}" Click="FolderRuleToggle_Click" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- ========================================================= -->
                        <!-- ЕКРАН 5: "НАЛАШТУВАННЯ" (МОВА, ТЕМИ, ПРОВІДНИК)             -->
                        <!-- ========================================================= -->
                        <Grid x:Name="ScreenSettings" Visibility="Collapsed">
                            <Grid.RenderTransform>
                                <TranslateTransform X="0" Y="0" />
                            </Grid.RenderTransform>
                            <UniformGrid Columns="2" Rows="2" VerticalAlignment="Top">
                                <!-- Картка 1: Мова та інтерфейс -->
                                <Border Style="{StaticResource OrbitCardStyle}" Margin="0,0,10,18" Padding="22">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,12">
                                            <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource OrbitPurpleSoftBg}">
                                                <TextBlock Text="🌍" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Border DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource OrbitPurpleSoftBg}" CornerRadius="7" Padding="10,3">
                                                <TextBlock Text="Локалізація" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource OrbitPurpleLightBrush}" />
                                            </Border>
                                        </DockPanel>
                                        <TextBlock x:Name="TxtSettingsLangTitle" Text="Мова інтерфейсу" FontSize="16.5" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" />
                                        <TextBlock x:Name="TxtSettingsLangSub" Text="Миттєва зміна мови всіх меню та підписів" FontSize="12" Foreground="{DynamicResource OrbitTextSecondary}" Margin="0,4,0,14" />
                                        <ComboBox x:Name="LanguageCombo" SelectedIndex="0" SelectionChanged="LanguageCombo_SelectionChanged">
                                            <ComboBoxItem Content="Українська (Основна)" Tag="uk" />
                                            <ComboBoxItem Content="English (US)" Tag="en" />
                                            <ComboBoxItem Content="Polski" Tag="pl" />
                                        </ComboBox>
                                    </StackPanel>
                                </Border>

                                <!-- Картка 2: Тема та візуальний стиль -->
                                <Border Style="{StaticResource OrbitCardStyle}" Margin="10,0,0,18" Padding="22">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,12">
                                            <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource OrbitBlueSoftBg}">
                                                <TextBlock Text="🎨" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Border DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource OrbitBlueSoftBg}" CornerRadius="7" Padding="10,3">
                                                <TextBlock Text="Оформлення" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource OrbitCyanBrush}" />
                                            </Border>
                                        </DockPanel>
                                        <TextBlock x:Name="TxtSettingsThemeTitle" Text="Кольорова тема Halo" FontSize="16.5" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" />
                                        <TextBlock x:Name="TxtSettingsThemeSub" Text="Налаштування палітри вікна та карток у реальному часі" FontSize="12" Foreground="{DynamicResource OrbitTextSecondary}" Margin="0,4,0,14" />
                                        <ComboBox x:Name="GeneralThemeCombo" SelectedIndex="0" SelectionChanged="GeneralThemeCombo_SelectionChanged">
                                            <ComboBoxItem Content="Темна Orbit (Фіолетово-графітова)" Tag="Dark" />
                                            <ComboBoxItem Content="Глибока синя (Cyber Indigo)" Tag="Indigo" />
                                            <ComboBoxItem Content="Світла Orbit (Light)" Tag="Light" />
                                        </ComboBox>
                                    </StackPanel>
                                </Border>

                                <!-- Картка 3: Автозапуск та Провідник Windows -->
                                <Border Style="{StaticResource OrbitCardStyle}" Margin="0,0,10,0" Padding="22">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtSettingsWinTitle" Text="Інтеграція з Windows" FontSize="16.5" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" Margin="0,0,0,14" />

                                        <DockPanel Margin="0,0,0,14">
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="Запускати разом із Windows" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource OrbitTextPrimary}" />
                                                <TextBlock Text="Автоматичний старт програми при вході в систему" FontSize="11.5" Foreground="{DynamicResource OrbitTextMuted}" />
                                            </StackPanel>
                                            <CheckBox x:Name="ToggleAutostart" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource OrbitToggleSwitch}" Click="ToggleAutostart_Click" />
                                        </DockPanel>

                                        <DockPanel>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="Контекстне меню Провідника" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource OrbitTextPrimary}" />
                                                <TextBlock Text="Додати пункт «Відкрити у Halo» при кліку ПКМ на файлі чи папці" FontSize="11.5" Foreground="{DynamicResource OrbitTextMuted}" />
                                            </StackPanel>
                                            <CheckBox x:Name="ToggleExplorerMenu" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource OrbitToggleSwitch}" Click="ToggleExplorerMenu_Click" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Картка 4: Поведінка збереження та анімацій -->
                                <Border Style="{StaticResource OrbitCardStyle}" Margin="10,0,0,0" Padding="22">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtSettingsBehaviorTitle" Text="Поведінка та швидкодія" FontSize="16.5" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" Margin="0,0,0,14" />

                                        <DockPanel Margin="0,0,0,14">
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="Автоматично ховати меню після дії" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource OrbitTextPrimary}" />
                                                <TextBlock Text="Закривати радіальне коло одразу після обробки файлу" FontSize="11.5" Foreground="{DynamicResource OrbitTextMuted}" />
                                            </StackPanel>
                                            <CheckBox x:Name="ToggleAutoHide" IsChecked="True" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource OrbitToggleSwitch}" Click="ToggleAutoHide_Click" />
                                        </DockPanel>

                                        <DockPanel>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="Плавні анімації переходів та секторів" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource OrbitTextPrimary}" />
                                                <TextBlock Text="Анімація появи меню та перемикання вкладок" FontSize="11.5" Foreground="{DynamicResource OrbitTextMuted}" />
                                            </StackPanel>
                                            <CheckBox x:Name="ToggleSmoothAnim" IsChecked="True" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource OrbitToggleSwitch}" Click="ToggleSmoothAnim_Click" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </Grid>

                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
