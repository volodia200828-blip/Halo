<ui:FluentWindow x:Class="Halo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:Halo.App.Controls"
        Title="Halo"
        Height="720" Width="1080"
        MinHeight="620" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Native Windows 11 TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="Halo" Height="38" />

        <!-- Body Grid with Navigation on the Left and Content on the Right -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Native Windows 11 NavigationView -->
            <ui:NavigationView x:Name="RootNavigation" Grid.Column="0"
                               IsBackButtonVisible="Collapsed"
                               PaneDisplayMode="Left"
                               SelectionChanged="RootNavigation_SelectionChanged">
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem Content="Головна" Tag="PageMain" Icon="{ui:SymbolIcon Home24}" IsActive="True" />
                    <ui:NavigationViewItem Content="Кругові меню" Tag="PageRadial" Icon="{ui:SymbolIcon TargetArrow24}" />
                    <ui:NavigationViewItem Content="Жести й клавіші" Tag="PageInput" Icon="{ui:SymbolIcon Keyboard24}" />
                    <ui:NavigationViewItem Content="Шаблони" Tag="PagePresets" Icon="{ui:SymbolIcon Flash24}" />
                    <ui:NavigationViewItem Content="Відстеження папок" Tag="PageFolders" Icon="{ui:SymbolIcon Folder24}" />
                    <ui:NavigationViewItem Content="Налаштування" Tag="PageSettings" Icon="{ui:SymbolIcon Settings24}" />
                </ui:NavigationView.MenuItems>
            </ui:NavigationView>

            <!-- Navigation Content Area -->
            <Grid Grid.Column="1" Margin="28,16,28,24">
                <!-- PAGE 1: ГОЛОВНА -->
                <Grid x:Name="PageMain" Visibility="Visible">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="800" HorizontalAlignment="Left">
                            <TextBlock Text="Головна" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Text="Огляд стану Halo та швидке керування функціями." FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,20" />

                            <!-- Hero Trigger Card -->
                            <ui:CardAction Margin="0,0,0,12" Click="BtnOpenHaloHere_Click">
                                <DockPanel>
                                    <ui:SymbolIcon Symbol="Circle24" FontSize="28" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Запустити кругове меню" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="Викликати інтерактивне коло над курсором (або натисніть Alt+Space)" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </ui:CardAction>

                            <!-- Shelf Card -->
                            <ui:CardAction Margin="0,0,0,12" Click="BtnOpenShelf_Click">
                                <DockPanel>
                                    <ui:SymbolIcon Symbol="Bookmark24" FontSize="28" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Поличка файлів (Shelf)" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="Плаваючий віджет швидкого доступу для тимчасового закріплення файлів" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </ui:CardAction>

                            <!-- Test File Picker Card -->
                            <ui:CardAction Margin="0,0,0,16" Click="BtnPickFile_Click">
                                <DockPanel>
                                    <ui:SymbolIcon Symbol="FolderOpen24" FontSize="28" Margin="0,0,16,0" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Вибрати файл для тесту" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="Виберіть зображення чи документ для демонстрації дій меню" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </ui:CardAction>

                            <!-- Expander: System Telemetry -->
                            <ui:CardExpander Header="Системний стан служби" IsExpanded="True">
                                <Grid Margin="4,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Глобальний хоткей" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="QuickHotkeyDisplay" Text="Alt+Space" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,4,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Затримка відгуку" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="&lt; 2 ms" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Пам'ять служби" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="~24 MB" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </ui:CardExpander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- PAGE 2: КРУГОВІ МЕНЮ -->
                <Grid x:Name="PageRadial" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Кругові меню" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="Конфігурація секторів для кожного типу файлів." FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="340" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Categories -->
                        <ui:Card Grid.Column="0" Margin="0,0,12,0" Padding="8">
                            <ListBox x:Name="RadialCategoriesList" Background="Transparent" BorderThickness="0" SelectionChanged="RadialCategoriesList_SelectionChanged">
                                <ListBoxItem IsSelected="True" Tag="Image">
                                    <DockPanel Width="170">
                                        <TextBlock Text="🖼️  Зображення" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock x:Name="BadgeImageCount" Text="6/8" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                                    </DockPanel>
                                </ListBoxItem>
                                <ListBoxItem Tag="Document">
                                    <DockPanel Width="170">
                                        <TextBlock Text="📄  Документи" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock x:Name="BadgeDocCount" Text="4/8" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                                    </DockPanel>
                                </ListBoxItem>
                                <ListBoxItem Tag="Video">
                                    <DockPanel Width="170">
                                        <TextBlock Text="🎬  Відео" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock x:Name="BadgeVideoCount" Text="3/8" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                                    </DockPanel>
                                </ListBoxItem>
                                <ListBoxItem Tag="Audio">
                                    <DockPanel Width="170">
                                        <TextBlock Text="🎵  Аудіо" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock x:Name="BadgeAudioCount" Text="2/8" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                                    </DockPanel>
                                </ListBoxItem>
                                <ListBoxItem Tag="Generic">
                                    <DockPanel Width="170">
                                        <TextBlock Text="📦  Будь-які файли" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock x:Name="BadgeGenericCount" Text="5/8" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                                    </DockPanel>
                                </ListBoxItem>
                            </ListBox>
                        </ui:Card>

                        <!-- Fixed Ratio Radial Disc (Never Distorts) -->
                        <ui:Card Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                            <Viewbox Stretch="Uniform" MaxWidth="300" MaxHeight="300" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <controls:RadialDiscControl x:Name="PreviewRadialDisc" />
                            </Viewbox>
                        </ui:Card>

                        <!-- Actions List with native ToggleSwitch -->
                        <ui:Card Grid.Column="2" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="СЕКТОРИ КАТЕГОРІЇ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,10" />

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="RadialActionsItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ui:Card Margin="0,0,0,8" Padding="12,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="{Binding IconKey}" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                                                        </StackPanel>

                                                        <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                         Click="RadialActionToggle_Click" Tag="{Binding}" />
                                                    </Grid>
                                                </ui:Card>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </ui:Card>
                    </Grid>
                </Grid>

                <!-- PAGE 3: ЖЕСТИ Й КЛАВІШІ -->
                <Grid x:Name="PageInput" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                            <TextBlock Text="Жести й клавіші" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Text="Керування комбінаціями виклику та жестами миші." FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,20" />

                            <!-- Interactive Hotkey Recorder Card -->
                            <ui:CardAction x:Name="HotkeyRecorderCard" Margin="0,0,0,12" Click="BtnRecordHotkey_Click">
                                <DockPanel>
                                    <ui:SymbolIcon Symbol="Keyboard24" FontSize="26" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Глобальний хоткей виклику" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock x:Name="HotkeyRecorderHint" Text="Натисніть сюди, щоб призначити нову комбінацію на клавіатурі" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12,6">
                                        <TextBlock x:Name="HotkeyRecorderStatusText" Text="Alt+Space" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>
                                </DockPanel>
                            </ui:CardAction>

                            <!-- Pause Gestures Toggle Card -->
                            <ui:Card Margin="0,0,0,12">
                                <DockPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Призупинити жести та гарячі клавіші" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="Тимчасово вимкнути перехоплення клавіш (для 3D-ігор)" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ui:ToggleSwitch x:Name="CheckPauseGestures" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="CheckPauseGestures_Click" />
                                </DockPanel>
                            </ui:Card>

                            <!-- Mouse Shake Toggle Card -->
                            <ui:Card Margin="0,0,0,12">
                                <DockPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Струшування мишею при перетягуванні файлу" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="Швидкий рух файлу відкриває кругове меню поруч" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ui:ToggleSwitch IsChecked="True" DockPanel.Dock="Right" HorizontalAlignment="Right" />
                                </DockPanel>
                            </ui:Card>

                            <!-- Middle Click Toggle Card -->
                            <ui:Card Margin="0,0,0,12">
                                <DockPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Клік коліщатком миші над файлом у Провіднику" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="Миттєвий виклик кругового меню над файлом" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ui:ToggleSwitch IsChecked="True" DockPanel.Dock="Right" HorizontalAlignment="Right" />
                                </DockPanel>
                            </ui:Card>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- PAGE 4: ШАБЛОНИ -->
                <Grid x:Name="PagePresets" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,20">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Шаблони та макроси" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Text="Комплексні ланцюжки перетворень файлів в один клік." FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ui:Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="➕  Створити шаблон"
                                   Appearance="Primary" Click="BtnCreatePreset_Click" />
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <WrapPanel Orientation="Horizontal">
                            <!-- Preset 1 -->
                            <ui:Card Width="300" Margin="0,0,14,14" Padding="16">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="🌐 Оптимізація для Web" FontSize="15" FontWeight="SemiBold" />
                                        <Border DockPanel.Dock="Right" Background="{DynamicResource AccentTextFillColorPrimaryBrush}" CornerRadius="4" Padding="6,2" Opacity="0.15">
                                            <TextBlock Text="WebP" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        </Border>
                                    </DockPanel>
                                    <TextBlock Text="Конвертація в WebP + ресайз до 1920px зі стисненням 80%" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,14" TextWrapping="Wrap" />
                                    <ui:Button Content="Тестувати" HorizontalAlignment="Right" Click="BtnTestPreset_Click" />
                                </StackPanel>
                            </ui:Card>

                            <!-- Preset 2 -->
                            <ui:Card Width="300" Margin="0,0,14,14" Padding="16">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="🖤 Чорно-білий архів" FontSize="15" FontWeight="SemiBold" />
                                        <Border DockPanel.Dock="Right" Background="{DynamicResource AccentTextFillColorPrimaryBrush}" CornerRadius="4" Padding="6,2" Opacity="0.15">
                                            <TextBlock Text="B&amp;W" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        </Border>
                                    </DockPanel>
                                    <TextBlock Text="Контрастний монохромний арт-фільтр для фотографій" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,14" TextWrapping="Wrap" />
                                    <ui:Button Content="Тестувати" HorizontalAlignment="Right" Click="BtnTestPreset_Click" />
                                </StackPanel>
                            </ui:Card>

                            <!-- Preset 3 -->
                            <ui:Card Width="300" Margin="0,0,14,14" Padding="16">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="📄 Документ в PDF" FontSize="15" FontWeight="SemiBold" />
                                        <Border DockPanel.Dock="Right" Background="{DynamicResource AccentTextFillColorPrimaryBrush}" CornerRadius="4" Padding="6,2" Opacity="0.15">
                                            <TextBlock Text="PDF" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        </Border>
                                    </DockPanel>
                                    <TextBlock Text="Миттєва генерація PDF документа із збереженням розміру" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,14" TextWrapping="Wrap" />
                                    <ui:Button Content="Тестувати" HorizontalAlignment="Right" Click="BtnTestPreset_Click" />
                                </StackPanel>
                            </ui:Card>
                        </WrapPanel>
                    </ScrollViewer>
                </Grid>

                <!-- PAGE 5: ВІДСТЕЖЕННЯ ПАПОК -->
                <Grid x:Name="PageFolders" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Відстеження папок" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Text="Автоматична фонова обробка нових файлів у заданих каталогах." FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ui:Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="➕  Вибрати папку"
                                   Appearance="Primary" Click="BtnAddFolder_Click" />
                    </DockPanel>

                    <!-- Add rule card -->
                    <ui:Card Grid.Row="1" Margin="0,0,0,16" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:TextBox x:Name="QuickFolderInput" Text="C:\Users\...\Downloads" Margin="0,0,10,0" />
                            <ComboBox x:Name="QuickActionCombo" Grid.Column="1" Margin="0,0,10,0" SelectedIndex="0" Padding="8">
                                <ComboBoxItem Content="Конвертувати у WebP" Tag="image_to_webp" />
                                <ComboBoxItem Content="Конвертувати у PNG" Tag="image_to_png" />
                                <ComboBoxItem Content="Стиснути зображення" Tag="image_compress" />
                                <ComboBoxItem Content="Чорно-білий фільтр" Tag="image_grayscale" />
                            </ComboBox>
                            <ui:Button Grid.Column="2" Content="Створити правило" Appearance="Primary" Click="BtnQuickAddRule_Click" />
                        </Grid>
                    </ui:Card>

                    <!-- Monitored list -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="FoldersRulesItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Card Margin="0,0,0,8" Padding="14,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FolderPath}" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding AssignedActionId, StringFormat='Автоматична дія: {0}'}" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <ui:Button Grid.Column="1" Content="Видалити" Margin="0,0,12,0" Padding="10,4"
                                                       Tag="{Binding}" Click="BtnDeleteFolderRule_Click" />
                                            <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                             Tag="{Binding}" Click="FolderRuleToggle_Click" />
                                        </Grid>
                                    </ui:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- PAGE 6: НАЛАШТУВАННЯ -->
                <Grid x:Name="PageSettings" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                            <TextBlock Text="Налаштування" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Text="Загальні параметри додатку та інтеграція в систему." FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,20" />

                            <ui:Card Margin="0,0,0,12">
                                <DockPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Тема оформлення" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="Перемикання теми інтерфейсу Halo" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ComboBox x:Name="GeneralThemeCombo" Width="180" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                              SelectedIndex="0" Padding="8" SelectionChanged="GeneralThemeCombo_SelectionChanged">
                                        <ComboBoxItem Content="Темна тема" />
                                        <ComboBoxItem Content="Світла тема" />
                                        <ComboBoxItem Content="Системна" />
                                    </ComboBox>
                                </DockPanel>
                            </ui:Card>

                            <ui:Card Margin="0,0,0,12">
                                <DockPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Автозапуск разом із Windows" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="Запускати службу Halo у фоні при старті системи" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ui:ToggleSwitch IsChecked="True" DockPanel.Dock="Right" HorizontalAlignment="Right" />
                                </DockPanel>
                            </ui:Card>

                            <ui:Card Margin="0,0,0,12">
                                <DockPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Інтеграція в меню Windows Explorer" FontSize="14" FontWeight="SemiBold" />
