<Window x:Class="Halo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Halo — Центр керування"
        Height="540" Width="820"
        MinHeight="460" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F19"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI Variable, Segoe UI">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155" />
                    <Setter Property="BorderBrush" Value="#38BDF8" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Border Width="40" Height="40" CornerRadius="20" Background="#0284C7" Margin="0,0,12,0">
                    <TextBlock Text="⭕" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Halo" FontSize="24" FontWeight="Bold" Foreground="#38BDF8" />
                    <TextBlock Text="Сучасна утиліта з інтерактивним круговим меню" FontSize="12" Foreground="#94A3B8" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button Content="📌 Поличка" Margin="0,0,10,0" Click="BtnOpenShelf_Click" />
                <Button Content="⚙️ Налаштування" Background="#0284C7" BorderBrush="#38BDF8" FontWeight="SemiBold" Click="BtnOpenSettings_Click" />
            </StackPanel>
        </DockPanel>

        <!-- Status Cards Row -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: Hotkey -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="10" Padding="14" Margin="0,0,8,0" BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="ГЛОБАЛЬНИЙ ХОТКЕЙ" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                    <TextBlock x:Name="HotkeyStatusText" Text="Alt + Space" FontSize="18" FontWeight="Bold" Foreground="#38BDF8" Margin="0,4,0,2" />
                    <TextBlock Text="Працює у будь-якій програмі" FontSize="11" Foreground="#94A3B8" />
                </StackPanel>
            </Border>

            <!-- Card 2: Active Actions -->
            <Border Grid.Column="1" Background="#1E293B" CornerRadius="10" Padding="14" Margin="4,0,4,0" BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="АКТИВНІ ФУНКЦІЇ" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                    <TextBlock x:Name="ActiveActionsCountText" Text="12 функцій" FontSize="18" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,2" />
                    <TextBlock Text="Повністю кастомізуються" FontSize="11" Foreground="#94A3B8" />
                </StackPanel>
            </Border>

            <!-- Card 3: Watcher -->
            <Border Grid.Column="2" Background="#1E293B" CornerRadius="10" Padding="14" Margin="8,0,0,0" BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="ГАРЯЧІ ПАПКИ" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                    <TextBlock x:Name="WatchedFoldersStatusText" Text="Активні" FontSize="18" FontWeight="Bold" Foreground="#A855F7" Margin="0,4,0,2" />
                    <TextBlock Text="Фонова обробка" FontSize="11" Foreground="#94A3B8" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Drop & Interactive Test Zone -->
        <Border Grid.Row="2" Background="#131C2E" CornerRadius="12" BorderBrush="#334155" BorderThickness="2"
                AllowDrop="True" Drop="DropZone_Drop" DragOver="DropZone_DragOver" Margin="0,0,0,16">
            <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🎯" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,10" />
                    <TextBlock Text="Тестова зона: Перетягніть сюди будь-який файл" FontSize="16" FontWeight="SemiBold" Foreground="#F8FAFC" HorizontalAlignment="Center" />
                    <TextBlock Text="Зображення (PNG, JPG, WebP), документ або будь-який файл — щоб побачити радіальне меню"
                               FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,16" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Вибрати файл для тесту..." Click="BtnPickFile_Click" Margin="0,0,10,0" Background="#1E293B" />
                        <Button Content="⭕ Відкрити меню Halo тут" Click="BtnOpenHaloHere_Click" Background="#0284C7" BorderBrush="#38BDF8" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer hint -->
        <DockPanel Grid.Row="3">
            <TextBlock Text="💡 Порада: Виділіть файл у Windows Explorer та натисніть Alt + Space — Halo з'явиться поруч із курсором."
                       FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
