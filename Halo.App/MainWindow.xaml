<Window x:Class="Halo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Halo.App.Controls"
        Title="Halo"
        Height="760" Width="1180"
        MinHeight="660" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Foreground="{DynamicResource OrbitTextPrimary}"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
        Icon="pack://application:,,,/Resources/avatar.png"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="10">
        <!-- Фоновий шар тіні вікна (Окремий від контенту, щоб текст не розмивався!) -->
        <Border Background="{DynamicResource OrbitWindowBgBrush}"
                CornerRadius="18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="5" Direction="270" Color="#000000" Opacity="0.55" />
            </Border.Effect>
        </Border>

        <!-- Основний чіткий контейнер вікна (Без Effect, ідеальна чіткість ClearType!) -->
        <Border Background="{DynamicResource OrbitWindowBgBrush}"
                BorderBrush="{DynamicResource OrbitSubtleBorderBrush}"
                BorderThickness="1"
                CornerRadius="18"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ================================================================= -->
                <!-- 1. ЛІВИЙ САЙДБАР (ВІЗУАЛЬНО ВІДДІЛЕНИЙ, СТИЛЬ "ORBIT")            -->
                <!-- ================================================================= -->
                <Border Grid.Column="0"
                        Background="{DynamicResource OrbitSidebarBgBrush}"
                        BorderBrush="{DynamicResource OrbitSidebarDividerBrush}"
                        BorderThickness="0,0,1,0"
                        CornerRadius="18,0,0,18"
                        Padding="20,24">
                    <DockPanel>
                        <!-- Логотип зверху зліва -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,2,4,32" MouseDown="TitleBar_MouseDown" Background="Transparent">
                            <Grid Width="44" Height="44" Margin="0,0,14,0">
                                <Border CornerRadius="13" Background="{DynamicResource OrbitLogoBoxBgBrush}" Effect="{StaticResource OrbitPurpleGlow}" />
                                <Border CornerRadius="13" BorderBrush="{DynamicResource OrbitLogoBoxBorderBrush}" BorderThickness="1.5" ClipToBounds="True">
                                    <Image Source="pack://application:,,,/Resources/avatar.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Halo" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" />
                                <TextBlock x:Name="TxtSidebarSubtitle" Text="Робочий простір" FontSize="11.5" Foreground="{DynamicResource OrbitTextMuted}" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Нижня міні-картка статусу фонового сервісу -->
                        <Border DockPanel.Dock="Bottom"
                                Background="{DynamicResource OrbitCardBgBrush}"
                                BorderBrush="{DynamicResource OrbitCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="16,14"
                                Margin="0,16,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Ellipse x:Name="SidebarStatusDot" Width="8" Height="8" Fill="{DynamicResource OrbitGreenLightBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock x:Name="TxtSidebarServiceStatus" Text="Служба активна" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource OrbitTextPrimary}" />
                                </StackPanel>
                                <DockPanel>
                                    <TextBlock x:Name="TxtSidebarTriggerLabel" Text="Тригер:" FontSize="11.5" Foreground="{DynamicResource OrbitTextMuted}" VerticalAlignment="Center" />
                                    <Border x:Name="SidebarTriggerBadgeBorder" DockPanel.Dock="Right" HorizontalAlignment="Right" Background="{DynamicResource OrbitPurpleSoftBg}" CornerRadius="6" Padding="8,2">
                                        <TextBlock x:Name="SidebarHotkeyBadge" Text="Alt+Space" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OrbitPurpleLightBrush}" />
                                    </Border>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Меню навігації (5 вкладок з плавним ковзаючим індикатором вибору) -->
                        <Grid x:Name="NavMenuContainer">
                            <!-- Плавний рухомий фоновий індикатор вибору між кнопками меню -->
                            <Border x:Name="NavIndicatorPill"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top"
                                    Height="44"
                                    CornerRadius="12"
                                    Background="{DynamicResource OrbitNavActiveBgGradient}"
                                    BorderBrush="{DynamicResource OrbitNavActiveBorderBrush}"
                                    BorderThickness="1"
                                    IsHitTestVisible="False"
                                    Opacity="0">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="NavIndicatorTransform" Y="0" />
                                </Border.RenderTransform>
                                <!-- Акцентний лівий маркер, що плавно ковзає разом із пігулкою вибору -->
                                <Border Width="4" Height="20" CornerRadius="2"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="{StaticResource OrbitNavMarkerGradient}"
                                        Margin="8,0,0,0" />
                            </Border>

                            <StackPanel x:Name="NavButtonsStack">
                                <TextBlock x:Name="TxtSidebarMenuHeader" Text="МЕНЮ" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource OrbitTextMuted}" Margin="10,0,0,8" />

                                <RadioButton x:Name="NavMain" Style="{StaticResource OrbitSidebarItemStyle}" IsChecked="True" Checked="Nav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource OrbitIconDashboard}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.8" Width="17" Height="17" Stretch="Uniform" Margin="0,0,13,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TxtNavMain" Text="Головна" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="NavRadial" Style="{StaticResource OrbitSidebarItemStyle}" Checked="Nav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource OrbitIconRadial}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.8" Width="17" Height="17" Stretch="Uniform" Margin="0,0,13,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TxtNavRadial" Text="Кругові меню" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="NavInput" Style="{StaticResource OrbitSidebarItemStyle}" Checked="Nav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource OrbitIconKeys}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.8" Width="17" Height="17" Stretch="Uniform" Margin="0,0,13,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TxtNavInput" Text="Жести й клавіші" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="NavFolders" Style="{StaticResource OrbitSidebarItemStyle}" Checked="Nav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource OrbitIconFolders}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.8" Width="17" Height="17" Stretch="Uniform" Margin="0,0,13,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TxtNavFolders" Text="Відстеження папок" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="NavSettings" Style="{StaticResource OrbitSidebarItemStyle}" Checked="Nav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource OrbitIconSettings}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.7" StrokeLineJoin="Round" Width="18" Height="18" Stretch="Uniform" Margin="0,0,13,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TxtNavSettings" Text="Налаштування" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- ================================================================= -->
                <!-- 2. ПРАВА ОСНОВНА РОБОЧА ОБЛАСТЬ (КАРТКОВИЙ ІНТЕРФЕЙС "ORBIT")     -->
                <!-- ================================================================= -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- ВЕРХНЯ ПАНЕЛЬ (Використовує Grid замість DockPanel, щоб довгий підзаголовок у Налаштуваннях ніколи не обрізав кнопку Полиці!) -->
                    <Border Grid.Row="0" Background="Transparent" Padding="32,22,24,14" MouseDown="TitleBar_MouseDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock x:Name="PageHeaderTitle" Text="Головна" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="PageHeaderSubtitle" Text="Огляд активних інструментів, швидких дій та стану робочого простору" FontSize="13" Foreground="{DynamicResource OrbitTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnHeaderOpenShelf" Content="📌  Полиця" Style="{StaticResource OrbitSecondaryButton}" Padding="14,8" Margin="0,0,10,0" Click="BtnOpenShelf_Click" />
                                <Button x:Name="BtnHeaderOpenHalo" Content="✦  Відкрити Halo" Style="{StaticResource OrbitPrimaryButton}" Padding="16,8" Margin="0,0,14,0" Click="BtnOpenHaloHere_Click" />

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnWinMinimize" Style="{StaticResource OrbitWindowCapBtn}" Click="BtnMinimize_Click" ToolTip="Згорнути">
                                        <Path Data="{StaticResource OrbitIconMinimize}" Stroke="{DynamicResource OrbitTextSecondary}" StrokeThickness="1.8" Width="11" Height="11" Stretch="Uniform" />
                                    </Button>
                                    <Button x:Name="BtnWinClose" Style="{StaticResource OrbitWindowCloseBtn}" Click="BtnClose_Click" Margin="4,0,0,0" ToolTip="Закрити">
                                        <Path Data="{StaticResource OrbitIconClose}" Stroke="{DynamicResource OrbitTextSecondary}" StrokeThickness="1.8" Width="11" Height="11" Stretch="Uniform" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- КОНТЕНТ СТОРІНОК -->
                    <Grid Grid.Row="1" Margin="32,8,32,26">

                        <!-- ========================================================= -->
                        <!-- ЕКРАН 1: "ГОЛОВНА" (ДАШБОРД У СТИЛІ "ORBIT")              -->
                        <!-- ========================================================= -->
                        <Grid x:Name="ScreenMain" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- РЯД 1: 4 ІНТЕРАКТИВНІ КАРТКИ ПОКАЗНИКІВ (Уніфікована кольорова гама: всі значення OrbitTextPrimary, всі підписи у кольорі акценту картки) -->
                            <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,18">
                                <!-- Картка 1: Активні сектори -> Кругові меню -->
                                <Border Style="{StaticResource OrbitInteractiveCardStyle}" Margin="0,0,8,0" Padding="18,15" MouseLeftButtonDown="BtnJumpToRadial_Click">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock x:Name="TxtMetric1Title" Text="Активні дії" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource OrbitTextSecondary}" VerticalAlignment="Center" />
                                            <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Width="34" Height="34" CornerRadius="10" Background="{DynamicResource OrbitPurpleSoftBg}">
                                                <TextBlock Text="🎯" FontSize="15" Foreground="{DynamicResource OrbitPurpleLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </DockPanel>
                                        <TextBlock x:Name="StatActiveActions" Text="11" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" Margin="0,2,0,2" />
                                        <TextBlock x:Name="TxtMetric1Sub" Text="Налаштувати сектори →" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource OrbitPurpleLightBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Картка 2: Глобальний тригер -> Жести й клавіші -->
                                <Border Style="{StaticResource OrbitInteractiveCardStyle}" Margin="4,0,4,0" Padding="18,15" MouseLeftButtonDown="BtnJumpToInput_Click">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock x:Name="TxtMetric2Title" Text="Швидкий виклик" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource OrbitTextSecondary}" VerticalAlignment="Center" />
                                            <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Width="34" Height="34" CornerRadius="10" Background="{DynamicResource OrbitBlueSoftBg}">
                                                <TextBlock Text="⌨️" FontSize="15" Foreground="{DynamicResource OrbitCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </DockPanel>
                                        <TextBlock x:Name="StatGlobalHotkey" Text="Alt+Space" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" Margin="0,2,0,2" />
                                        <TextBlock x:Name="TxtMetric2Sub" Text="Жести та клавіші →" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource OrbitCyanBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Картка 3: Відстеження папок -> Відстеження папок -->
                                <Border Style="{StaticResource OrbitInteractiveCardStyle}" Margin="4,0,4,0" Padding="18,15" MouseLeftButtonDown="BtnJumpToFolders_Click">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock x:Name="TxtMetric3Title" Text="Автоматизація" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource OrbitTextSecondary}" VerticalAlignment="Center" />
                                            <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Width="34" Height="34" CornerRadius="10" Background="{DynamicResource OrbitAmberSoftBg}">
                                                <TextBlock Text="📂" FontSize="15" Foreground="{DynamicResource OrbitAmberLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </DockPanel>
                                        <TextBlock x:Name="StatWatchedFolders" Text="0" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" Margin="0,2,0,2" />
                                        <TextBlock x:Name="TxtMetric3Sub" Text="Відстеження папок →" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource OrbitAmberLightBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Картка 4: Оформлення і система -> Налаштування -->
                                <Border Style="{StaticResource OrbitInteractiveCardStyle}" Margin="8,0,0,0" Padding="18,15" MouseLeftButtonDown="BtnJumpToSettings_Click">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock x:Name="TxtMetric4Title" Text="Тема та система" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource OrbitTextSecondary}" VerticalAlignment="Center" />
                                            <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Width="34" Height="34" CornerRadius="10" Background="{DynamicResource OrbitGreenSoftBg}">
                                                <TextBlock Text="🎨" FontSize="15" Foreground="{DynamicResource OrbitGreenLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </DockPanel>
                                        <TextBlock x:Name="StatCurrentTheme" Text="Темна" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" Margin="0,2,0,2" />
                                        <TextBlock x:Name="TxtMetric4Sub" Text="Відкрити налаштування →" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource OrbitGreenLightBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- РЯД 2: ДВОКОЛОНКОВА КАРТКОВА СІТКА -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.6*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <!-- Ліва колонка: Інтерактивний хаб + 4 картки прямих швидких дій (ZIP, PDF, OCR, Оптимізація фото) -->
                                <Grid Grid.Column="0" Margin="0,0,10,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Головна інтерактивна картка -->
                                    <Border Grid.Row="0"
                                            Background="{DynamicResource OrbitHeroBannerGradient}"
                                            BorderBrush="{DynamicResource OrbitHeroBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="16"
                                            Padding="22,18"
                                            Margin="0,0,0,14"
                                            AllowDrop="True"
                                            Drop="DropZone_Drop"
                                            DragOver="DropZone_DragOver">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <Border Background="{DynamicResource OrbitHeroBadgeBgBrush}" CornerRadius="8" Padding="10,4" HorizontalAlignment="Left" Margin="0,0,0,8">
                                                    <TextBlock x:Name="TxtHubBadge" Text="✦  ІНТЕРАКТИВНИЙ ХАБ" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource OrbitHeroBadgeTextBrush}" />
                                                </Border>
                                                <TextBlock x:Name="TxtHubTitle" Text="Миттєва робота з будь-яким файлом" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource OrbitHeroTitleBrush}" TextWrapping="Wrap" />
                                                <TextBlock x:Name="TxtHubDesc" Text="Перетягніть сюди файл або оберіть його з диска — Halo одразу відкриє радіальне меню для обраного файлу."
                                                           FontSize="12" Foreground="{DynamicResource OrbitHeroDescBrush}" TextWrapping="Wrap" Margin="0,5,14,12" />

                                                <WrapPanel Orientation="Horizontal">
                                                    <Button x:Name="BtnHubPickFile" Content="📂  Вибрати файл" MinWidth="150" Height="38" Padding="16,0" Style="{StaticResource OrbitPrimaryButton}" Margin="0,0,10,6" Click="BtnPickFile_Click" />
                                                    <Button x:Name="BtnHubTestMenu" Content="◎  Тест кругового меню" MinWidth="160" Height="38" Padding="16,0" Style="{StaticResource OrbitSecondaryButton}" Margin="0,0,0,6" Click="BtnOpenHaloHere_Click" />
                                                </WrapPanel>

                                                <!-- Живий індикатор вибраного/обробленого файлу -->
                                                <Border x:Name="HubStatusPill" Background="{DynamicResource OrbitRecessedBgBrush}" BorderBrush="{DynamicResource OrbitSubtleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="11,6" Margin="0,4,14,0" Visibility="Collapsed">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="TxtHubStatus" Grid.Column="0" Text="" FontSize="11.5" Foreground="{DynamicResource OrbitTextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <Button x:Name="BtnHubRevealResult" Grid.Column="1" Content="Показати ↗" Style="{StaticResource OrbitSecondaryButton}" Padding="8,2" FontSize="11" Margin="8,0,0,0" Visibility="Collapsed" Click="BtnHubRevealResult_Click" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>

                                            <!-- Декоративне кільце справа з аватаркою -->
                                            <Border Grid.Column="1" Width="90" Height="90" CornerRadius="45" Background="{DynamicResource OrbitHeroRingBgBrush}" BorderBrush="{DynamicResource OrbitHeroBorderBrush}" BorderThickness="1.5" VerticalAlignment="Center" Margin="6,0,0,0" Cursor="Hand" MouseLeftButtonDown="BtnPickFile_Click">
                                                <Grid>
                                                    <Border Width="72" Height="72" CornerRadius="36" BorderBrush="{StaticResource OrbitLogoGradient}" BorderThickness="3" ClipToBounds="True" Effect="{StaticResource OrbitPurpleGlow}">
                                                        <Image Source="pack://application:,,,/Resources/avatar.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- 4 Картки миттєвих операцій (Стиснення у ZIP, Зберегти в PDF, Розпізнати текст OCR, Оптимізувати фото) -->
                                    <UniformGrid Grid.Row="1" Columns="2" Rows="2">
                                        <!-- 1. Стиснення у ZIP (пряме виконання) -->
                                        <Border Style="{StaticResource OrbitInteractiveCardStyle}" Padding="14,12" Margin="0,0,6,6"
                                                MouseLeftButtonDown="BtnQuickZip_Click" AllowDrop="True" Drop="QuickZip_Drop" DragOver="DropZone_DragOver">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="{DynamicResource OrbitBlueSoftBg}" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="ZIP" FontFamily="Bahnschrift, Segoe UI" FontSize="13" FontWeight="ExtraBold" Foreground="{DynamicResource OrbitCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtQuickZipTitle" Text="Стиснення у ZIP" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource OrbitTextPrimary}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock x:Name="TxtQuickZipSub" Text="Миттєве пакування файлів в архів" FontSize="11" Foreground="{DynamicResource OrbitTextMuted}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- 2. Зберегти в PDF (пряме виконання) -->
                                        <Border Style="{StaticResource OrbitInteractiveCardStyle}" Padding="14,12" Margin="6,0,0,6"
                                                MouseLeftButtonDown="BtnQuickPdf_Click" AllowDrop="True" Drop="QuickPdf_Drop" DragOver="DropZone_DragOver">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="{DynamicResource OrbitRoseSoftBg}" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="PDF" FontFamily="Bahnschrift, Segoe UI" FontSize="13" FontWeight="ExtraBold" Foreground="{DynamicResource OrbitRoseLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtQuickPdfTitle" Text="Зберегти в PDF" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource OrbitTextPrimary}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock x:Name="TxtQuickPdfSub" Text="Миттєва конвертація у документ PDF" FontSize="11" Foreground="{DynamicResource OrbitTextMuted}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- 3. Розпізнати текст OCR (нова корисна функція прямого виконання) -->
                                        <Border Style="{StaticResource OrbitInteractiveCardStyle}" Padding="14,12" Margin="0,6,6,0"
                                                MouseLeftButtonDown="BtnQuickOcr_Click" AllowDrop="True" Drop="QuickOcr_Drop" DragOver="DropZone_DragOver">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="{DynamicResource OrbitPurpleSoftBg}" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="OCR" FontFamily="Bahnschrift, Segoe UI" FontSize="12.5" FontWeight="ExtraBold" Foreground="{DynamicResource OrbitPurpleLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtQuickOcrTitle" Text="Розпізнати текст (OCR)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource OrbitTextPrimary}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock x:Name="TxtQuickOcrSub" Text="Текст із фото чи PDF одразу в буфер" FontSize="11" Foreground="{DynamicResource OrbitTextMuted}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- 4. Створити кліп / Відеоредактор (нова корисна функція прямого виконання) -->
                                        <Border Style="{StaticResource OrbitInteractiveCardStyle}" Padding="14,12" Margin="6,6,0,0"
                                                MouseLeftButtonDown="BtnQuickClip_Click" AllowDrop="True" Drop="QuickClip_Drop" DragOver="DropZone_DragOver">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="{DynamicResource OrbitAmberSoftBg}" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="🎬" FontFamily="Segoe UI Emoji, Bahnschrift, Segoe UI" FontSize="16" Foreground="{DynamicResource OrbitAmberLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtQuickClipTitle" Text="Створити кліп" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource OrbitTextPrimary}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock x:Name="TxtQuickClipSub" Text="Обрізка та вибір моменту з відео" FontSize="11" Foreground="{DynamicResource OrbitTextMuted}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </UniformGrid>
                                </Grid>

                                <!-- Права колонка: Журнал операцій (Історія дій + Кнопка «Скасувати») -->
                                <Border Grid.Column="1" Style="{StaticResource OrbitCardStyle}" Margin="10,0,0,0" Padding="18">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock x:Name="TxtHistoryTitle" Text="Журнал операцій" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="TxtHistorySub" Text="Історія файлових дій та фонової автоматизації" FontSize="11.5" Foreground="{DynamicResource OrbitTextMuted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{DynamicResource OrbitGreenSoftBg}" CornerRadius="7" Padding="10,3" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtHistoryBadge" Text="Живий лог" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OrbitGreenLightBrush}" />
                                            </Border>
                                        </Grid>

                                        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                            <Button x:Name="BtnClearHistory" Content="🗑️  Очистити журнал" Style="{StaticResource OrbitSecondaryButton}" HorizontalAlignment="Stretch" Click="BtnClearHistory_Click" FontSize="11.5" Height="32" Padding="0" />
                                        </Grid>

                                        <!-- Список недавніх операцій з можливістю скасування -->
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0" MaxHeight="310">
                                            <StackPanel x:Name="HistoryItemsPanel">
                                                <!-- Наповнюється програмно з OperationHistoryService -->
                                            </StackPanel>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- ========================================================= -->
                        <!-- ЕКРАН 2: "КРУГОВІ МЕНЮ" (3 РЕЖИМИ + 7 КАТЕГОРІЙ ФАЙЛІВ)     -->
                        <!-- ========================================================= -->
                        <Grid x:Name="ScreenRadial" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Верхня панель вибору глобального режиму: ідеально вирівняна для Shift / Ctrl / Alt -->
                            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource OrbitCardStyle}" Padding="16,10" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtRadialModeLabel" Text="ГЛОБАЛЬНИЙ РЕЖИМ:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource OrbitTextMuted}" VerticalAlignment="Center" Margin="2,0,12,0" />
                                        <RadioButton x:Name="RadialModeConvertRadio" IsChecked="True" GroupName="RadialModeGroup" Content="⚡ Конвертація (Shift)" Style="{StaticResource OrbitModePillRadioStyle}" Padding="14,7" Checked="RadialModeRadio_Checked" Tag="Convert" />
                                        <RadioButton x:Name="RadialModeToolsRadio" GroupName="RadialModeGroup" Content="🛠️ Інструменти (Ctrl)" Style="{StaticResource OrbitModePillRadioStyle}" Padding="14,7" Checked="RadialModeRadio_Checked" Tag="Edit" />
                                        <RadioButton x:Name="RadialModeActionsRadio" GroupName="RadialModeGroup" Content="🚀 Дії (Alt)" Style="{StaticResource OrbitModePillRadioStyle}" Padding="14,7" Margin="0" Checked="RadialModeRadio_Checked" Tag="System" />
                                    </StackPanel>

                                    <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource OrbitRecessedBgBrush}" BorderBrush="{DynamicResource OrbitSubtleBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="12,0,0,0">
                                        <TextBlock x:Name="TxtRadialModifierHint"
                                                   Text="Клавіші в меню: Shift — Конвертація • Ctrl — Інструменти • Alt — Дії"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource OrbitTextSecondary}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Колонка 1: Картка категорій файлів -->
                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource OrbitCardStyle}" Padding="12" Margin="0,0,14,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtRadialCategoriesHeader" Text="КАТЕГОРІЇ ФАЙЛІВ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource OrbitTextMuted}" Margin="8,4,8,8" />
                                        <ListBox x:Name="RadialCategoriesList"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 HorizontalContentAlignment="Stretch"
                                                 SelectionChanged="RadialCategoriesList_SelectionChanged">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="CatBorder" Background="Transparent" CornerRadius="10" Padding="10,8" Margin="0,2" Cursor="Hand" BorderBrush="Transparent" BorderThickness="1">
                                                                    <ContentPresenter HorizontalAlignment="Stretch" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="CatBorder" Property="Background" Value="{DynamicResource OrbitCardHoverBgBrush}" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="CatBorder" Property="Background" Value="{DynamicResource OrbitNavActiveBgGradient}" />
                                                                        <Setter TargetName="CatBorder" Property="BorderBrush" Value="{DynamicResource OrbitNavActiveBorderBrush}" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>

                                            <ListBoxItem IsSelected="True" Tag="Image">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="🖼️" FontSize="13.5" Foreground="{DynamicResource OrbitCyanBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="TxtCatImage" Text="Зображення" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource OrbitTextPrimary}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="{DynamicResource OrbitBlueSoftBg}" CornerRadius="7" Padding="7,2">
                                                        <TextBlock x:Name="BadgeImageCount" Text="6" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource OrbitCyanBrush}" />
                                                    </Border>
                                                </Grid>
                                            </ListBoxItem>

                                            <ListBoxItem Tag="Video">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="🎬" FontSize="13.5" Foreground="{DynamicResource OrbitPurpleLightBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="TxtCatVideo" Text="Відео" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource OrbitTextPrimary}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="{DynamicResource OrbitPurpleSoftBg}" CornerRadius="7" Padding="7,2">
                                                        <TextBlock x:Name="BadgeVideoCount" Text="6" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource OrbitPurpleLightBrush}" />
                                                    </Border>
                                                </Grid>
                                            </ListBoxItem>

                                            <ListBoxItem Tag="Pdf">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="📕" FontSize="13.5" Foreground="{DynamicResource OrbitRoseLightBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="TxtCatPdf" Text="PDF" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource OrbitTextPrimary}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="{DynamicResource OrbitRoseSoftBg}" CornerRadius="7" Padding="7,2">
                                                        <TextBlock x:Name="BadgePdfCount" Text="6" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource OrbitRoseLightBrush}" />
                                                    </Border>
                                                </Grid>
                                            </ListBoxItem>

                                            <ListBoxItem Tag="Document">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="📄" FontSize="13.5" Foreground="{DynamicResource OrbitIndigoLightBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="TxtCatDocument" Text="Документи" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource OrbitTextPrimary}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="{DynamicResource OrbitIndigoSoftBg}" CornerRadius="7" Padding="7,2">
                                                        <TextBlock x:Name="BadgeDocCount" Text="8" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource OrbitIndigoLightBrush}" />
                                                    </Border>
                                                </Grid>
                                            </ListBoxItem>

                                            <ListBoxItem Tag="Presentation">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="📽️" FontSize="13.5" Foreground="{DynamicResource OrbitAmberLightBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="TxtCatPresentation" Text="Презентації" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource OrbitTextPrimary}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="{DynamicResource OrbitAmberSoftBg}" CornerRadius="7" Padding="7,2">
                                                        <TextBlock x:Name="BadgePresCount" Text="5" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource OrbitAmberLightBrush}" />
                                                    </Border>
                                                </Grid>
                                            </ListBoxItem>

                                            <ListBoxItem Tag="Spreadsheet">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="📊" FontSize="13.5" Foreground="{DynamicResource OrbitGreenLightBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="TxtCatSpreadsheet" Text="Таблиці" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource OrbitTextPrimary}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="{DynamicResource OrbitGreenSoftBg}" CornerRadius="7" Padding="7,2">
                                                        <TextBlock x:Name="BadgeSheetCount" Text="5" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource OrbitGreenLightBrush}" />
                                                    </Border>
                                                </Grid>
                                            </ListBoxItem>

                                            <ListBoxItem Tag="Archive">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="🗜️" FontSize="13.5" Foreground="{DynamicResource OrbitOrangeLightBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="TxtCatArchive" Text="Архіви" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource OrbitTextPrimary}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="{DynamicResource OrbitOrangeSoftBg}" CornerRadius="7" Padding="7,2">
                                                        <TextBlock x:Name="BadgeGenericCount" Text="4" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource OrbitOrangeLightBrush}" />
                                                    </Border>
                                                </Grid>
                                            </ListBoxItem>
                                        </ListBox>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- Колонка 2: Інтерактивний диск у фіксованій пропорції -->
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource OrbitCardStyle}" Padding="16" Margin="0,0,14,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="TxtRadialPreviewHeader" Grid.Row="0" Text="МАКЕТ РАДІАЛЬНОГО КОЛА" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource OrbitTextMuted}" HorizontalAlignment="Center" Margin="0,2,0,6" />
                                    <Viewbox Grid.Row="1" Stretch="Uniform" MaxWidth="300" MaxHeight="300" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <controls:RadialDiscControl x:Name="PreviewRadialDisc" />
                                    </Viewbox>
                                    <Button x:Name="BtnRadialTestScreen" Grid.Row="2" Content="✦  Протестувати меню на екрані" Style="{StaticResource OrbitSecondaryButton}" HorizontalAlignment="Stretch" Margin="0,8,0,0" Click="BtnRadialTestScreen_Click" />
                                </Grid>
                            </Border>

                            <!-- Колонка 3: Картковий список секторів з текстовими бейджами форматів у кольорі AccentColor -->
                            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource OrbitCardStyle}" Padding="18">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="2,0,4,12">
                                        <TextBlock x:Name="TxtRadialListHeader" Text="СЕКТОРИ ОБРАНОЇ КАТЕГОРІЇ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource OrbitTextMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="RadialActionsItemsControl">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource OrbitRecessedBgBrush}"
                                                            BorderBrush="{DynamicResource OrbitSubtleBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="12"
                                                            Padding="12,11"
                                                            Margin="0,0,8,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0"
                                                                    MinWidth="48"
                                                                    Height="36"
                                                                    Padding="7,0"
                                                                    CornerRadius="9"
                                                                    Background="{DynamicResource OrbitCardBgBrush}"
                                                                    BorderBrush="{DynamicResource OrbitCardBorderBrush}"
                                                                    BorderThickness="1"
                                                                    Margin="0,0,12,0">
                                                                <TextBlock Text="{Binding IconKey}"
                                                                           FontFamily="Bahnschrift, Segoe UI Variable Display, Segoe UI"
                                                                           FontSize="12.5"
                                                                           FontWeight="ExtraBold"
                                                                           Foreground="{Binding AccentColor}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Border>

                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                                <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource OrbitTextPrimary}" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>

                                                            <CheckBox Grid.Column="2"
                                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                      Style="{StaticResource OrbitToggleSwitch}"
                                                                      Click="RadialActionToggle_Click"
                                                                      Tag="{Binding}"
                                                                      VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ========================================================= -->
                        <!-- ЕКРАН 3: "ЖЕСТИ Й КЛАВІШІ"                                 -->
                        <!-- ========================================================= -->
                        <Grid x:Name="ScreenInput" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <!-- Картка 1 (Ліва верхня): Комбінація виклику Halo -->
                            <Border x:Name="HotkeyRecorderCard" Grid.Row="0" Grid.Column="0" Style="{StaticResource OrbitCardStyle}" Margin="0,0,8,16" Padding="22,20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <DockPanel Grid.Row="0">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource OrbitPurpleSoftBg}" Margin="0,0,10,0">
                                                <TextBlock Text="⌨️" FontSize="16" Foreground="{DynamicResource OrbitPurpleLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtInputMainHotkeyTitle" Text="Комбінація клавіш Halo" FontSize="16.5" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" />
                                                <TextBlock x:Name="TxtInputMainHotkeySub" Text="Глобальне перехоплення виклику" FontSize="11.5" Foreground="{DynamicResource OrbitTextMuted}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Border DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource OrbitPurpleSoftBg}" CornerRadius="7" Padding="10,3">
                                            <TextBlock x:Name="TxtInputPrimaryBadge" Text="Основний" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OrbitPurpleLightBrush}" />
                                        </Border>
                                    </DockPanel>

                                    <TextBlock x:Name="HotkeyRecorderHint" Grid.Row="1" Text="Натисніть кнопку запису нижче, а потім затисніть бажані клавіші на клавіатурі."
                                               FontSize="12" Foreground="{DynamicResource OrbitTextSecondary}" TextWrapping="Wrap" Margin="0,12,0,14" />

                                    <Border Grid.Row="2" Background="{DynamicResource OrbitRecessedBgBrush}" BorderBrush="{DynamicResource OrbitCardBorderBrush}" BorderThickness="1.5" CornerRadius="12" Padding="14,10" Margin="0,0,0,14">
                                        <DockPanel>
                                            <TextBlock x:Name="TxtCurrentMainHotkeyLabel" Text="Поточний хоткей:" FontSize="12" Foreground="{DynamicResource OrbitTextSecondary}" VerticalAlignment="Center" />
                                            <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="{DynamicResource OrbitPurpleSoftBg}" BorderBrush="{DynamicResource OrbitPurpleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,4">
                                                <TextBlock x:Name="HotkeyRecorderStatusText" Text="Alt+Space" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource OrbitPurpleLightBrush}" />
                                            </Border>
                                        </DockPanel>
                                    </Border>

                                    <Button x:Name="BtnRecordHotkey" Grid.Row="3" Content="Записати комбінацію з клавіатури" Style="{StaticResource OrbitPrimaryButton}" HorizontalAlignment="Left" Click="BtnRecordHotkey_Click" />
                                </Grid>
                            </Border>

                            <!-- Картка 2 (Права верхня): Ігровий режим -->
                            <Border x:Name="GameModeRecorderCard" Grid.Row="0" Grid.Column="1" Style="{StaticResource OrbitCardStyle}" Margin="8,0,0,16" Padding="22,20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <DockPanel Grid.Row="0">
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="MainWindowGameModeIconBox" Width="36" Height="36" CornerRadius="10" Background="{DynamicResource OrbitRoseSoftBg}" BorderThickness="0" Margin="0,0,10,0">
                                                <TextBlock x:Name="TxtMainWindowGameEmoji" Text="🎮" FontSize="16" Foreground="{DynamicResource OrbitRoseLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Opacity="0.75" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtInputGameModeTitle" Text="Ігровий режим (Тиша)" FontSize="16.5" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" />
                                                <TextBlock x:Name="TxtInputGameModeSub" Text="Пауза всіх тригерів у іграх" FontSize="11.5" Foreground="{DynamicResource OrbitTextMuted}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <CheckBox x:Name="CheckPauseGestures" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource OrbitToggleSwitch}" Click="CheckPauseGestures_Click" />
                                    </DockPanel>

                                    <TextBlock x:Name="GameModeRecorderHint" Grid.Row="1" Text="Ви можете вмикати та вимикати Ігровий режим будь-коли гарячою комбінацією клавіш:"
                                               FontSize="12" Foreground="{DynamicResource OrbitTextSecondary}" TextWrapping="Wrap" Margin="0,12,0,14" />

                                    <Border Grid.Row="2" Background="{DynamicResource OrbitRecessedBgBrush}" BorderBrush="{DynamicResource OrbitCardBorderBrush}" BorderThickness="1.5" CornerRadius="12" Padding="14,10" Margin="0,0,0,14">
                                        <DockPanel>
                                            <TextBlock x:Name="TxtCurrentGameHotkeyLabel" Text="Поточний хоткей:" FontSize="12" Foreground="{DynamicResource OrbitTextSecondary}" VerticalAlignment="Center" />
                                            <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="{DynamicResource OrbitRoseSoftBg}" BorderBrush="{DynamicResource OrbitRoseBrush}" BorderThickness="1" CornerRadius="8" Padding="12,4">
                                                <TextBlock x:Name="GameModeHotkeyStatusText" Text="Alt+G" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource OrbitRoseLightBrush}" />
                                            </Border>
                                        </DockPanel>
                                    </Border>

                                    <Button x:Name="BtnRecordGameModeHotkey" Grid.Row="3" Content="Записати комбінацію з клавіатури" Style="{StaticResource OrbitPrimaryButton}" HorizontalAlignment="Left" Click="BtnRecordGameModeHotkey_Click" />
                                </Grid>
                            </Border>

                            <!-- Картка 3 (Ліва середня): Жест струшування (Shake) -->
                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource OrbitCardStyle}" Margin="0,0,8,16" Padding="20,18">
                                <DockPanel>
                                    <Border Width="42" Height="42" CornerRadius="11" Background="{DynamicResource OrbitBlueSoftBg}" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="👋" FontSize="19" Foreground="{DynamicResource OrbitCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <CheckBox x:Name="ToggleShakeGesture" IsChecked="True" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource OrbitToggleSwitch}" VerticalAlignment="Center" Click="ToggleShakeGesture_Click" />
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock x:Name="TxtShakeTitle" Text="Струшування мишею (Shake)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" />
                                        <TextBlock x:Name="TxtShakeDesc" Text="Швидко потрусіть курсор вліво-вправо, щоб викликати радіальне меню для виділеного файлу" FontSize="12" Foreground="{DynamicResource OrbitTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Картка 4 (Права середня): Середня кнопка миші -->
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource OrbitCardStyle}" Margin="8,0,0,16" Padding="20,18">
                                <DockPanel>
                                    <Border Width="42" Height="42" CornerRadius="11" Background="{DynamicResource OrbitGreenSoftBg}" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="🖱️" FontSize="19" Foreground="{DynamicResource OrbitGreenLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <CheckBox x:Name="ToggleMiddleMouse" IsChecked="True" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource OrbitToggleSwitch}" VerticalAlignment="Center" Click="ToggleMiddleMouse_Click" />
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock x:Name="TxtMiddleMouseTitle" Text="Клік коліщатком миші" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" />
                                        <TextBlock x:Name="TxtMiddleMouseDesc" Text="Виклик радіального меню натисканням середньої кнопки миші" FontSize="12" Foreground="{DynamicResource OrbitTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Картка 5 (Нижня панель скидання до стандартних налаштувань) -->
                            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource OrbitCardStyle}" Padding="20,14">
                                <DockPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtResetTriggersTitle" Text="Скидання налаштувань керування" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" />
                                        <TextBlock x:Name="TxtResetTriggersDesc" Text="Повернути стандартні комбінації (Alt+Space та Alt+G) і увімкнути всі жести миші" FontSize="12" Foreground="{DynamicResource OrbitTextMuted}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button x:Name="BtnResetTriggers" DockPanel.Dock="Right" HorizontalAlignment="Right" Content="↺  Скинути до стандартних налаштувань" Style="{StaticResource OrbitSecondaryButton}" Click="BtnResetTriggers_Click" />
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- ========================================================= -->
                        <!-- ЕКРАН 4: "ВІДСТЕЖЕННЯ ПАПОК" (РОЗШИРЕНА АВТОМАТИЗАЦІЯ)     -->
                        <!-- ========================================================= -->
                        <Grid x:Name="ScreenFolders" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Інформаційна картка + кнопка обробки всіх папок -->
                            <Border Grid.Row="0" Background="{DynamicResource OrbitHeroBannerGradient}" BorderBrush="{DynamicResource OrbitHeroBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18,12" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="{DynamicResource OrbitHeroBadgeBgBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="💡" FontSize="17" Foreground="{DynamicResource OrbitAmberLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock x:Name="TxtFoldersHeroTitle" Text="Автоматичний моніторинг та розумна обробка каталогів" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource OrbitHeroTitleBrush}" />
                                        <TextBlock x:Name="TxtFoldersHeroDesc" Text="Halo стежить за папками у фоні: автоматично сортує завантаження, пакує та розпаковує архіви, конвертує фото й документи або очищує тимчасові файли."
                                                   FontSize="12" Foreground="{DynamicResource OrbitHeroDescBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button x:Name="BtnProcessAllFolders" Grid.Column="2" Content="▶ Обробити всі активні" Style="{StaticResource OrbitPrimaryButton}" Padding="14,8" VerticalAlignment="Center" Click="BtnProcessAllFolders_Click" />
                                </Grid>
                            </Border>

                            <!-- Розширена картка створення правила моніторингу -->
                            <Border Grid.Row="1" Style="{StaticResource OrbitCardStyle}" Padding="18,14" Margin="0,0,0,14">
                                <StackPanel>
                                    <!-- Верхній рядок: Заголовок + Швидкі пресети папок + Огляд -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource OrbitAmberSoftBg}" Margin="0,0,10,0">
                                                <TextBlock Text="📂" FontSize="14" Foreground="{DynamicResource OrbitAmberLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtAddFolderTitle" Text="Нове правило автоматизації" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" />
                                                <TextBlock x:Name="TxtAddFolderSub" Text="Оберіть папку, фільтр файлів, дію та додаткові параметри" FontSize="11.5" Foreground="{DynamicResource OrbitTextSecondary}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="BtnPresetDownloads" Content="⬇ Завантаження" Style="{StaticResource OrbitSecondaryButton}" Padding="10,5" FontSize="11.5" Margin="0,0,6,0" Tag="Downloads" Click="BtnFolderPreset_Click" />
                                            <Button x:Name="BtnPresetDesktop" Content="🖥 Робочий стіл" Style="{StaticResource OrbitSecondaryButton}" Padding="10,5" FontSize="11.5" Margin="0,0,6,0" Tag="Desktop" Click="BtnFolderPreset_Click" />
                                            <Button x:Name="BtnPresetDocuments" Content="📄 Документи" Style="{StaticResource OrbitSecondaryButton}" Padding="10,5" FontSize="11.5" Margin="0,0,6,0" Tag="Documents" Click="BtnFolderPreset_Click" />
                                            <Button x:Name="BtnBrowseFolder" Content="📁 Огляд..." Style="{StaticResource OrbitSecondaryButton}" Padding="12,5" FontSize="11.5" Click="BtnAddFolder_Click" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Середній рядок: Вхідна папка + Фільтр + Дія + Додати -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="175" />
                                            <ColumnDefinition Width="255" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox x:Name="QuickFolderInput" Grid.Column="0" Text="" Style="{StaticResource OrbitTextBoxStyle}" Margin="0,0,8,0" />

                                        <ComboBox x:Name="QuickFilterCombo" Grid.Column="1" Margin="0,0,8,0" SelectedIndex="0">
                                            <ComboBoxItem x:Name="FilterItemAll" Content="Усі файли (*.*)" Tag="*.*" />
                                            <ComboBoxItem x:Name="FilterItemImages" Content="Тільки зображення" Tag="images" />
                                            <ComboBoxItem x:Name="FilterItemDocs" Content="Тільки документи" Tag="docs" />
                                            <ComboBoxItem x:Name="FilterItemArchives" Content="Тільки архіви" Tag="archives" />
                                            <ComboBoxItem x:Name="FilterItemVideos" Content="Тільки відео" Tag="videos" />
                                        </ComboBox>

                                        <ComboBox x:Name="QuickActionCombo" Grid.Column="2" Margin="0,0,8,0" SelectedIndex="0">
                                            <ComboBoxItem x:Name="RuleActAutoSort" Content="Авто-сортування по підпапках" Tag="folder_auto_sort" />
                                            <ComboBoxItem x:Name="RuleActZip" Content="Стискати нові файли у ZIP" Tag="compress_to_zip" />
                                            <ComboBoxItem x:Name="RuleActExtract" Content="Авто-розпакування архівів" Tag="extract_archive" />
                                            <ComboBoxItem x:Name="RuleActPng" Content="Конвертувати фото у PNG" Tag="image_to_png" />
                                            <ComboBoxItem x:Name="RuleActJpg" Content="Конвертувати фото у JPG" Tag="image_to_jpg" />
                                            <ComboBoxItem x:Name="RuleActWebp" Content="Конвертувати фото у WEBP" Tag="image_to_webp" />
                                            <ComboBoxItem x:Name="RuleActPdf" Content="Конвертувати у PDF" Tag="doc_to_pdf" />
                                            <ComboBoxItem x:Name="RuleActCompressImg" Content="Стискати нові зображення" Tag="image_compress" />
                                            <ComboBoxItem x:Name="RuleActCleanTemp" Content="Очищення тимчасових файлів" Tag="clean_temp_files" />
                                        </ComboBox>

                                        <Button x:Name="BtnQuickAddRule" Grid.Column="3" Content="➕  Додати правило" Style="{StaticResource OrbitPrimaryButton}" Click="BtnQuickAddRule_Click" />
                                    </Grid>

                                    <!-- Нижній рядок опцій: Цільова папка + Підпапки + Видаляти оригінал -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock x:Name="TxtTargetFolderLabel" Grid.Column="0" Text="Папка збереження (опційно):" FontSize="11.5" Foreground="{DynamicResource OrbitTextSecondary}" VerticalAlignment="Center" Margin="2,0,8,0" />
                                        <TextBox x:Name="QuickTargetFolderInput" Grid.Column="1" Text="" Style="{StaticResource OrbitTextBoxStyle}" Padding="10,5" FontSize="12" Margin="0,0,6,0" />
                                        <Button x:Name="BtnBrowseTargetFolder" Grid.Column="2" Content="📁" Style="{StaticResource OrbitSecondaryButton}" Padding="10,5" Margin="0,0,16,0" Click="BtnBrowseTargetFolder_Click" />

                                        <CheckBox x:Name="CheckFolderSubdirs" Grid.Column="3" Style="{StaticResource OrbitToggleSwitch}" Margin="0,0,16,0">
                                            <TextBlock x:Name="TxtCheckSubdirs" Text="Включаючи підпапки" FontSize="11.5" Foreground="{DynamicResource OrbitTextSecondary}" />
                                        </CheckBox>

                                        <CheckBox x:Name="CheckFolderDeleteSource" Grid.Column="4" Style="{StaticResource OrbitToggleSwitch}">
                                            <TextBlock x:Name="TxtCheckDeleteSource" Text="Видаляти оригінал" FontSize="11.5" Foreground="{DynamicResource OrbitTextSecondary}" />
                                        </CheckBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Картковий список активних папок -->
                            <Grid Grid.Row="2">
                                <StackPanel x:Name="EmptyFoldersPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" Visibility="Collapsed">
                                    <Border Width="50" Height="50" CornerRadius="14" Background="{DynamicResource OrbitAmberSoftBg}" HorizontalAlignment="Center" Margin="0,0,0,12">
                                        <TextBlock Text="📂" FontSize="22" Foreground="{DynamicResource OrbitAmberLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock x:Name="EmptyFoldersTitleText" Text="Немає активних правил відстеження"
                                               FontSize="15" FontWeight="Bold"
                                               Foreground="{DynamicResource OrbitTextPrimary}"
                                               HorizontalAlignment="Center" Margin="0,0,0,5" />
                                    <TextBlock x:Name="EmptyFoldersDescText"
                                               Text="Додайте каталог вище через «Додати правило», щоб Halo автоматично сортувала або конвертувала нові файли."
                                               Foreground="{DynamicResource OrbitTextSecondary}"
                                               FontSize="12" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
                                </StackPanel>

                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="FoldersRulesItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource OrbitCardStyle}" Padding="16,12" Margin="0,0,0,9">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="{DynamicResource OrbitAmberSoftBg}" Margin="0,0,14,0" VerticalAlignment="Center">
                                                            <TextBlock Text="📂" FontSize="17" Foreground="{DynamicResource OrbitAmberLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding FolderPath}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" TextTrimming="CharacterEllipsis" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <TextBlock Text="{Binding ActionDisplayName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OrbitAmberLightBrush}" />
                                                                <TextBlock Text="  •  " FontSize="11.5" Foreground="{DynamicResource OrbitTextMuted}" />
                                                                <TextBlock Text="{Binding OptionsSummary}" FontSize="11.5" Foreground="{DynamicResource OrbitTextSecondary}" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <Button Grid.Column="2" Content="{Binding RunNowButtonText}" Style="{StaticResource OrbitSecondaryButton}" Padding="11,6" FontSize="12" Margin="0,0,6,0"
                                                                Tag="{Binding}" Click="BtnRunFolderRuleNow_Click" />

                                                        <Button Grid.Column="3" Content="{Binding OpenFolderButtonText}" Style="{StaticResource OrbitSecondaryButton}" Padding="11,6" FontSize="12" Margin="0,0,6,0"
                                                                Tag="{Binding}" Click="BtnOpenWatchedFolder_Click" />

                                                        <Button Grid.Column="4" Content="{Binding DeleteButtonText}" Style="{StaticResource OrbitSecondaryButton}" Padding="11,6" FontSize="12" Margin="0,0,12,0"
                                                                Tag="{Binding}" Click="BtnDeleteFolderRule_Click" />

                                                        <CheckBox Grid.Column="5" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                  Style="{StaticResource OrbitToggleSwitch}" Tag="{Binding}" Click="FolderRuleToggle_Click" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>

                        <!-- ========================================================= -->
                        <!-- ЕКРАН 5: "НАЛАШТУВАННЯ ТА ГІД" (POWERSHELL-ЗАЛЕЖНОСТІ, ГІД) -->
                        <!-- ========================================================= -->
                        <Grid x:Name="ScreenSettings" Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Виразний перемикач підвкладок: Налаштування та Повна Інструкція / Гід -->
                                <Border Grid.Row="0" Margin="0,0,0,18" HorizontalAlignment="Left" Background="{DynamicResource OrbitRecessedBgBrush}" CornerRadius="14" Padding="5" BorderBrush="{DynamicResource OrbitCardBorderBrush}" BorderThickness="1.2">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.35" />
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="SettingsTabParams" Content="⚙️  Параметри системи" Style="{StaticResource OrbitSettingsTabRadioStyle}" IsChecked="True" Checked="SettingsSubTab_Checked" Tag="Params" Margin="0,0,4,0" />
                                        <RadioButton x:Name="SettingsTabGuide" Content="📖  Інструкція та Гід Halo" Style="{StaticResource OrbitSettingsTabRadioStyle}" Checked="SettingsSubTab_Checked" Tag="Guide" />
                                    </StackPanel>
                                </Border>

                                <!-- 1. Панель налаштувань -->
                                <ScrollViewer x:Name="SettingsParamsPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                                <StackPanel>
                                    <!-- Картка Додаткових програм (Встановлення виключно через PowerShell без браузера) -->
                                    <Border Style="{StaticResource OrbitCardStyle}" Margin="0,0,0,18" Padding="22,18">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,14" MinHeight="56">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="{DynamicResource OrbitPurpleSoftBg}" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="🧩" FontSize="17" Foreground="{DynamicResource OrbitPurpleLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                                    <TextBlock x:Name="TxtSettingsDepsTitle" Text="Додаткові програми (Встановлення через PowerShell)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="TxtSettingsDepsSub" Text="Автоматичне встановлення інструментів через PowerShell за вашою ініціативою (без відкриття браузера)" FontSize="12" Foreground="{DynamicResource OrbitTextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Border x:Name="BadgeRefreshFeedback" Background="{DynamicResource OrbitGreenSoftBg}" BorderBrush="{DynamicResource OrbitGreenLightBrush}" BorderThickness="1" CornerRadius="10" Padding="10,5" Margin="0,0,10,0" Visibility="Hidden" Opacity="0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                             <TextBlock Text="✓ " FontWeight="Bold" Foreground="{DynamicResource OrbitGreenLightBrush}" FontSize="12" />
                                                             <TextBlock x:Name="TxtRefreshFeedback" Text="Перевірено" Foreground="{DynamicResource OrbitGreenLightBrush}" FontSize="11" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Button x:Name="BtnRefreshDeps" Width="180" HorizontalAlignment="Right" VerticalAlignment="Center" Content="↺  Перевірити статус" Style="{StaticResource OrbitSecondaryButton}" Padding="12,6" Click="BtnRefreshDependencies_Click" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- 1. Pandoc CLI -->
                                            <Border Background="{DynamicResource OrbitRecessedBgBrush}" BorderBrush="{DynamicResource OrbitSubtleBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="9" Background="{DynamicResource OrbitGreenSoftBg}" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="📚" FontSize="16" Foreground="{DynamicResource OrbitGreenLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock x:Name="TxtDepPandocTitle" Text="Pandoc CLI (Документи)" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" />
                                                        <TextBlock x:Name="TxtDepPandocDesc" Text="Рушій для розширеної конвертації та верстки документів (MD, DOCX, HTML, PDF). Встановлюється напряму через PowerShell." FontSize="11.5" Foreground="{DynamicResource OrbitTextMuted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <Border x:Name="BadgePandocStatus" Grid.Column="2" Background="{DynamicResource OrbitRoseSoftBg}" CornerRadius="7" Padding="10,4" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock x:Name="TxtPandocStatus" Text="Відсутнє" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource OrbitRoseLightBrush}" />
                                                    </Border>
                                                    <Button x:Name="BtnInstallPandoc" Grid.Column="3" Content="⚡ Встановити (PowerShell)" Style="{StaticResource OrbitPrimaryButton}" Padding="14,6" VerticalAlignment="Center" Click="BtnInstallPandoc_Click" />
                                                </Grid>
                                            </Border>

                                            <!-- 2. FFmpeg -->
                                            <Border Background="{DynamicResource OrbitRecessedBgBrush}" BorderBrush="{DynamicResource OrbitSubtleBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="9" Background="{DynamicResource OrbitPurpleSoftBg}" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="🎬" FontSize="16" Foreground="{DynamicResource OrbitPurpleLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock x:Name="TxtDepFfmpegTitle" Text="FFmpeg (Відео та Аудіо)" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" />
                                                        <TextBlock x:Name="TxtDepFfmpegDesc" Text="Необхідний для конвертації та обробки відео (MP4, MOV, MKV, WEBM, GIF, MP3). Встановлюється напряму через PowerShell." FontSize="11.5" Foreground="{DynamicResource OrbitTextMuted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <Border x:Name="BadgeFfmpegStatus" Grid.Column="2" Background="{DynamicResource OrbitRoseSoftBg}" CornerRadius="7" Padding="10,4" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock x:Name="TxtFfmpegStatus" Text="Відсутнє" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource OrbitRoseLightBrush}" />
                                                    </Border>
                                                    <Button x:Name="BtnInstallFfmpeg" Grid.Column="3" Content="⚡ Встановити (PowerShell)" Style="{StaticResource OrbitPrimaryButton}" Padding="14,6" VerticalAlignment="Center" Click="BtnInstallFfmpeg_Click" />
                                                </Grid>
                                            </Border>

                                            <!-- 3. LibreOffice -->
                                            <Border Background="{DynamicResource OrbitRecessedBgBrush}" BorderBrush="{DynamicResource OrbitSubtleBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="9" Background="{DynamicResource OrbitBlueSoftBg}" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="📑" FontSize="16" Foreground="{DynamicResource OrbitCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock x:Name="TxtDepLibreTitle" Text="LibreOffice (Офісні формати)" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" />
                                                        <TextBlock x:Name="TxtDepLibreDesc" Text="Рушій для офісних форматів (DOC, PPTX, ODS, ODP) та точного експорту PDF. Встановлюється напряму через PowerShell." FontSize="11.5" Foreground="{DynamicResource OrbitTextMuted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <Border x:Name="BadgeLibreOfficeStatus" Grid.Column="2" Background="{DynamicResource OrbitRoseSoftBg}" CornerRadius="7" Padding="10,4" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock x:Name="TxtLibreOfficeStatus" Text="Відсутнє" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource OrbitRoseLightBrush}" />
                                                    </Border>
                                                    <Button x:Name="BtnInstallLibreOffice" Grid.Column="3" Content="⚡ Встановити (PowerShell)" Style="{StaticResource OrbitPrimaryButton}" Padding="14,6" VerticalAlignment="Center" Click="BtnInstallLibreOffice_Click" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <UniformGrid Columns="2" Rows="2" VerticalAlignment="Top">
                                        <!-- Картка 1: Мова та інтерфейс (Тільки Українська та English, без польської!) -->
                                        <Border Style="{StaticResource OrbitCardStyle}" Margin="0,0,10,18" Padding="22">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,12">
                                                    <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource OrbitPurpleSoftBg}">
                                                        <TextBlock Text="🌍" FontSize="17" Foreground="{DynamicResource OrbitPurpleLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <Border DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource OrbitPurpleSoftBg}" CornerRadius="7" Padding="10,3">
                                                        <TextBlock x:Name="TxtSettingsLangBadge" Text="Локалізація" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OrbitPurpleLightBrush}" />
                                                    </Border>
                                                </DockPanel>
                                                <TextBlock x:Name="TxtSettingsLangTitle" Text="Мова інтерфейсу" FontSize="16.5" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" />
                                                <TextBlock x:Name="TxtSettingsLangSub" Text="Миттєва зміна мови всіх меню та підписів" FontSize="12" Foreground="{DynamicResource OrbitTextSecondary}" Margin="0,4,0,14" />
                                                <ComboBox x:Name="LanguageCombo" SelectedIndex="0" SelectionChanged="LanguageCombo_SelectionChanged">
                                                    <ComboBoxItem x:Name="LangItemUk" Content="Українська (Основна)" Tag="uk" />
                                                    <ComboBoxItem x:Name="LangItemEn" Content="English (US)" Tag="en" />
                                                </ComboBox>
                                            </StackPanel>
                                        </Border>

                                        <!-- Картка 2: Тема та візуальний стиль -->
                                        <Border Style="{StaticResource OrbitCardStyle}" Margin="10,0,0,18" Padding="22">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,12">
                                                    <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource OrbitBlueSoftBg}">
                                                        <TextBlock Text="🎨" FontSize="17" Foreground="{DynamicResource OrbitCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <Border DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource OrbitBlueSoftBg}" CornerRadius="7" Padding="10,3">
                                                        <TextBlock x:Name="TxtSettingsThemeBadge" Text="Оформлення" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OrbitCyanBrush}" />
                                                    </Border>
                                                </DockPanel>
                                                <TextBlock x:Name="TxtSettingsThemeTitle" Text="Кольорова тема Halo" FontSize="16.5" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" />
                                                <TextBlock x:Name="TxtSettingsThemeSub" Text="Налаштування палітри вікна та карток у реальному часі" FontSize="12" Foreground="{DynamicResource OrbitTextSecondary}" Margin="0,4,0,14" />
                                                <ComboBox x:Name="GeneralThemeCombo" SelectedIndex="0" SelectionChanged="GeneralThemeCombo_SelectionChanged" PreviewMouseWheel="GeneralThemeCombo_PreviewMouseWheel">
                                                    <ComboBoxItem x:Name="ThemeItemDark" Content="Темна" Tag="Dark" />
                                                    <ComboBoxItem x:Name="ThemeItemIndigo" Content="Глибоко-синя" Tag="Indigo" />
                                                    <ComboBoxItem x:Name="ThemeItemLight" Content="Світла" Tag="Light" />
                                                </ComboBox>
                                            </StackPanel>
                                        </Border>

                                        <!-- Картка 3: Автозапуск та Провідник Windows -->
                                        <Border Style="{StaticResource OrbitCardStyle}" Margin="0,0,10,0" Padding="22">
                                            <StackPanel>
                                                <TextBlock x:Name="TxtSettingsWinTitle" Text="Інтеграція з Windows" FontSize="16.5" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" Margin="0,0,0,14" />

                                                <Grid Margin="0,0,0,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                                        <TextBlock x:Name="TxtAutostartTitle" Text="Запускати разом із Windows" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource OrbitTextPrimary}" TextWrapping="Wrap" />
                                                        <TextBlock x:Name="TxtAutostartDesc" Text="Автоматичний старт програми при вході в систему" FontSize="11.5" Foreground="{DynamicResource OrbitTextMuted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <CheckBox x:Name="ToggleAutostart" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource OrbitToggleSwitch}" Click="ToggleAutostart_Click" />
                                                </Grid>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                                        <TextBlock x:Name="TxtExplorerMenuTitle" Text="Контекстне меню провідника Windows" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource OrbitTextPrimary}" TextWrapping="Wrap" />
                                                        <TextBlock x:Name="TxtExplorerMenuDesc" Text="Додати пункт «Відкрити в Halo» при натисканні правою кнопкою миші на файлі чи папці" FontSize="11.5" Foreground="{DynamicResource OrbitTextMuted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <CheckBox x:Name="ToggleExplorerMenu" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource OrbitToggleSwitch}" Click="ToggleExplorerMenu_Click" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Картка 4: Поведінка збереження та анімацій -->
                                        <Border Style="{StaticResource OrbitCardStyle}" Margin="10,0,0,0" Padding="22">
                                            <StackPanel>
                                                <TextBlock x:Name="TxtSettingsBehaviorTitle" Text="Поведінка та швидкодія" FontSize="16.5" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" Margin="0,0,0,14" />

                                                <Grid Margin="0,0,0,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                                        <TextBlock x:Name="TxtAutoHideTitle" Text="Автоматично ховати меню після дії" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource OrbitTextPrimary}" TextWrapping="Wrap" />
                                                        <TextBlock x:Name="TxtAutoHideDesc" Text="Закривати радіальне коло одразу після обробки файлу" FontSize="11.5" Foreground="{DynamicResource OrbitTextMuted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <CheckBox x:Name="ToggleAutoHide" Grid.Column="1" IsChecked="True" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource OrbitToggleSwitch}" Click="ToggleAutoHide_Click" />
                                                </Grid>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                                        <TextBlock x:Name="TxtSmoothAnimTitle" Text="Плавні анімації переходів та секторів" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource OrbitTextPrimary}" TextWrapping="Wrap" />
                                                        <TextBlock x:Name="TxtSmoothAnimDesc" Text="Анімація появи меню та перемикання вкладок" FontSize="11.5" Foreground="{DynamicResource OrbitTextMuted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <CheckBox x:Name="ToggleSmoothAnim" Grid.Column="1" IsChecked="True" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource OrbitToggleSwitch}" Click="ToggleSmoothAnim_Click" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- 2. Панель Інструкції та Гіда користувача -->
                            <ScrollViewer x:Name="SettingsGuidePanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0" Visibility="Collapsed">
                                <StackPanel>
                                    <!-- Вступний банер гіда -->
                                    <Border Style="{StaticResource OrbitCardStyle}" Margin="0,0,0,16" Padding="22,18">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <Border Background="{DynamicResource OrbitHeroBadgeBgBrush}" CornerRadius="8" Padding="10,4" HorizontalAlignment="Left" Margin="0,0,0,8">
                                                    <TextBlock x:Name="TxtGuideBadge" Text="✦  ІНСТРУКЦІЯ ТА ГІД КОРИСТУВАЧА" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource OrbitHeroBadgeTextBrush}" />
                                                </Border>
                                                <TextBlock x:Name="TxtGuideTitle" Text="Як ефективно працювати з Halo" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" />
                                                <TextBlock x:Name="TxtGuideDesc" Text="Повний огляд можливостей: швидкий виклик меню, клавіші режимів, автоматичне сортування папок та скасування операцій."
                                                           FontSize="12.5" Foreground="{DynamicResource OrbitTextSecondary}" Margin="0,5,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Width="44" Height="44" CornerRadius="12" Background="{DynamicResource OrbitPurpleSoftBg}" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <TextBlock Text="📖" FontSize="20" Foreground="{DynamicResource OrbitPurpleLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- 1. Способи виклику та жести миші -->
                                    <Border Style="{StaticResource OrbitCardStyle}" Margin="0,0,0,16" Padding="22,18">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="{DynamicResource OrbitBlueSoftBg}" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="🎯" FontSize="17" Foreground="{DynamicResource OrbitCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtGuideS1Title" Text="1. Способи виклику меню Halo" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" />
                                                    <TextBlock x:Name="TxtGuideS1Sub" Text="Миттєвий доступ до операцій з будь-якого вікна Windows" FontSize="12" Foreground="{DynamicResource OrbitTextSecondary}" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Border Grid.Column="2" Background="{DynamicResource OrbitBlueSoftBg}" CornerRadius="7" Padding="10,3" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtGuideBadgeNav" Text="Навігація" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OrbitCyanBrush}" />
                                                </Border>
                                            </Grid>

                                            <!-- 4 варіанти виклику -->
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{DynamicResource OrbitRecessedBgBrush}" CornerRadius="10" Padding="14,12" Margin="0,0,6,0" BorderBrush="{DynamicResource OrbitSubtleBorderBrush}" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock x:Name="TxtGuideHotkeysTitle" Text="⌨️ Гаряча комбінація клавіш" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource OrbitTextPrimary}" />
                                                        <TextBlock x:Name="TxtGuideHotkeysDesc" Text="Натисніть Alt + Space (або власну комбінацію) над будь-яким виділеним файлом чи у вікні Провідника." FontSize="11.5" Foreground="{DynamicResource OrbitTextMuted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="1" Background="{DynamicResource OrbitRecessedBgBrush}" CornerRadius="10" Padding="14,12" Margin="6,0,0,0" BorderBrush="{DynamicResource OrbitSubtleBorderBrush}" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock x:Name="TxtGuideShakeTitle" Text="🌀 Жест струшування (Shake)" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource OrbitTextPrimary}" />
                                                        <TextBlock x:Name="TxtGuideShakeDesc" Text="Затисніть файл лівою кнопкою миші та швидко струсніть курсором — меню одразу відкриється біля файлу." FontSize="11.5" Foreground="{DynamicResource OrbitTextMuted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{DynamicResource OrbitRecessedBgBrush}" CornerRadius="10" Padding="14,12" Margin="0,0,6,0" BorderBrush="{DynamicResource OrbitSubtleBorderBrush}" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock x:Name="TxtGuideMiddleMouseTitle" Text="🖱️ Середня кнопка миші" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource OrbitTextPrimary}" />
                                                        <TextBlock x:Name="TxtGuideMiddleMouseDesc" Text="Одне клацання коліщатком миші над обраним елементом одразу відкриває коло дій." FontSize="11.5" Foreground="{DynamicResource OrbitTextMuted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="1" Background="{DynamicResource OrbitRecessedBgBrush}" CornerRadius="10" Padding="14,12" Margin="6,0,0,0" BorderBrush="{DynamicResource OrbitSubtleBorderBrush}" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock x:Name="TxtGuideExplorerTitle" Text="📁 Меню Провідника Windows" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource OrbitTextPrimary}" />
                                                        <TextBlock x:Name="TxtGuideExplorerDesc" Text="Клацніть правою кнопкою миші на файлі чи папці та виберіть «Відкрити в Halo»." FontSize="11.5" Foreground="{DynamicResource OrbitTextMuted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- 2. Три режими секторів -->
                                    <Border Style="{StaticResource OrbitCardStyle}" Margin="0,0,0,16" Padding="22,18">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="{DynamicResource OrbitPurpleSoftBg}" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="⚡" FontSize="17" Foreground="{DynamicResource OrbitPurpleLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtGuideS2Title" Text="2. Три режими роботи меню (Модифікатори Shift / Ctrl / Alt)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" />
                                                    <TextBlock x:Name="TxtGuideS2Sub" Text="Миттєве перемикання функціоналу прямо під час відкритого меню" FontSize="12" Foreground="{DynamicResource OrbitTextSecondary}" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Border Grid.Column="2" Background="{DynamicResource OrbitPurpleSoftBg}" CornerRadius="7" Padding="10,3" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtGuideBadgeKeys" Text="Клавіші" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OrbitPurpleLightBrush}" />
                                                </Border>
                                            </Grid>

                                            <StackPanel>
                                                <!-- Режим 1: Конвертація -->
                                                <Border Background="{DynamicResource OrbitRecessedBgBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,0,8" BorderBrush="{DynamicResource OrbitSubtleBorderBrush}" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="{DynamicResource OrbitPurpleSoftBg}" CornerRadius="7" Padding="8,3" VerticalAlignment="Center" Margin="0,0,12,0">
                                                            <TextBlock Text="Shift" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource OrbitPurpleLightBrush}" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock x:Name="TxtGuideModeShiftTitle" Text="⚡ Конвертація форматів" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource OrbitTextPrimary}" />
                                                            <TextBlock x:Name="TxtGuideModeShiftDesc" Text="Миттєве перетворення: зображення (JPG, PNG, WebP, AVIF, TIFF, ICO), документи у PDF або DOCX, аудіо та відео формати." FontSize="11.5" Foreground="{DynamicResource OrbitTextMuted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- Режим 2: Інструменти -->
                                                <Border Background="{DynamicResource OrbitRecessedBgBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,0,8" BorderBrush="{DynamicResource OrbitSubtleBorderBrush}" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="{DynamicResource OrbitGreenSoftBg}" CornerRadius="7" Padding="8,3" VerticalAlignment="Center" Margin="0,0,12,0">
                                                            <TextBlock Text="Ctrl" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource OrbitGreenLightBrush}" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock x:Name="TxtGuideModeCtrlTitle" Text="🛠️ Професійні інструменти" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource OrbitTextPrimary}" />
                                                            <TextBlock x:Name="TxtGuideModeCtrlDesc" Text="Стиснення без втрати якості, розпізнавання тексту OCR, обрізка відео, видалення дублікатів з Excel/CSV, транспонування та сортування таблиць." FontSize="11.5" Foreground="{DynamicResource OrbitTextMuted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- Режим 3: Дії -->
                                                <Border Background="{DynamicResource OrbitRecessedBgBrush}" CornerRadius="10" Padding="14,10" BorderBrush="{DynamicResource OrbitSubtleBorderBrush}" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="{DynamicResource OrbitAmberSoftBg}" CornerRadius="7" Padding="8,3" VerticalAlignment="Center" Margin="0,0,12,0">
                                                            <TextBlock Text="Alt" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource OrbitAmberLightBrush}" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock x:Name="TxtGuideModeAltTitle" Text="🚀 Швидкі системні дії" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource OrbitTextPrimary}" />
                                                            <TextBlock x:Name="TxtGuideModeAltDesc" Text="Копіювання абсолютного шляху, запуск PowerShell у каталозі файлу, переміщення/копіювання у призначені папки, закріплення на Полицю." FontSize="11.5" Foreground="{DynamicResource OrbitTextMuted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- 3. Відстеження папок та Журнал операцій -->
                                    <Border Style="{StaticResource OrbitCardStyle}" Margin="0,0,0,16" Padding="22,18">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="{DynamicResource OrbitAmberSoftBg}" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="📂" FontSize="17" Foreground="{DynamicResource OrbitAmberLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtGuideS3Title" Text="3. Автоматизація папок та Журнал операцій" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" />
                                                    <TextBlock x:Name="TxtGuideS3Sub" Text="Фонова обробка завантажень із детальним журналом дій" FontSize="12" Foreground="{DynamicResource OrbitTextSecondary}" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Border Grid.Column="2" Background="{DynamicResource OrbitAmberSoftBg}" CornerRadius="7" Padding="10,3" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtGuideBadgeAuto" Text="Автоматизація" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OrbitAmberLightBrush}" />
                                                </Border>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{DynamicResource OrbitRecessedBgBrush}" CornerRadius="10" Padding="14,12" Margin="0,0,6,0" BorderBrush="{DynamicResource OrbitSubtleBorderBrush}" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock x:Name="TxtGuideAutoSortTitle" Text="🤖 Розумне сортування файлів" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource OrbitTextPrimary}" />
                                                        <TextBlock x:Name="TxtGuideAutoSortDesc" Text="Halo автоматично слідкує за вибраними папками (наприклад, Завантаження) і самостійно розкладає файли у підпапки «Документи», «Зображення», «Відео», «Архіви»." FontSize="11.5" Foreground="{DynamicResource OrbitTextMuted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="1" Background="{DynamicResource OrbitRecessedBgBrush}" CornerRadius="10" Padding="14,12" Margin="6,0,0,0" BorderBrush="{DynamicResource OrbitSubtleBorderBrush}" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock x:Name="TxtGuideLogTitle" Text="📜 Журнал дій у реальному часі" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource OrbitTextPrimary}" />
                                                        <TextBlock x:Name="TxtGuideLogDesc" Text="Усі переміщення, автоматичні сортування та перетворення файлів миттєво фіксуються в журналі операцій на Головній, щоб ви завжди знали точний час та статус обробки кожного файлу." FontSize="11.5" Foreground="{DynamicResource OrbitTextMuted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- 4. Полиця файлів (File Shelf) -->
                                    <Border Style="{StaticResource OrbitCardStyle}" Margin="0,0,0,16" Padding="22,18">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="{DynamicResource OrbitBlueSoftBg}" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="📌" FontSize="17" Foreground="{DynamicResource OrbitCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtGuideS4Title" Text="4. Полиця файлів (File Shelf — швидкий буфер)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" />
                                                    <TextBlock x:Name="TxtGuideS4Sub" Text="Компактна плаваюча панель для тимчасового закріплення документів та фото" FontSize="12" Foreground="{DynamicResource OrbitTextSecondary}" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Border Grid.Column="2" Background="{DynamicResource OrbitBlueSoftBg}" CornerRadius="7" Padding="10,3" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtGuideBadgeBuffer" Text="Буфер" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OrbitCyanBrush}" />
                                                </Border>
                                            </Grid>

                                            <!-- 3 картки з поясненням Полички -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Background="{DynamicResource OrbitRecessedBgBrush}" CornerRadius="10" Padding="14,12" Margin="0,0,5,0" BorderBrush="{DynamicResource OrbitSubtleBorderBrush}" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock x:Name="TxtGuideShelfWhatTitle" Text="🎯 Що це таке?" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource OrbitTextPrimary}" />
                                                        <TextBlock x:Name="TxtGuideShelfWhatDesc" Text="Полиця — це міні-панель Halo поверх усіх вікон. Вона виступає швидким тимчасовим буфером, куди зручно відкласти файли під час активної роботи, щоб не шукати їх знову." FontSize="11.5" Foreground="{DynamicResource OrbitTextMuted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>

                                                <Border Grid.Column="1" Background="{DynamicResource OrbitRecessedBgBrush}" CornerRadius="10" Padding="14,12" Margin="5,0,5,0" BorderBrush="{DynamicResource OrbitSubtleBorderBrush}" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock x:Name="TxtGuideShelfHowTitle" Text="📌 Як закріпити файли?" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource OrbitTextPrimary}" />
                                                        <TextBlock x:Name="TxtGuideShelfHowDesc" Text="• Меню дій: відкрийте меню Halo над файлом, затисніть Alt і виберіть «Покласти на полицю».&#x0a;• Drag-and-Drop: перетягніть файли мишкою на панель Полиці.&#x0a;• Трей: клацніть «Полиця файлів» у треї." FontSize="11.5" Foreground="{DynamicResource OrbitTextMuted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>

                                                <Border Grid.Column="2" Background="{DynamicResource OrbitRecessedBgBrush}" CornerRadius="10" Padding="14,12" Margin="5,0,0,0" BorderBrush="{DynamicResource OrbitSubtleBorderBrush}" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock x:Name="TxtGuideShelfWhyTitle" Text="⚡ Зручні сценарії" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource OrbitTextPrimary}" />
                                                        <TextBlock x:Name="TxtGuideShelfWhyDesc" Text="• Перетягуйте файли з Полиці у браузер, пошту (Outlook/Gmail) чи Telegram/Slack.&#x0a;• Швидке відкриття файлу або папки в один клік.&#x0a;• Очищайте поличку після завершення задачі." FontSize="11.5" Foreground="{DynamicResource OrbitTextMuted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- 5. Ігровий режим (Game Mode) -->
                                    <Border Style="{StaticResource OrbitCardStyle}" Margin="0,0,0,16" Padding="22,18">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="{DynamicResource OrbitRoseSoftBg}" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="🎮" FontSize="17" Foreground="{DynamicResource OrbitRoseLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtGuideS5Title" Text="5. Ігровий режим (Game Mode — режим повної тиші)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource OrbitTextPrimary}" />
                                                    <TextBlock x:Name="TxtGuideS5Sub" Text="Миттєве призупинення глобальних перехоплень для ігор і 3D-програм" FontSize="12" Foreground="{DynamicResource OrbitTextSecondary}" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Border Grid.Column="2" Background="{DynamicResource OrbitRoseSoftBg}" CornerRadius="7" Padding="10,3" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtGuideBadgePause" Text="Пауза" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OrbitRoseLightBrush}" />
                                                </Border>
                                            </Grid>

                                            <Border Background="{DynamicResource OrbitRecessedBgBrush}" CornerRadius="10" Padding="14,12" BorderBrush="{DynamicResource OrbitSubtleBorderBrush}" BorderThickness="1">
                                                <TextBlock x:Name="TxtGuideGameModeDesc" Text="Тимчасово вимикає всі тригери миші, жести струшування та перехоплення комбінацій клавіш, щоб уникнути будь-яких випадкових спрацьовувань під час відеоігор або роботи в Unreal Engine, Blender та 3ds Max. Вмикається миттєво через вікно у системному треї або гарячою комбінацією (за замовчуванням Alt+G)." FontSize="11.5" Foreground="{DynamicResource OrbitTextMuted}" TextWrapping="Wrap" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
