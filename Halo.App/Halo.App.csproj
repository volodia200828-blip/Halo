<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Halo.Core\Halo.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\avatar.jpg" />
    <Resource Include="Resources\avatar.png" />
    <None Update="Resources\avatar.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\avatar.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyTitle>Halo</AssemblyTitle>
    <Product>Halo</Product>
    <ProductName>Halo</ProductName>
    <Description>Halo</Description>
    <Company>Halo</Company>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
