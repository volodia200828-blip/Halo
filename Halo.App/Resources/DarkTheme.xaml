<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme Brushes -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0B0F19" />
    <SolidColorBrush x:Key="GlassBackgroundBrush" Color="#EE111827" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1F2937" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#374151" />
    <SolidColorBrush x:Key="BorderBrush" Color="#2A374A" />
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#30FFFFFF" />

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F9FAFB" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9CA3AF" />
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#6B7280" />

    <SolidColorBrush x:Key="AccentBrush" Color="#06B6D4" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#22D3EE" />

    <!-- Radial Menu Specific -->
    <SolidColorBrush x:Key="RadialSectorNormalBrush" Color="#CC1E293B" />
    <SolidColorBrush x:Key="RadialSectorHoverBrush" Color="#FF334155" />
    <SolidColorBrush x:Key="RadialCenterHubBrush" Color="#E60F172A" />
    <SolidColorBrush x:Key="RadialHubBorderBrush" Color="#4D38BDF8" />

</ResourceDictionary>
