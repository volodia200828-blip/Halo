<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================= -->
    <!-- 1. КОЛЬОРОВА ПАЛІТРА СТИЛЮ "ORBIT"                                -->
    <!-- ================================================================= -->
    <!-- Основні фони -->
    <Color x:Key="OrbitWindowBgColor">#1E1E24</Color>
    <Color x:Key="OrbitSidebarBgColor">#17171C</Color>
    <Color x:Key="OrbitCardBgColor">#282832</Color>
    <Color x:Key="OrbitCardHoverBgColor">#2E2E3A</Color>
    <Color x:Key="OrbitRecessedBgColor">#1B1B21</Color>

    <SolidColorBrush x:Key="OrbitWindowBgBrush" Color="{StaticResource OrbitWindowBgColor}" />
    <SolidColorBrush x:Key="OrbitSidebarBgBrush" Color="{StaticResource OrbitSidebarBgColor}" />
    <SolidColorBrush x:Key="OrbitCardBgBrush" Color="{StaticResource OrbitCardBgColor}" />
    <SolidColorBrush x:Key="OrbitCardHoverBgBrush" Color="{StaticResource OrbitCardHoverBgColor}" />
    <SolidColorBrush x:Key="OrbitRecessedBgBrush" Color="{StaticResource OrbitRecessedBgColor}" />

    <!-- Рамки та розділювачі -->
    <SolidColorBrush x:Key="OrbitSidebarDividerBrush" Color="#262630" />
    <SolidColorBrush x:Key="OrbitCardBorderBrush" Color="#343442" />
    <SolidColorBrush x:Key="OrbitCardHoverBorderBrush" Color="#564D80" />
    <SolidColorBrush x:Key="OrbitSubtleBorderBrush" Color="#2C2C38" />

    <!-- Типографіка (не чисто білий, а м'яка ієрархія) -->
    <SolidColorBrush x:Key="OrbitTextPrimary" Color="#F2F3F7" />
    <SolidColorBrush x:Key="OrbitTextSecondary" Color="#A0A3B5" />
    <SolidColorBrush x:Key="OrbitTextMuted" Color="#6C7085" />

    <!-- Акцентні кольори (Фіолетовий, Синій, Смарагдовий, Бурштиновий, Рожевий) -->
    <SolidColorBrush x:Key="OrbitPurpleBrush" Color="#8B5CF6" />
    <SolidColorBrush x:Key="OrbitPurpleLightBrush" Color="#A78BFA" />
    <SolidColorBrush x:Key="OrbitPurpleSoftBg" Color="#2D2346" />

    <SolidColorBrush x:Key="OrbitBlueBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="OrbitCyanBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="OrbitBlueSoftBg" Color="#1E2C46" />

    <SolidColorBrush x:Key="OrbitGreenBrush" Color="#10B981" />
    <SolidColorBrush x:Key="OrbitGreenLightBrush" Color="#34D399" />
    <SolidColorBrush x:Key="OrbitGreenSoftBg" Color="#19332D" />

    <SolidColorBrush x:Key="OrbitAmberBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="OrbitAmberLightBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="OrbitAmberSoftBg" Color="#382B1B" />

    <SolidColorBrush x:Key="OrbitRoseBrush" Color="#F43F5E" />
    <SolidColorBrush x:Key="OrbitRoseSoftBg" Color="#3B1E2B" />

    <!-- Преміальні градієнти "Orbit" -->
    <LinearGradientBrush x:Key="OrbitLogoGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#A855F7" Offset="0.0" />
        <GradientStop Color="#6366F1" Offset="0.5" />
        <GradientStop Color="#38BDF8" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="OrbitNavActiveBgGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#362B59" Offset="0.0" />
        <GradientStop Color="#25243D" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="OrbitNavMarkerGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#C084FC" Offset="0.0" />
        <GradientStop Color="#6366F1" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="OrbitPrimaryBtnGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8B5CF6" Offset="0.0" />
        <GradientStop Color="#5B46E5" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="OrbitPrimaryBtnHoverGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#9F75FF" Offset="0.0" />
        <GradientStop Color="#6D58F5" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="OrbitHeroBannerGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2E264A" Offset="0.0" />
        <GradientStop Color="#25273E" Offset="0.55" />
        <GradientStop Color="#262834" Offset="1.0" />
    </LinearGradientBrush>

    <!-- ================================================================= -->
    <!-- 2. М'ЯКІ ТІНІ ДЛЯ ЕФЕКТУ "ВІДРИВУ" КАРТОК ВІД ФОНУ                -->
    <!-- ================================================================= -->
    <DropShadowEffect x:Key="OrbitCardShadow"
                      BlurRadius="26"
                      ShadowDepth="7"
                      Direction="270"
                      Color="#09090D"
                      Opacity="0.45" />

    <DropShadowEffect x:Key="OrbitSoftShadow"
                      BlurRadius="16"
                      ShadowDepth="4"
                      Direction="270"
                      Color="#09090D"
                      Opacity="0.32" />

    <DropShadowEffect x:Key="OrbitPurpleGlow"
                      BlurRadius="18"
                      ShadowDepth="0"
                      Color="#8B5CF6"
                      Opacity="0.45" />

    <!-- ================================================================= -->
    <!-- 3. ВЕКТОРНІ ІКОНКИ (ЧИСТІ ЛІНІЇ)                                  -->
    <!-- ================================================================= -->
    <PathGeometry x:Key="OrbitIconDashboard" Figures="M4 5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5zm10 0a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1h-4a1 1 0 0 1-1-1V5zM4 15a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v4a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-4zm10-3a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1h-4a1 1 0 0 1-1-1v-7z" />
    <PathGeometry x:Key="OrbitIconRadial" Figures="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 14a4 4 0 1 1 4-4 4 4 0 0 1-4 4zm0-11v3m0 8v3m-7-7h3m8 0h3" />
    <PathGeometry x:Key="OrbitIconKeys" Figures="M4 6h16a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2zm3 4h2m2 0h2m2 0h2M7 14h10" />
    <PathGeometry x:Key="OrbitIconTemplates" Figures="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
    <PathGeometry x:Key="OrbitIconFolders" Figures="M3 7v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-6l-2-2H5a2 2 0 0 0-2 2z" />
    <PathGeometry x:Key="OrbitIconSettings" Figures="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm7.4-2.5a1.6 1.6 0 0 0 .3 1.8l.1.1a2 2 0 0 1-2.8 2.8l-.1-.1a1.6 1.6 0 0 0-1.8-.3 1.6 1.6 0 0 0-1 1.5V19a2 2 0 0 1-4 0v-.1a1.6 1.6 0 0 0-1-1.5 1.6 1.6 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.6 1.6 0 0 0 .3-1.8 1.6 1.6 0 0 0-1.5-1H5a2 2 0 0 1 0-4h.1a1.6 1.6 0 0 0 1.5-1 1.6 1.6 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.6 1.6 0 0 0 1.8.3h.1a1.6 1.6 0 0 0 1-1.5V5a2 2 0 0 1 4 0v.1a1.6 1.6 0 0 0 1 1.5 1.6 1.6 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.6 1.6 0 0 0-.3 1.8v.1a1.6 1.6 0 0 0 1.5 1H19a2 2 0 0 1 0 4h-.1a1.6 1.6 0 0 0-1.5 1z" />
    <PathGeometry x:Key="OrbitIconPin" Figures="M16 3l5 5-2 2-2-1-4 4v5l-2 2-2-5-4 4-2-2 4-4H4l2-2 5-2-1-2 2-2z" />
    <PathGeometry x:Key="OrbitIconMinimize" Figures="M5 12h14" />
    <PathGeometry x:Key="OrbitIconMaximize" Figures="M5 5h14v14H5z" />
    <PathGeometry x:Key="OrbitIconClose" Figures="M6 18L18 6M6 6l12 12" />

    <!-- ================================================================= -->
    <!-- 4. СТИЛІ КАРТОК ТА НАВІГАЦІЇ "ORBIT"                              -->
    <!-- ================================================================= -->
    <!-- Стандартна об'ємна картка Orbit -->
    <Style x:Key="OrbitCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource OrbitCardBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OrbitCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="22" />
        <Setter Property="Effect" Value="{StaticResource OrbitCardShadow}" />
    </Style>

    <!-- Інтерактивна картка з підсвічуванням при наведенні -->
    <Style x:Key="OrbitInteractiveCardStyle" TargetType="Border" BasedOn="{StaticResource OrbitCardStyle}">
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource OrbitCardHoverBgBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource OrbitCardHoverBorderBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Пункт лівого меню (Сайдбар Orbit з кольоровим маркером зліва) -->
    <Style x:Key="OrbitSidebarItemStyle" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource OrbitTextSecondary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Margin" Value="0,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="ItemContainer"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14,13">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Кольоровий маркер зліва (border-left як в Orbit) -->
                            <Border x:Name="LeftAccentMarker"
                                    Grid.Column="0"
                                    Width="4"
                                    Height="22"
                                    CornerRadius="2"
                                    Background="{StaticResource OrbitNavMarkerGradient}"
                                    Margin="-6,0,12,0"
                                    Opacity="0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" Color="#A855F7" Opacity="0.8" ShadowDepth="0" />
                                </Border.Effect>
                            </Border>

                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemContainer" Property="Background" Value="#21212B" />
                            <Setter Property="Foreground" Value="{StaticResource OrbitTextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ItemContainer" Property="Background" Value="{StaticResource OrbitNavActiveBgGradient}" />
                            <Setter TargetName="ItemContainer" Property="BorderBrush" Value="#4A3B78" />
                            <Setter TargetName="LeftAccentMarker" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Головна акцентна кнопка Orbit (Фіолетово-синій градієнт + тінь) -->
    <Style x:Key="OrbitPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource OrbitPrimaryBtnGradient}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="BtnBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="11"
                            Effect="{StaticResource OrbitPurpleGlow}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource OrbitPrimaryBtnHoverGradient}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BtnBorder" Property="Opacity" Value="0.88" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Другорядна карткова кнопка Orbit -->
    <Style x:Key="OrbitSecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="#2E2E3A" />
        <Setter Property="Foreground" Value="{StaticResource OrbitTextPrimary}" />
        <Setter Property="BorderBrush" Value="#3E3E4F" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="BtnBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="11">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="#383847" />
                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#635985" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="#252530" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Кнопки керування вікном (Згорнути, Розгорнути, Закрити) -->
    <Style x:Key="OrbitWindowCapBtn" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#2A2A36" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OrbitWindowCloseBtn" TargetType="Button" BasedOn="{StaticResource OrbitWindowCapBtn}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E11D48" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Сучасний перемикач (Toggle Switch) у стилі Orbit -->
    <Style x:Key="OrbitToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="46" Height="25">
                            <Border x:Name="SwitchTrack"
                                    CornerRadius="12.5"
                                    Background="#1B1B22"
                                    BorderBrush="#383848"
                                    BorderThickness="1.5" />
                            <Ellipse x:Name="SwitchThumb"
                                     Width="17" Height="17"
                                     Fill="#7D8196"
                                     HorizontalAlignment="Left"
                                     Margin="4,0,0,0" />
                        </Grid>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource OrbitPrimaryBtnGradient}" />
                            <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#A78BFA" />
                            <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,4,0" />
                            <Setter TargetName="SwitchThumb" Property="Fill" Value="#FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Кастомне темне текстове поле Orbit -->
    <Style x:Key="OrbitTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource OrbitRecessedBgBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OrbitTextPrimary}" />
        <Setter Property="CaretBrush" Value="#A78BFA" />
        <Setter Property="BorderBrush" Value="#343444" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="11">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#8B5CF6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Кастомний темний ComboBox у стилі Orbit -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource OrbitTextPrimary}" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Margin="4,2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#323242" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource OrbitNavActiveBgGradient}" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource OrbitRecessedBgBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OrbitTextPrimary}" />
        <Setter Property="BorderBrush" Value="#343444" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd"
                                            Background="{StaticResource OrbitRecessedBgBrush}"
                                            BorderBrush="#343444"
                                            BorderThickness="1.5"
                                            CornerRadius="11">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="36" />
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="1"
                                                  Data="M0,0 L4.5,4.5 L9,0"
                                                  Stroke="#A0A3B5"
                                                  StrokeThickness="1.8"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#564D80" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#8B5CF6" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter x:Name="ContentSite"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="14,9,36,9"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left" />

                        <Popup x:Name="Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade">
                            <Grid x:Name="DropDown"
                                  SnapsToDevicePixels="True"
                                  MinWidth="{TemplateBinding ActualWidth}"
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                  Margin="0,4,0,0">
                                <Border x:Name="DropDownBorder"
                                        Background="#23232D"
                                        BorderBrush="#3E3E52"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="4"
                                        Effect="{StaticResource OrbitCardShadow}">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Тонкий темний скролбар -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#383848" CornerRadius="3" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
