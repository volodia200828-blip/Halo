<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================= -->
    <!-- 1. КОЛЬОРОВА ПАЛІТРА СТИЛЮ "ORBIT" (ДИНАМІЧНІ РЕСУРСИ ДЛЯ ТЕМ)     -->
    <!-- ================================================================= -->
    <Color x:Key="OrbitWindowBgColor">#1E1E24</Color>
    <Color x:Key="OrbitSidebarBgColor">#17171C</Color>
    <Color x:Key="OrbitCardBgColor">#282832</Color>
    <Color x:Key="OrbitCardHoverBgColor">#2F2F3D</Color>
    <Color x:Key="OrbitRecessedBgColor">#1B1B21</Color>

    <SolidColorBrush x:Key="OrbitWindowBgBrush" Color="#1E1E24" />
    <SolidColorBrush x:Key="OrbitSidebarBgBrush" Color="#17171C" />
    <SolidColorBrush x:Key="OrbitCardBgBrush" Color="#282832" />
    <SolidColorBrush x:Key="OrbitCardHoverBgBrush" Color="#2F2F3D" />
    <SolidColorBrush x:Key="OrbitRecessedBgBrush" Color="#1B1B21" />

    <!-- Рамки та розділювачі -->
    <SolidColorBrush x:Key="OrbitSidebarDividerBrush" Color="#262630" />
    <SolidColorBrush x:Key="OrbitCardBorderBrush" Color="#353545" />
    <SolidColorBrush x:Key="OrbitCardHoverBorderBrush" Color="#6D5AE6" />
    <SolidColorBrush x:Key="OrbitSubtleBorderBrush" Color="#2C2C38" />

    <!-- Типографіка -->
    <SolidColorBrush x:Key="OrbitTextPrimary" Color="#F2F3F7" />
    <SolidColorBrush x:Key="OrbitTextSecondary" Color="#A0A3B5" />
    <SolidColorBrush x:Key="OrbitTextMuted" Color="#6C7085" />
    <SolidColorBrush x:Key="OrbitNavActiveTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OrbitNavActiveBorderBrush" Color="#54428E" />

    <!-- Акцентні кольори (Оптимізована яскравість та світлота базових кольорів іконок проти темного фону) -->
    <SolidColorBrush x:Key="OrbitPurpleBrush" Color="#8B5CF6" />
    <SolidColorBrush x:Key="OrbitPurpleLightBrush" Color="#A78BFA" />
    <SolidColorBrush x:Key="OrbitPurpleSoftBg" Color="#3D2E68" />

    <SolidColorBrush x:Key="OrbitBlueBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="OrbitCyanBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="OrbitBlueSoftBg" Color="#224272" />

    <SolidColorBrush x:Key="OrbitGreenBrush" Color="#10B981" />
    <SolidColorBrush x:Key="OrbitGreenLightBrush" Color="#34D399" />
    <SolidColorBrush x:Key="OrbitGreenSoftBg" Color="#205041" />

    <SolidColorBrush x:Key="OrbitAmberBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="OrbitAmberLightBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="OrbitAmberSoftBg" Color="#543D1F" />

    <SolidColorBrush x:Key="OrbitRoseBrush" Color="#F43F5E" />
    <SolidColorBrush x:Key="OrbitRoseLightBrush" Color="#FB7185" />
    <SolidColorBrush x:Key="OrbitRoseSoftBg" Color="#5A273F" />

    <!-- Документи: Індиго / Синьо-фіолетовий (чітко відрізняється від зелених таблиць) -->
    <SolidColorBrush x:Key="OrbitIndigoBrush" Color="#6366F1" />
    <SolidColorBrush x:Key="OrbitIndigoLightBrush" Color="#818CF8" />
    <SolidColorBrush x:Key="OrbitIndigoSoftBg" Color="#26285A" />

    <!-- Архіви: Насичений помаранчевий / Теракотовий (чітко відрізняється від бурштинових презентацій) -->
    <SolidColorBrush x:Key="OrbitOrangeBrush" Color="#F97316" />
    <SolidColorBrush x:Key="OrbitOrangeLightBrush" Color="#FB923C" />
    <SolidColorBrush x:Key="OrbitOrangeSoftBg" Color="#542B14" />

    <!-- Палітра перемикачів для неактивних / вимкнених станів (передбачуваний, приглушений, зчитуваний вигляд) -->
    <SolidColorBrush x:Key="OrbitToggleTrackOffBrush" Color="#2A2B38" />
    <SolidColorBrush x:Key="OrbitToggleBorderOffBrush" Color="#4A4D64" />
    <SolidColorBrush x:Key="OrbitToggleThumbOffBrush" Color="#989CB4" />

    <!-- Компонент логів / Журнал операцій (Семантичні ресурси тем для темної та світлої тем) -->
    <SolidColorBrush x:Key="OrbitLogCardBgBrush" Color="#282832" />
    <SolidColorBrush x:Key="OrbitLogItemBgBrush" Color="#1E1E26" />
    <SolidColorBrush x:Key="OrbitLogItemBorderBrush" Color="#353545" />
    <SolidColorBrush x:Key="OrbitLogTextPrimaryBrush" Color="#F2F3F7" />
    <SolidColorBrush x:Key="OrbitLogTextSecondaryBrush" Color="#A0A3B5" />
    <SolidColorBrush x:Key="OrbitLogTextMutedBrush" Color="#767A92" />
    <SolidColorBrush x:Key="OrbitLogTimestampBrush" Color="#38BDF8" />

    <!-- Банер та декоративні елементи (адаптивні до теми) -->
    <SolidColorBrush x:Key="OrbitHeroBorderBrush" Color="#4A3C75" />
    <SolidColorBrush x:Key="OrbitHeroBadgeBgBrush" Color="#3D3163" />
    <SolidColorBrush x:Key="OrbitHeroBadgeTextBrush" Color="#C4B5FD" />
    <SolidColorBrush x:Key="OrbitHeroTitleBrush" Color="#F2F3F7" />
    <SolidColorBrush x:Key="OrbitHeroDescBrush" Color="#B8BBE0" />
    <SolidColorBrush x:Key="OrbitHeroRingBgBrush" Color="#1D1A2E" />
    <SolidColorBrush x:Key="OrbitLogoBoxBgBrush" Color="#222030" />
    <SolidColorBrush x:Key="OrbitLogoBoxBorderBrush" Color="#463A6E" />

    <!-- Преміальні градієнти "Orbit" -->
    <LinearGradientBrush x:Key="OrbitLogoGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#A855F7" Offset="0.0" />
        <GradientStop Color="#6366F1" Offset="0.5" />
        <GradientStop Color="#38BDF8" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="OrbitNavActiveBgGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#362B59" Offset="0.0" />
        <GradientStop Color="#25243D" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="OrbitNavMarkerGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#C084FC" Offset="0.0" />
        <GradientStop Color="#6366F1" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="OrbitPrimaryBtnGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8B5CF6" Offset="0.0" />
        <GradientStop Color="#5B46E5" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="OrbitPrimaryBtnHoverGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#9F75FF" Offset="0.0" />
        <GradientStop Color="#6D58F5" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="OrbitHeroBannerGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2E264A" Offset="0.0" />
        <GradientStop Color="#25273E" Offset="0.55" />
        <GradientStop Color="#262834" Offset="1.0" />
    </LinearGradientBrush>

    <!-- ================================================================= -->
    <!-- 2. ТІНІ ДЛЯ ФОНОВИХ ШАРІВ (БЕЗ РОЗМИТТЯ ТЕКСТУ)                   -->
    <!-- ================================================================= -->
    <DropShadowEffect x:Key="OrbitCardShadow"
                      BlurRadius="22"
                      ShadowDepth="5"
                      Direction="270"
                      Color="#09090D"
                      Opacity="0.4" />

    <DropShadowEffect x:Key="OrbitSoftShadow"
                      BlurRadius="14"
                      ShadowDepth="3"
                      Direction="270"
                      Color="#09090D"
                      Opacity="0.3" />

    <DropShadowEffect x:Key="OrbitPurpleGlow"
                      BlurRadius="16"
                      ShadowDepth="0"
                      Color="#8B5CF6"
                      Opacity="0.4" />

    <!-- ================================================================= -->
    <!-- 3. ЧІТКІ ВЕКТОРНІ ІКОНКИ (БЕЗ ЗЛАМАНИХ ДУГ)                       -->
    <!-- ================================================================= -->
    <PathGeometry x:Key="OrbitIconDashboard" Figures="M4,4 L10,4 L10,10 L4,10 Z M14,4 L20,4 L20,10 L14,10 Z M4,14 L10,14 L10,20 L4,20 Z M14,14 L20,14 L20,20 L14,20 Z" />
    <PathGeometry x:Key="OrbitIconRadial" Figures="M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 Z M12,8 A4,4 0 1 0 12,16 A4,4 0 1 0 12,8 Z M12,2 L12,6 M12,18 L12,22 M2,12 L6,12 M18,12 L22,12" />
    <PathGeometry x:Key="OrbitIconKeys" Figures="M3,6 L21,6 L21,18 L3,18 Z M6,10 L8,10 M11,10 L13,10 M16,10 L18,10 M7,14 L17,14" />
    <PathGeometry x:Key="OrbitIconFolders" Figures="M3,6 L9,6 L11,8 L21,8 L21,19 L3,19 Z" />
    <PathGeometry x:Key="OrbitIconShelf" Figures="M4,5 L20,5 L20,8 L4,8 Z M5,8 L19,8 L18,20 L6,20 Z M10,12 L14,12" />
    <PathGeometry x:Key="OrbitIconGamepad" Figures="M4,9 C4,7.3 5.3,6 7,6 L17,6 C18.7,6 20,7.3 20,9 L20,13 C20,16 17.5,18 15.5,18 C14.5,18 13.8,17.2 13.2,16.2 L12.5,15 L11.5,15 L10.8,16.2 C10.2,17.2 9.5,18 8.5,18 C6.5,18 4,16 4,13 Z M8,9 L8,13 M6,11 L10,11 M15,10 A1,1 0 1 0 15,10.01 M17,12 A1,1 0 1 0 17,12.01" />
    <!-- Виправлена чітка іконка налаштувань (шестерня + внутрішнє кільце) -->
    <PathGeometry x:Key="OrbitIconSettings" Figures="M12,8.5 A3.5,3.5 0 1 0 12,15.5 A3.5,3.5 0 1 0 12,8.5 Z M10.5,2.5 L13.5,2.5 L14.2,5.1 L16.5,6.1 L18.9,4.7 L21.0,6.8 L19.6,9.2 L20.6,11.5 L23.2,12.2 L20.6,14.8 L19.6,14.8 L18.9,19.3 L16.5,17.9 L14.2,18.9 L13.5,21.5 L10.5,21.5 L9.8,18.9 L7.5,17.9 L5.1,19.3 L3.0,17.2 L4.4,14.8 L3.4,12.5 L0.8,11.8 L3.4,9.2 L4.4,9.2 L5.1,4.7 L7.5,6.1 L9.8,5.1 Z" />
    <PathGeometry x:Key="OrbitIconMinimize" Figures="M5,12 L19,12" />
    <PathGeometry x:Key="OrbitIconMaximize" Figures="M5,5 L19,5 L19,19 L5,19 Z" />
    <PathGeometry x:Key="OrbitIconClose" Figures="M6,18 L18,6 M6,6 L18,18" />

    <!-- ================================================================= -->
    <!-- 4. СТИЛІ КАРТОК ТА НАВІГАЦІЇ "ORBIT" (ЧІТКІ, БЕЗ МИЛА)            -->
    <!-- ================================================================= -->
    <!-- Стандартна картка Orbit (без Effect на батьківському Border, щоб ClearType-текст був ідеально чітким!) -->
    <Style x:Key="OrbitCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource OrbitCardBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OrbitCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="22" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!-- Інтерактивна картка з плавною анімацією підйому та масштабування при наведенні й кліку -->
    <Style x:Key="OrbitInteractiveCardStyle" TargetType="Border" BasedOn="{StaticResource OrbitCardStyle}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TransformGroup>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                    <TranslateTransform X="0" Y="0" />
                </TransformGroup>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource OrbitCardHoverBgBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource OrbitCardHoverBorderBrush}" />
            </Trigger>
            <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                         To="1.022" Duration="0:0:0.16">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                         To="1.022" Duration="0:0:0.16">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                         To="-3.5" Duration="0:0:0.16">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                         To="1.0" Duration="0:0:0.18">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                         To="1.0" Duration="0:0:0.18">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                         To="0" Duration="0:0:0.18">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                         To="0.97" Duration="0:0:0.08" />
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                         To="0.97" Duration="0:0:0.08" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                         To="1.022" Duration="0:0:0.12" />
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                         To="1.022" Duration="0:0:0.12" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- Пункт лівого меню (Сайдбар Orbit) -->
    <Style x:Key="OrbitSidebarItemStyle" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource OrbitTextSecondary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <!-- Плавний шар підсвічування при наведенні (Hover) -->
                        <Border x:Name="HoverOverlay"
                                Background="{DynamicResource OrbitCardHoverBgBrush}"
                                CornerRadius="12"
                                Opacity="0"
                                IsHitTestVisible="False" />

                        <Border x:Name="ItemContainer"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Прозорий заповнювач для точного горизонтального вирівнювання з лівим маркером -->
                                <Border Grid.Column="0"
                                        Width="4"
                                        Height="20"
                                        Margin="-6,0,12,0"
                                        Background="Transparent"
                                        IsHitTestVisible="False" />

                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Плавна поява підсвітки при наведенні (тільки коли не вибрано) -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                            <Setter Property="Foreground" Value="{DynamicResource OrbitTextPrimary}" />
                        </MultiTrigger>

                        <!-- Коли кнопка вибрана -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource OrbitNavActiveTextBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Горизонтальний перемикач режимів (Pill RadioButton) -->
    <Style x:Key="OrbitNavRadioStyle" TargetType="RadioButton" BasedOn="{StaticResource OrbitSidebarItemStyle}">
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <!-- Симетричний горизонтальний перемикач модифікаторів (Shift / Ctrl / Alt) без бокового зміщення -->
    <Style x:Key="OrbitModePillRadioStyle" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource OrbitTextSecondary}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="PillBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource OrbitCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource OrbitCardHoverBgBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource OrbitTextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource OrbitNavActiveBgGradient}" />
                            <Setter TargetName="PillBorder" Property="BorderBrush" Value="{DynamicResource OrbitNavActiveBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource OrbitNavActiveTextBrush}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Виразний сегментований перемикач для підвкладок Налаштувань та Гіда -->
    <Style x:Key="OrbitSettingsTabRadioStyle" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource OrbitTextSecondary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="TabBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1.5"
                            CornerRadius="11"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource OrbitCardHoverBgBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource OrbitTextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource OrbitCardBgBrush}" />
                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource OrbitPurpleLightBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource OrbitTextPrimary}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Головна акцентна кнопка Orbit (Тінь на фоновому шарі, текст ідеально чіткий!) -->
    <Style x:Key="OrbitPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource OrbitPrimaryBtnGradient}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- Фоновий шар зі світінням (не розмиває текст кнопки!) -->
                        <Border x:Name="GlowLayer"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Effect="{StaticResource OrbitPurpleGlow}" />
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#A78BFA"
                                BorderThickness="1"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource OrbitPrimaryBtnHoverGradient}" />
                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#C4B5FD" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BtnBorder" Property="Opacity" Value="0.86" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Другорядна карткова кнопка Orbit -->
    <Style x:Key="OrbitSecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource OrbitCardHoverBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OrbitTextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OrbitCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="15,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="BtnBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#7C69EF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BtnBorder" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Кнопки керування вікном -->
    <Style x:Key="OrbitWindowCapBtn" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource OrbitCardHoverBgBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OrbitWindowCloseBtn" TargetType="Button" BasedOn="{StaticResource OrbitWindowCapBtn}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E11D48" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Компактний акуратний перемикач (Toggle Switch) у стилі Orbit (34x18) -->
    <Style x:Key="OrbitToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="34" Height="18">
                            <Border x:Name="SwitchTrack"
                                    CornerRadius="9"
                                    Background="{DynamicResource OrbitToggleTrackOffBrush}"
                                    BorderBrush="{DynamicResource OrbitToggleBorderOffBrush}"
                                    BorderThickness="1.2" />
                            <Ellipse x:Name="SwitchThumb"
                                     Width="12" Height="12"
                                     Fill="{DynamicResource OrbitToggleThumbOffBrush}"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="3,0,0,0" />
                        </Grid>
                        <ContentPresenter x:Name="SwitchContent"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="SwitchContent" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="SwitchContent" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource OrbitCardHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource OrbitPrimaryBtnGradient}" />
                            <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#A78BFA" />
                            <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,3,0" />
                            <Setter TargetName="SwitchThumb" Property="Fill" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="SwitchTrack" Property="Opacity" Value="0.45" />
                            <Setter TargetName="SwitchThumb" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Текстове поле Orbit -->
    <Style x:Key="OrbitTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource OrbitRecessedBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OrbitTextPrimary}" />
        <Setter Property="CaretBrush" Value="#A78BFA" />
        <Setter Property="BorderBrush" Value="{DynamicResource OrbitCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#8B5CF6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox у стилі Orbit -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource OrbitTextPrimary}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Margin="4,2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource OrbitCardHoverBgBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource OrbitNavActiveBgGradient}" />
                            <Setter Property="Foreground" Value="{DynamicResource OrbitNavActiveTextBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource OrbitRecessedBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OrbitTextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OrbitCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd"
                                            Background="{DynamicResource OrbitRecessedBgBrush}"
                                            BorderBrush="{DynamicResource OrbitCardBorderBrush}"
                                            BorderThickness="1.5"
                                            CornerRadius="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="34" />
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="1"
                                                  Data="M0,0 L4.5,4.5 L9,0"
                                                  Stroke="{DynamicResource OrbitTextSecondary}"
                                                  StrokeThickness="1.8"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#6D5AE6" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#8B5CF6" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter x:Name="ContentSite"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="13,8,34,8"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left" />

                        <Popup x:Name="Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade">
                            <Grid x:Name="DropDown"
                                  SnapsToDevicePixels="True"
                                  MinWidth="{TemplateBinding ActualWidth}"
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                  Margin="0,4,0,0">
                                <Border x:Name="DropDownBorder"
                                        Background="{DynamicResource OrbitCardBgBrush}"
                                        BorderBrush="{DynamicResource OrbitCardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="4">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Тонкий скролбар -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#3E3E52" CornerRadius="3" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль Контекстного меню Orbit (для трею та контекстних дій) -->
    <Style x:Key="OrbitSeparatorStyle" TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource OrbitCardBorderBrush}" />
        <Setter Property="Margin" Value="6,4" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Height="1" Fill="{DynamicResource OrbitCardBorderBrush}" Margin="6,4" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OrbitMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource OrbitTextPrimary}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Margin="3,2"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CheckGlyph"
                                       Grid.Column="0"
                                       Text="✓"
                                       Foreground="{DynamicResource OrbitAccentBrush}"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       Visibility="Collapsed" />
                            <ContentPresenter x:Name="IconHost" Grid.Column="0" Content="{TemplateBinding Icon}" VerticalAlignment="Center" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" Margin="4,0,0,0" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                            <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource OrbitCardHoverBgBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource OrbitTextMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OrbitContextMenuStyle" TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource OrbitCardBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OrbitCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1.2" />
        <Setter Property="Padding" Value="5,6" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource OrbitMenuItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14"
                            Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.6" />
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
