<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================== -->
    <!-- GLASSMORPHISM & NEON COLOR PALETTE             -->
    <!-- ============================================== -->
    <Color x:Key="WindowBgColor">#080B12</Color>
    <Color x:Key="SidebarBgColor">#0B0F19</Color>
    <Color x:Key="GlassCardColor">#101624</Color>
    <Color x:Key="GlassCardHoverColor">#161F33</Color>

    <Color x:Key="NeonCyan">#00F0FF</Color>
    <Color x:Key="NeonCyanDark">#0284C7</Color>
    <Color x:Key="NeonPurple">#A855F7</Color>
    <Color x:Key="NeonGreen">#10B981</Color>

    <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource WindowBgColor}" />
    <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBgColor}" />
    <SolidColorBrush x:Key="GlassCardBrush" Color="{StaticResource GlassCardColor}" />
    <SolidColorBrush x:Key="GlassCardHoverBrush" Color="{StaticResource GlassCardHoverColor}" />

    <!-- Thin Glass Borders -->
    <SolidColorBrush x:Key="GlassBorderSubtle" Color="#182438" />
    <SolidColorBrush x:Key="GlassBorderLight" Color="#22334F" />
    <SolidColorBrush x:Key="NeonCyanBrush" Color="{StaticResource NeonCyan}" />
    <SolidColorBrush x:Key="NeonPurpleBrush" Color="{StaticResource NeonPurple}" />
    <SolidColorBrush x:Key="NeonGreenBrush" Color="{StaticResource NeonGreen}" />

    <!-- Typography Brushes -->
    <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC" />
    <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8" />
    <SolidColorBrush x:Key="TextMuted" Color="#546682" />

    <!-- Gradients -->
    <LinearGradientBrush x:Key="CyanGlowGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00E5FF" Offset="0" />
        <GradientStop Color="#0284C7" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PurpleGlowGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#C084FC" Offset="0" />
        <GradientStop Color="#7C3AED" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardGlassGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#162032" Offset="0" />
        <GradientStop Color="#0D1424" Offset="1" />
    </LinearGradientBrush>

    <!-- ============================================== -->
    <!-- VECTOR ICONS (SVG PATH GEOMETRIES)             -->
    <!-- ============================================== -->
    <!-- Home / Dashboard -->
    <PathGeometry x:Key="IconHomeGeo" Figures="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
    <!-- Keyboard -->
    <PathGeometry x:Key="IconKeyboardGeo" Figures="M4 6h16a2 2 0 012 2v8a2 2 0 01-2 2H4a2 2 0 01-2-2V8a2 2 0 012-2zm2 3h.01M10 9h.01M14 9h.01M18 9h.01M6 12h.01M10 12h.01M14 12h.01M18 12h.01M7 15h10" />
    <!-- Radial Disc -->
    <PathGeometry x:Key="IconRadialGeo" Figures="M12 2a10 10 0 100 20 10 10 0 000-20zm0 4a6 6 0 100 12 6 6 0 000-12zm0 4a2 2 0 100 4 2 2 0 000-4z" />
    <!-- Presets / Wand -->
    <PathGeometry x:Key="IconPresetsGeo" Figures="M19 11l-8-8-8 8m8-8v16" />
    <!-- Folder Watcher -->
    <PathGeometry x:Key="IconFoldersGeo" Figures="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
    <!-- Settings Gear -->
    <PathGeometry x:Key="IconSettingsGeo" Figures="M10.3 3.1a2 2 0 013.4 0 2 2 0 002.7.9 2 2 0 012.4 2.4 2 2 0 00.9 2.7 2 2 0 010 3.4 2 2 0 00-.9 2.7 2 2 0 01-2.4 2.4 2 2 0 00-2.7.9 2 2 0 01-3.4 0 2 2 0 00-2.7-.9 2 2 0 01-2.4-2.4 2 2 0 00-.9-2.7 2 2 0 010-3.4 2 2 0 00.9-2.7 2 2 0 012.4-2.4 2 2 0 002.7-.9z M12 15a3 3 0 100-6 3 3 0 000 6z" />
    <!-- Pin / Shelf -->
    <PathGeometry x:Key="IconPinGeo" Figures="M16 3l5 5-2 2-2-1-4 4v5l-2 2-2-5-4 4-2-2 4-4H4l2-2 5-2-1-2 2-2z" />
    <!-- Plus -->
    <PathGeometry x:Key="IconPlusGeo" Figures="M12 4v16m8-8H4" />
    <!-- Close -->
    <PathGeometry x:Key="IconCloseGeo" Figures="M6 18L18 6M6 6l12 12" />
    <!-- Minimize -->
    <PathGeometry x:Key="IconMinimizeGeo" Figures="M5 12h14" />

    <!-- ============================================== -->
    <!-- STYLES & TEMPLATES                             -->
    <!-- ============================================== -->
    <!-- Window Control Buttons (Min, Close) -->
    <Style x:Key="WindowCaptionBtn" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#25354F" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="WindowCloseBtn" TargetType="Button" BasedOn="{StaticResource WindowCaptionBtn}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#DC2626" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Glass Button -->
    <Style x:Key="GlassButton" TargetType="Button">
        <Setter Property="Background" Value="#141C2C" />
        <Setter Property="Foreground" Value="#F8FAFC" />
        <Setter Property="BorderBrush" Value="#22334F" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#1E2A42" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="#00F0FF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#101827" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Glowing Accent Button -->
    <Style x:Key="GlowingAccentButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource CyanGlowGradient}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Color="#00F0FF" Opacity="0.5" ShadowDepth="0" />
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Opacity" Value="0.9" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar Navigation RadioButton -->
    <Style x:Key="SidebarTabItem" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#94A3B8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="TabBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Vertical Active Glowing Pill -->
                            <Border x:Name="ActiveIndicator"
                                    Grid.Column="0"
                                    Width="3"
                                    Height="16"
                                    CornerRadius="1.5"
                                    Background="#00F0FF"
                                    HorizontalAlignment="Left"
                                    Margin="-8,0,8,0"
                                    Opacity="0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" Color="#00F0FF" Opacity="0.9" ShadowDepth="0" />
                                </Border.Effect>
                            </Border>

                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="#121A2B" />
                            <Setter Property="Foreground" Value="#F8FAFC" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="#152238" />
                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="#1E3A5F" />
                            <Setter TargetName="TabBorder" Property="BorderThickness" Value="1" />
                            <Setter Property="Foreground" Value="#00F0FF" />
                            <Setter TargetName="ActiveIndicator" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toggle Switch -->
    <Style x:Key="GlowingToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="40" Height="22">
                            <Border x:Name="Track"
                                    CornerRadius="11"
                                    Background="#141C2C"
                                    BorderBrush="#25354F"
                                    BorderThickness="1.2" />
                            <Ellipse x:Name="Thumb"
                                     Width="14" Height="14"
                                     Fill="#64748B"
                                     HorizontalAlignment="Left"
                                     Margin="4,0,0,0" />
                        </Grid>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="#0284C7" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="#00F0FF" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,4,0" />
                            <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
